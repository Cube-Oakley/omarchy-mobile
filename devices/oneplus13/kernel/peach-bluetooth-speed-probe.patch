+/* Ganges has a peripheral UART controller as well as the Bluetooth HCI.
+ * Sequence documented by the pinned ROCKNIX WCN7860 patch. Keep transmit
+ * waits bounded and explicitly kick TX after each queued raw command.
+ */
+static int peach_set_peripheral_baudrate(struct hci_uart *hu)
+{
+	struct qca_data *qca = hu->priv;
+	struct sk_buff *skb;
+	unsigned long deadline;
+	u8 cmd[] = { 0x31, 0x00, 0xf1, 0xff, 0x02, 0x02,
+		     QCA_BAUDRATE_3000000 };
+	int ret;
+
+	if (!hu->serdev)
+		return -ENODEV;
+	ret = send_hci_ibs_cmd(HCI_IBS_WAKE_IND, hu);
+	if (ret)
+		return ret;
+	hci_uart_tx_wakeup(hu);
+	msleep(10);
+	skb = bt_skb_alloc(sizeof(cmd), GFP_KERNEL);
+	if (!skb)
+		return -ENOMEM;
+	skb_put_data(skb, cmd, sizeof(cmd));
+	skb_queue_tail(&qca->txq, skb);
+	hci_uart_tx_wakeup(hu);
+	deadline = jiffies + msecs_to_jiffies(200);
+	while (!skb_queue_empty(&qca->txq)) {
+		if (time_after(jiffies, deadline))
+			return -ETIMEDOUT;
+		usleep_range(100, 200);
+	}
+	serdev_device_wait_until_sent(hu->serdev, CMD_TRANS_TIMEOUT);
+	msleep(100);
+	hu->oper_speed = 3000000;
+	return 0;
 }
 
