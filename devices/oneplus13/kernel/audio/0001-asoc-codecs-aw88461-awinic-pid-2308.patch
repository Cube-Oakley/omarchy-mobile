+static void aw88461_startup_work(struct work_struct *work)
+{
+	struct aw88461 *aw88461 =
+		container_of(work, struct aw88461, start_work.work);
+
+	guard(mutex)(&aw88461->lock);
+	aw88461_start(aw88461);
+}
+
+/*
+ * The I2S bit clock and word select may only run once the CPU DAI has been
+ * triggered (Qualcomm AudioReach starts the interface with the graph), after
+ * DAPM powers this widget up. Start the amplifier from a work item, whose
+ * PLL lock checks and retries cover that gap, as the other Awinic drivers do.
+ */
+static int aw88461_playback_event(struct snd_soc_dapm_widget *w,
+				  struct snd_kcontrol *k, int event)
+{
+	struct snd_soc_component *component = snd_soc_dapm_to_component(w->dapm);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(component);
+
+	switch (event) {
+	case SND_SOC_DAPM_PRE_PMU:
+		queue_delayed_work(system_dfl_wq, &aw88461->start_work,
+				   msecs_to_jiffies(AW88461_START_WORK_DELAY_MS));
+		break;
+	case SND_SOC_DAPM_POST_PMD: {
+		cancel_delayed_work_sync(&aw88461->start_work);
+		guard(mutex)(&aw88461->lock);
+		aw88461_dev_stop(aw88461->aw_pa);
+		break;
+	}
+	default:
+		break;
+	}
+
+	return 0;
+}
