diff -ruN a/sound/soc/codecs/aw88461.c b/sound/soc/codecs/aw88461.c
--- a/sound/soc/codecs/aw88461.c	1969-12-31 16:00:00.000000000 -0800
+++ b/sound/soc/codecs/aw88461.c	2026-10-12 14:26:51.677768658 -0700
@@ -0,0 +1,1223 @@
+// SPDX-License-Identifier: GPL-2.0-only
+//
+// aw88461.c  --  AW88461 (product ID 0x2308) ALSA SoC Audio driver
+//
+// Based on aw88261.c:
+// Copyright (c) 2023 awinic Technology CO., LTD
+// Author: Jimmy Zhang <zhangjianming@awinic.com>
+// Author: Weidong Wang <wangweidong.a@awinic.com>
+//
+// The register layout and the power sequence follow the pid 2308 support
+// in awinic's aw882xx driver. The AW88461 has no DSP; the acf file holds
+// one register list per profile and per amplifier.
+//
+
+#include <linux/bitfield.h>
+#include <linux/cleanup.h>
+#include <linux/firmware.h>
+#include <linux/gpio/consumer.h>
+#include <linux/devm-helpers.h>
+#include <linux/i2c.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/unaligned.h>
+#include <sound/pcm_params.h>
+#include <sound/soc.h>
+#include <sound/tlv.h>
+#include "aw88395/aw88395_data_type.h"
+#include "aw88395/aw88395_device.h"
+#include "aw88461.h"
+
+static const struct regmap_config aw88461_regmap_config = {
+	.val_bits = 16,
+	.reg_bits = 8,
+	.max_register = AW88461_MAX_REG,
+	.reg_format_endian = REGMAP_ENDIAN_LITTLE,
+	.val_format_endian = REGMAP_ENDIAN_BIG,
+};
+
+/*
+ * @value is an attenuation relative to the level programmed by the active
+ * acf profile, so the amplifier is never driven louder than the profile.
+ */
+static void aw88461_dev_set_volume(struct aw_device *aw_dev, unsigned int value)
+{
+	struct aw_volume_desc *vol_desc = &aw_dev->volume_desc;
+	unsigned int volume;
+
+	volume = min(value + vol_desc->init_volume, (unsigned int)AW88461_MUTE_VOL);
+
+	regmap_update_bits(aw_dev->regmap, AW88461_SYSCTRL2_REG,
+			   AW88461_VOL_MASK, FIELD_PREP(AW88461_VOL_MASK, volume));
+}
+
+static void aw88461_dev_i2s_tx_enable(struct aw_device *aw_dev, bool flag)
+{
+	regmap_assign_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+			   AW88461_I2STXEN, flag);
+}
+
+static void aw88461_dev_pwd(struct aw_device *aw_dev, bool pwd)
+{
+	regmap_assign_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+			   AW88461_PWDN, pwd);
+}
+
+static void aw88461_dev_amppd(struct aw_device *aw_dev, bool amppd)
+{
+	regmap_assign_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+			   AW88461_AMPPD, amppd);
+}
+
+static void aw88461_dev_uls_hmute(struct aw_device *aw_dev, bool uls_hmute)
+{
+	regmap_assign_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+			   AW88461_ULS_HMUTE, uls_hmute);
+}
+
+static void aw88461_dev_mute(struct aw_device *aw_dev, bool is_mute)
+{
+	if (is_mute) {
+		aw88461_dev_set_volume(aw_dev, AW88461_MUTE_VOL);
+		regmap_set_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+				AW88461_HMUTE);
+	} else {
+		regmap_clear_bits(aw_dev->regmap, AW88461_SYSCTRL_REG,
+				  AW88461_HMUTE);
+		aw88461_dev_set_volume(aw_dev, aw_dev->volume_desc.ctl_volume);
+	}
+}
+
+static void aw88461_dev_clear_int_status(struct aw_device *aw_dev)
+{
+	unsigned int int_status;
+
+	/* read int status and clear */
+	regmap_read(aw_dev->regmap, AW88461_SYSINT_REG, &int_status);
+	/* make sure int status is clear */
+	regmap_read(aw_dev->regmap, AW88461_SYSINT_REG, &int_status);
+
+	dev_dbg(aw_dev->dev, "read interrupt reg = 0x%04x", int_status);
+}
+
+static int aw88461_dev_check_pll(struct aw_device *aw_dev)
+{
+	unsigned int reg_val;
+	int ret, i;
+
+	for (i = 0; i < AW88461_DEV_SYSST_CHECK_MAX; i++) {
+		ret = regmap_read(aw_dev->regmap, AW88461_SYSST_REG, &reg_val);
+		if (ret)
+			return ret;
+
+		if ((reg_val & AW88461_IIS_CHECK) == AW88461_IIS_CHECK)
+			return 0;
+
+		dev_dbg(aw_dev->dev, "pll check failed, sysst 0x%04x", reg_val);
+		usleep_range(AW88461_2000_US, AW88461_2000_US + 10);
+	}
+
+	dev_warn(aw_dev->dev, "PLL not locked, sysst 0x%04x\n", reg_val);
+	return -EPERM;
+}
+
+static int aw88461_dev_check_sysst(struct aw_device *aw_dev)
+{
+	unsigned int check, reg_val;
+	int ret, i;
+
+	/* the output stage does not switch while the noise gate holds it */
+	ret = regmap_read(aw_dev->regmap, AW88461_NGCTRL3_REG, &reg_val);
+	if (ret)
+		return ret;
+
+	if (reg_val & AW88461_NOISE_GATE_EN)
+		check = AW88461_SYSST_CHECK;
+	else
+		check = AW88461_SYSST_SWS_CHECK;
+
+	for (i = 0; i < AW88461_DEV_SYSST_CHECK_MAX; i++) {
+		ret = regmap_read(aw_dev->regmap, AW88461_SYSST_REG, &reg_val);
+		if (ret)
+			return ret;
+
+		if ((reg_val & check) == check) {
+			if (reg_val & AW88461_SYSST_FAULTS)
+				dev_warn(aw_dev->dev, "fault status at start: 0x%04x\n",
+					 reg_val);
+			return 0;
+		}
+
+		dev_dbg(aw_dev->dev, "sysst check failed, sysst 0x%04x, check 0x%04x",
+			reg_val, check);
+		usleep_range(AW88461_2000_US, AW88461_2000_US + 10);
+	}
+
+	dev_warn(aw_dev->dev, "start check failed, sysst 0x%04x, check 0x%04x\n",
+		 reg_val, check);
+	return -EPERM;
+}
+
+/*
+ * Only the parts of the I2S setup that the machine driver configured are
+ * programmed; everything else keeps the values from the acf profile.
+ */
+static int aw88461_dev_configure_syspll(struct aw88461 *aw88461)
+{
+	struct regmap *regmap = aw88461->regmap;
+	unsigned int bck;
+	int ret;
+
+	if (aw88461->tdm_valid) {
+		ret = regmap_update_bits(regmap, AW88461_I2SCTRL2_REG,
+				AW88461_SLOT_NUM_MASK | AW88461_TX_SLOTVLD_MASK |
+				AW88461_RXR_SLOTVLD_MASK | AW88461_RXL_SLOTVLD_MASK,
+				FIELD_PREP(AW88461_SLOT_NUM_MASK, aw88461->slot_num_value) |
+				FIELD_PREP(AW88461_TX_SLOTVLD_MASK, aw88461->tx_slot) |
+				FIELD_PREP(AW88461_RXR_SLOTVLD_MASK, aw88461->rxr_slot) |
+				FIELD_PREP(AW88461_RXL_SLOTVLD_MASK, aw88461->rxl_slot));
+		if (ret)
+			return ret;
+	}
+
+	if (aw88461->params_valid) {
+		/* the PLL divider must be used for 8/16/32 kHz */
+		ret = regmap_assign_bits(regmap, AW88461_DBGCTRL_REG,
+					 AW88461_CCO_MUX, !aw88461->cco_mux_divided);
+		if (ret)
+			return ret;
+
+		bck = aw88461->tdm_valid ? aw88461->tdm_bck_value : aw88461->bck_value;
+		ret = regmap_update_bits(regmap, AW88461_I2SCTRL1_REG,
+				AW88461_I2SSR_MASK | AW88461_I2SBCK_MASK |
+				AW88461_I2SFS_MASK,
+				FIELD_PREP(AW88461_I2SSR_MASK, aw88461->sr_value) |
+				FIELD_PREP(AW88461_I2SBCK_MASK, bck) |
+				FIELD_PREP(AW88461_I2SFS_MASK, aw88461->fs_value));
+		if (ret)
+			return ret;
+	}
+
+	if (aw88461->fmt_valid) {
+		ret = regmap_update_bits(regmap, AW88461_I2SCTRL1_REG, AW88461_I2SMD_MASK,
+					 FIELD_PREP(AW88461_I2SMD_MASK, aw88461->md_value));
+		if (ret)
+			return ret;
+
+		ret = regmap_assign_bits(regmap, AW88461_SYSCTRL_REG,
+					 AW88461_BCKINV, aw88461->bck_inv);
+		if (ret)
+			return ret;
+	}
+
+	return aw88461_dev_check_pll(aw88461->aw_pa);
+}
+
+static int aw88461_dev_reg_update(struct aw88461 *aw88461,
+				  const u8 *data, unsigned int len)
+{
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	struct aw_volume_desc *vol_desc = &aw_dev->volume_desc;
+	unsigned int read_val, i;
+	bool vol_found = false;
+	u16 reg_addr, reg_val;
+	int ret;
+
+	if (!len || !data || (len % 4)) {
+		dev_err(aw_dev->dev, "invalid reg data, len %u\n", len);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < len; i += 4) {
+		reg_addr = get_unaligned_le16(data + i);
+		reg_val = get_unaligned_le16(data + i + 2);
+
+		if (reg_addr > AW88461_MAX_REG) {
+			/* the register lists end with a 0xff marker */
+			if (reg_addr != AW88461_REG_NONE)
+				dev_warn(aw_dev->dev, "skipping register 0x%x\n",
+					 reg_addr);
+			continue;
+		}
+
+		if (reg_addr == AW88461_SYSCTRL_REG) {
+			aw88461->amppd_st = reg_val & AW88461_AMPPD;
+			aw88461->mute_st = reg_val & AW88461_HMUTE;
+			aw88461->txen_st = reg_val & AW88461_I2STXEN;
+
+			ret = regmap_read(aw_dev->regmap, reg_addr, &read_val);
+			if (ret)
+				return ret;
+
+			/* keep the current power down, amp power down and mute state */
+			reg_val &= ~(AW88461_PWDN | AW88461_AMPPD | AW88461_HMUTE);
+			reg_val |= read_val & (AW88461_PWDN | AW88461_AMPPD | AW88461_HMUTE);
+
+			/* keep the output muted and the I/V feedback off until start */
+			reg_val |= AW88461_ULS_HMUTE;
+			reg_val &= ~AW88461_I2STXEN;
+		}
+
+		if (reg_addr == AW88461_SYSCTRL2_REG) {
+			/* the profile volume is the loudest level the driver will use */
+			vol_desc->init_volume = FIELD_GET(AW88461_VOL_MASK, reg_val);
+			vol_found = true;
+
+			/* hold the minimum volume until the stream starts */
+			reg_val &= ~AW88461_VOL_MASK;
+			reg_val |= FIELD_PREP(AW88461_VOL_MASK, AW88461_MUTE_VOL);
+		}
+
+		ret = regmap_write(aw_dev->regmap, reg_addr, reg_val);
+		if (ret)
+			return ret;
+	}
+
+	if (!vol_found) {
+		ret = regmap_read(aw_dev->regmap, AW88461_SYSCTRL2_REG, &read_val);
+		if (ret)
+			return ret;
+
+		vol_desc->init_volume = FIELD_GET(AW88461_VOL_MASK, read_val);
+		aw88461_dev_set_volume(aw_dev, AW88461_MUTE_VOL);
+	}
+
+	dev_dbg(aw_dev->dev, "profile volume %u, amppd %d, mute %d, txen %d\n",
+		vol_desc->init_volume, aw88461->amppd_st, aw88461->mute_st,
+		aw88461->txen_st);
+
+	return 0;
+}
+
+static int aw88461_dev_get_prof_name(struct aw_device *aw_dev, int index, char **prof_name)
+{
+	struct aw_prof_info *prof_info = &aw_dev->prof_info;
+	struct aw_prof_desc *prof_desc;
+
+	if (index >= aw_dev->prof_info.count || index < 0) {
+		dev_err(aw_dev->dev, "index[%d] overflow count[%d]",
+			index, aw_dev->prof_info.count);
+		return -EINVAL;
+	}
+
+	prof_desc = &aw_dev->prof_info.prof_desc[index];
+
+	*prof_name = prof_info->prof_name_list[prof_desc->id];
+
+	return 0;
+}
+
+static int aw88461_dev_get_prof_data(struct aw_device *aw_dev, int index,
+				     struct aw_prof_desc **prof_desc)
+{
+	if (index >= aw_dev->prof_info.count || index < 0) {
+		dev_err(aw_dev->dev, "%s: index[%d] overflow count[%d]\n",
+			__func__, index, aw_dev->prof_info.count);
+		return -EINVAL;
+	}
+
+	*prof_desc = &aw_dev->prof_info.prof_desc[index];
+
+	return 0;
+}
+
+static int aw88461_dev_fw_update(struct aw88461 *aw88461)
+{
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	struct aw_prof_desc *prof_index_desc;
+	struct aw_sec_data_desc *sec_desc;
+	char *prof_name;
+	int ret;
+
+	ret = aw88461_dev_get_prof_name(aw_dev, aw_dev->prof_index, &prof_name);
+	if (ret) {
+		dev_err(aw_dev->dev, "get prof name failed");
+		return -EINVAL;
+	}
+
+	dev_dbg(aw_dev->dev, "start update %s", prof_name);
+
+	ret = aw88461_dev_get_prof_data(aw_dev, aw_dev->prof_index, &prof_index_desc);
+	if (ret)
+		return ret;
+
+	sec_desc = prof_index_desc->sec_desc;
+	ret = aw88461_dev_reg_update(aw88461, sec_desc[AW88395_DATA_TYPE_REG].data,
+				     sec_desc[AW88395_DATA_TYPE_REG].len);
+	if (ret) {
+		dev_err(aw_dev->dev, "update reg failed");
+		return ret;
+	}
+
+	aw_dev->prof_cur = aw_dev->prof_index;
+
+	return 0;
+}
+
+static int aw88461_soft_reset(struct aw88461 *aw88461)
+{
+	int ret;
+
+	ret = regmap_write(aw88461->regmap, AW88461_ID_REG, AW88461_SOFT_RESET_VALUE);
+	if (ret)
+		return ret;
+
+	usleep_range(AW88461_1000_US, AW88461_1000_US + 100);
+
+	return 0;
+}
+
+static int aw88461_dev_start(struct aw88461 *aw88461)
+{
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	int ret;
+
+	if (aw_dev->status == AW88461_DEV_PW_ON) {
+		dev_dbg(aw_dev->dev, "already power on");
+		return 0;
+	}
+
+	/* power on */
+	aw88461_dev_pwd(aw_dev, false);
+	usleep_range(AW88461_2000_US, AW88461_2000_US + 10);
+
+	ret = aw88461_dev_configure_syspll(aw88461);
+	if (ret) {
+		dev_dbg(aw_dev->dev, "pll check failed");
+		goto pll_check_fail;
+	}
+
+	/* amppd on */
+	aw88461_dev_amppd(aw_dev, false);
+	usleep_range(AW88461_1000_US, AW88461_1000_US + 50);
+
+	/* check boost, clock and pll status */
+	ret = aw88461_dev_check_sysst(aw_dev);
+	if (ret) {
+		dev_dbg(aw_dev->dev, "sysst check failed");
+		goto sysst_check_fail;
+	}
+
+	/* enable the I/V feedback if the profile asks for it */
+	if (aw88461->txen_st)
+		aw88461_dev_i2s_tx_enable(aw_dev, true);
+
+	if (aw88461->amppd_st)
+		aw88461_dev_amppd(aw_dev, true);
+
+	/* close uls mute */
+	aw88461_dev_uls_hmute(aw_dev, false);
+
+	/* close mute */
+	if (!aw88461->mute_st)
+		aw88461_dev_mute(aw_dev, false);
+
+	/* clear inturrupt */
+	aw88461_dev_clear_int_status(aw_dev);
+	aw_dev->status = AW88461_DEV_PW_ON;
+
+	return 0;
+
+sysst_check_fail:
+	aw88461_dev_clear_int_status(aw_dev);
+	aw88461_dev_amppd(aw_dev, true);
+pll_check_fail:
+	aw88461_dev_pwd(aw_dev, true);
+	aw_dev->status = AW88461_DEV_PW_OFF;
+
+	return ret;
+}
+
+static void aw88461_dev_power_down(struct aw_device *aw_dev)
+{
+	/* clear inturrupt */
+	aw88461_dev_clear_int_status(aw_dev);
+
+	aw88461_dev_uls_hmute(aw_dev, true);
+	/* set mute */
+	aw88461_dev_mute(aw_dev, true);
+	usleep_range(AW88461_5000_US, AW88461_5000_US + 100);
+
+	/* close tx feedback */
+	aw88461_dev_i2s_tx_enable(aw_dev, false);
+	usleep_range(AW88461_1000_US, AW88461_1000_US + 100);
+
+	/* enable amppd */
+	aw88461_dev_amppd(aw_dev, true);
+
+	/* set power down */
+	aw88461_dev_pwd(aw_dev, true);
+}
+
+static int aw88461_dev_stop(struct aw_device *aw_dev)
+{
+	if (aw_dev->status == AW88461_DEV_PW_OFF) {
+		dev_dbg(aw_dev->dev, "already power off");
+		return 0;
+	}
+
+	aw_dev->status = AW88461_DEV_PW_OFF;
+	aw88461_dev_power_down(aw_dev);
+
+	return 0;
+}
+
+static int aw88461_reg_update(struct aw88461 *aw88461, bool force)
+{
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	int ret;
+
+	if (force) {
+		ret = aw88461_soft_reset(aw88461);
+		if (ret)
+			return ret;
+
+		ret = aw88461_dev_fw_update(aw88461);
+		if (ret)
+			return ret;
+	} else if (aw_dev->prof_cur != aw_dev->prof_index) {
+		ret = aw88461_dev_fw_update(aw88461);
+		if (ret)
+			return ret;
+	}
+
+	aw_dev->prof_cur = aw_dev->prof_index;
+
+	return 0;
+}
+
+static void aw88461_start_pa(struct aw88461 *aw88461)
+{
+	int ret, i;
+
+	for (i = 0; i < AW88461_START_RETRIES; i++) {
+		ret = aw88461_reg_update(aw88461, aw88461->phase_sync);
+		if (ret) {
+			dev_dbg(aw88461->aw_pa->dev,
+				"aw88461_reg_update failed, cnt:%d, ret:%d\n", i, ret);
+			continue;
+		}
+		ret = aw88461_dev_start(aw88461);
+		if (ret) {
+			dev_dbg(aw88461->aw_pa->dev,
+				"aw88461_dev_start failed, cnt:%d, ret:%d\n", i, ret);
+			continue;
+		}
+
+		dev_dbg(aw88461->aw_pa->dev, "start success\n");
+		break;
+	}
+
+	if (ret)
+		dev_err(aw88461->aw_pa->dev, "start failure (%d)\n", ret);
+}
+
+static void aw88461_start(struct aw88461 *aw88461)
+{
+	if (aw88461->aw_pa->fw_status != AW88461_DEV_FW_OK)
+		return;
+
+	if (aw88461->aw_pa->status == AW88461_DEV_PW_ON)
+		return;
+
+	aw88461_start_pa(aw88461);
+}
+
+static int aw88461_set_fmt(struct snd_soc_dai *dai, unsigned int fmt)
+{
+	struct snd_soc_component *component = dai->component;
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(component);
+	unsigned int provider = fmt & SND_SOC_DAIFMT_CLOCK_PROVIDER_MASK;
+
+	if (provider && provider != SND_SOC_DAIFMT_CBC_CFC) {
+		dev_err(component->dev, "the amplifier can only be clock consumer\n");
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_INV_MASK) {
+	case SND_SOC_DAIFMT_NB_NF:
+		aw88461->bck_inv = false;
+		break;
+	case SND_SOC_DAIFMT_IB_NF:
+		aw88461->bck_inv = true;
+		break;
+	default:
+		dev_err(component->dev, "unsupported invert mode 0x%x\n",
+			fmt & SND_SOC_DAIFMT_INV_MASK);
+		return -EINVAL;
+	}
+
+	switch (fmt & SND_SOC_DAIFMT_FORMAT_MASK) {
+	case SND_SOC_DAIFMT_I2S:
+	case SND_SOC_DAIFMT_DSP_A:
+		aw88461->md_value = AW88461_I2SMD_PHILIPS;
+		break;
+	case SND_SOC_DAIFMT_MSB:
+	case SND_SOC_DAIFMT_DSP_B:
+		aw88461->md_value = AW88461_I2SMD_MSB;
+		break;
+	case SND_SOC_DAIFMT_LSB:
+		aw88461->md_value = AW88461_I2SMD_LSB;
+		break;
+	default:
+		dev_err(component->dev, "unsupported DAI format 0x%x\n",
+			fmt & SND_SOC_DAIFMT_FORMAT_MASK);
+		return -EINVAL;
+	}
+
+	aw88461->fmt_valid = true;
+
+	return 0;
+}
+
+static int aw88461_hw_params(struct snd_pcm_substream *substream,
+			     struct snd_pcm_hw_params *params,
+			     struct snd_soc_dai *dai)
+{
+	struct snd_soc_component *component = dai->component;
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(component);
+	bool divided = false;
+	unsigned int sr, fs, bck;
+
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		return 0;
+
+	switch (params_rate(params)) {
+	case 8000:
+		sr = AW88461_I2SSR_8KHZ;
+		divided = true;
+		break;
+	case 11025:
+		sr = AW88461_I2SSR_11P025KHZ;
+		break;
+	case 12000:
+		sr = AW88461_I2SSR_12KHZ;
+		break;
+	case 16000:
+		sr = AW88461_I2SSR_16KHZ;
+		divided = true;
+		break;
+	case 22050:
+		sr = AW88461_I2SSR_22P05KHZ;
+		break;
+	case 24000:
+		sr = AW88461_I2SSR_24KHZ;
+		break;
+	case 32000:
+		sr = AW88461_I2SSR_32KHZ;
+		divided = true;
+		break;
+	case 44100:
+		sr = AW88461_I2SSR_44P1KHZ;
+		break;
+	case 48000:
+		sr = AW88461_I2SSR_48KHZ;
+		break;
+	case 96000:
+		sr = AW88461_I2SSR_96KHZ;
+		break;
+	default:
+		dev_err(component->dev, "unsupported sample rate %d\n",
+			params_rate(params));
+		return -EINVAL;
+	}
+
+	switch (params_width(params)) {
+	case 16:
+		fs = AW88461_I2SFS_16_BITS;
+		break;
+	case 20:
+		fs = AW88461_I2SFS_20_BITS;
+		break;
+	case 24:
+		fs = AW88461_I2SFS_24_BITS;
+		break;
+	case 32:
+		fs = AW88461_I2SFS_32_BITS;
+		break;
+	default:
+		dev_err(component->dev, "unsupported bit width %d\n",
+			params_width(params));
+		return -EINVAL;
+	}
+
+	switch (params_physical_width(params)) {
+	case 16:
+		bck = AW88461_I2SBCK_32FS;
+		break;
+	case 24:
+		bck = AW88461_I2SBCK_48FS;
+		break;
+	case 32:
+		bck = AW88461_I2SBCK_64FS;
+		break;
+	default:
+		dev_err(component->dev, "unsupported physical bit width %d\n",
+			params_physical_width(params));
+		return -EINVAL;
+	}
+
+	aw88461->sr_value = sr;
+	aw88461->fs_value = fs;
+	aw88461->bck_value = bck;
+	aw88461->cco_mux_divided = divided;
+	aw88461->params_valid = true;
+
+	return 0;
+}
+
+static int aw88461_set_tdm_slot(struct snd_soc_dai *dai, unsigned int tx_mask,
+				unsigned int rx_mask, int slots, int slot_width)
+{
+	struct snd_soc_component *component = dai->component;
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(component);
+	unsigned int slot_num, bck, rxl = 0, rxr = 0, tx = 0;
+
+	switch (slots) {
+	case 0:
+		/* plain I2S: go back to the slot setup of the acf profile */
+		if (aw88461->tdm_valid) {
+			aw88461->tdm_valid = false;
+			/* reload the profile at the next start */
+			aw88461->aw_pa->prof_cur = U8_MAX;
+		}
+		return 0;
+	case 1:
+		slot_num = AW88461_SLOT_NUM_TDM1S;
+		break;
+	case 2:
+		slot_num = AW88461_SLOT_NUM_TDM2S;
+		break;
+	case 4:
+		slot_num = AW88461_SLOT_NUM_TDM4S;
+		break;
+	case 6:
+		slot_num = AW88461_SLOT_NUM_TDM6S;
+		break;
+	case 8:
+		slot_num = AW88461_SLOT_NUM_TDM8S;
+		break;
+	case 16:
+		slot_num = AW88461_SLOT_NUM_TDM16S;
+		break;
+	default:
+		dev_err(component->dev, "unsupported slot count %d\n", slots);
+		return -EINVAL;
+	}
+
+	switch (slot_width) {
+	case 16:
+		bck = AW88461_I2SBCK_32FS;
+		break;
+	case 20:
+	case 24:
+		bck = AW88461_I2SBCK_48FS;
+		break;
+	case 32:
+		bck = AW88461_I2SBCK_64FS;
+		break;
+	default:
+		dev_err(component->dev, "unsupported slot width %d\n", slot_width);
+		return -EINVAL;
+	}
+
+	if (tx_mask) {
+		tx = __ffs(tx_mask);
+		if (tx > AW88461_SLOT_MAX)
+			return -EINVAL;
+	}
+
+	if (rx_mask) {
+		rxl = __ffs(rx_mask);
+		if (rxl > AW88461_SLOT_MAX)
+			return -EINVAL;
+		rxr = rxl;
+
+		/* a second rx slot feeds the right channel */
+		if (rx_mask & ~BIT(rxl)) {
+			rxr = __ffs(rx_mask & ~BIT(rxl));
+			if (rxr > AW88461_SLOT_MAX)
+				return -EINVAL;
+		}
+	}
+
+	aw88461->slot_num_value = slot_num;
+	aw88461->tdm_bck_value = bck;
+	aw88461->tx_slot = tx;
+	aw88461->rxl_slot = rxl;
+	aw88461->rxr_slot = rxr;
+	aw88461->tdm_valid = true;
+
+	return 0;
+}
