+static const struct snd_soc_component_driver soc_codec_dev_aw88461 = {
+	.probe = aw88461_codec_probe,
+};
+
+static void aw88461_hw_reset(struct aw88461 *aw88461)
+{
+	if (!aw88461->reset_gpio)
+		return;
+
+	/* the reset line was requested asserted */
+	usleep_range(AW88461_1000_US, AW88461_1000_US + 10);
+	gpiod_set_value_cansleep(aw88461->reset_gpio, 0);
+	usleep_range(AW88461_2000_US, AW88461_2000_US + 10);
+}
+
+static int aw88461_init(struct aw88461 *aw88461, struct i2c_client *i2c,
+			struct regmap *regmap)
+{
+	struct device *dev = &i2c->dev;
+	struct aw_device *aw_dev;
+	unsigned int chip_id;
+	u32 channel = AW88461_DEV_DEFAULT_CH;
+	int ret;
+
+	ret = regmap_read(regmap, AW88461_ID_REG, &chip_id);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to read chip id\n");
+
+	if (chip_id != AW88461_CHIP_ID)
+		return dev_err_probe(dev, -ENODEV, "unsupported device id 0x%04x\n",
+				     chip_id);
+
+	dev_dbg(dev, "chip id = 0x%04x\n", chip_id);
+
+	aw_dev = devm_kzalloc(dev, sizeof(*aw_dev), GFP_KERNEL);
+	if (!aw_dev)
+		return -ENOMEM;
+
+	aw88461->aw_pa = aw_dev;
+	aw_dev->i2c = i2c;
+	aw_dev->regmap = regmap;
+	aw_dev->dev = dev;
+	aw_dev->chip_id = AW88461_CHIP_ID;
+	aw_dev->acf = NULL;
+	aw_dev->prof_info.prof_desc = NULL;
+	aw_dev->prof_info.count = 0;
+	aw_dev->prof_info.prof_type = AW88395_DEV_NONE_TYPE_ID;
+	aw_dev->fw_status = AW88461_DEV_FW_FAILED;
+	aw_dev->status = AW88461_DEV_PW_OFF;
+	aw_dev->volume_desc.ctl_volume = AW88461_CTL_DEFAULT_ATT;
+	aw_dev->volume_desc.mute_volume = AW88461_MUTE_VOL;
+
+	/* selects the register lists for this amplifier in the acf file */
+	device_property_read_u32(dev, "awinic,audio-channel", &channel);
+	aw_dev->channel = channel;
+	aw88461->phase_sync = device_property_read_bool(dev, "awinic,sync-flag");
+
+	return 0;
+}
+
+static int aw88461_i2c_probe(struct i2c_client *i2c)
+{
+	struct device *dev = &i2c->dev;
+	struct aw88461 *aw88461;
+	int ret;
+
+	if (!i2c_check_functionality(i2c->adapter, I2C_FUNC_I2C))
+		return dev_err_probe(dev, -ENXIO, "check_functionality failed\n");
+
+	aw88461 = devm_kzalloc(dev, sizeof(*aw88461), GFP_KERNEL);
+	if (!aw88461)
+		return -ENOMEM;
+
+	ret = devm_mutex_init(dev, &aw88461->lock);
+	if (ret)
+		return ret;
+
+	ret = devm_delayed_work_autocancel(dev, &aw88461->start_work,
+					   aw88461_startup_work);
+	if (ret)
+		return ret;
+
+	i2c_set_clientdata(i2c, aw88461);
+
+	aw88461->regmap = devm_regmap_init_i2c(i2c, &aw88461_regmap_config);
+	if (IS_ERR(aw88461->regmap))
+		return dev_err_probe(dev, PTR_ERR(aw88461->regmap),
+				     "failed to init regmap\n");
+
+	ret = devm_regulator_get_enable_optional(dev, "dvdd");
+	if (ret && ret != -ENODEV)
+		return dev_err_probe(dev, ret, "failed to enable dvdd supply\n");
+
+	aw88461->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(aw88461->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(aw88461->reset_gpio),
+				     "failed to get reset gpio\n");
+
+	aw88461_hw_reset(aw88461);
+
+	ret = aw88461_init(aw88461, i2c, aw88461->regmap);
+	if (ret)
+		return ret;
+
+	ret = devm_snd_soc_register_component(dev, &soc_codec_dev_aw88461,
+					      aw88461_dai, ARRAY_SIZE(aw88461_dai));
+	if (ret)
+		dev_err(dev, "failed to register aw88461: %d", ret);
+
+	return ret;
+}
+
+static const struct i2c_device_id aw88461_i2c_id[] = {
+	{ .name = "aw88461" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, aw88461_i2c_id);
+
+static const struct of_device_id aw88461_of_table[] = {
+	{ .compatible = "awinic,aw88461" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, aw88461_of_table);
+
+static struct i2c_driver aw88461_i2c_driver = {
+	.driver = {
+		.name = "aw88461",
+		.of_match_table = aw88461_of_table,
+	},
+	.probe = aw88461_i2c_probe,
+	.id_table = aw88461_i2c_id,
+};
+module_i2c_driver(aw88461_i2c_driver);
+
+MODULE_DESCRIPTION("ASoC AW88461 Smart PA Driver");
+MODULE_LICENSE("GPL");
diff -ruN a/sound/soc/codecs/aw88461.h b/sound/soc/codecs/aw88461.h
--- a/sound/soc/codecs/aw88461.h	1969-12-31 16:00:00.000000000 -0800
+++ b/sound/soc/codecs/aw88461.h	2026-10-12 14:26:51.679866559 -0700
@@ -0,0 +1,202 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * aw88461.h  --  AW88461 (product ID 0x2308) ALSA SoC Audio driver
+ *
+ * Register layout taken from the awinic aw882xx vendor driver
+ * (aw882xx_pid_2308_reg.h).
+ */
+
+#ifndef __AW88461_H__
+#define __AW88461_H__
+
+#include <linux/bits.h>
+
+/* registers */
+#define AW88461_ID_REG			(0x00)
+#define AW88461_SYSST_REG		(0x01)
+#define AW88461_SYSINT_REG		(0x02)
+#define AW88461_SYSINTM_REG		(0x03)
+#define AW88461_SYSCTRL_REG		(0x04)
+#define AW88461_SYSCTRL2_REG		(0x05)
+#define AW88461_I2SCTRL1_REG		(0x06)
+#define AW88461_I2SCTRL2_REG		(0x07)
+#define AW88461_I2SCTRL3_REG		(0x08)
+#define AW88461_DBGCTRL_REG		(0x1F)
+#define AW88461_NGCTRL3_REG		(0x5E)
+#define AW88461_EFRH2_REG		(0x7A)
+#define AW88461_MAX_REG			(0x7F)
+
+/* register list terminator used by the acf files, not a register */
+#define AW88461_REG_NONE		(0xFF)
+
+/* SYSST (0x01) */
+#define AW88461_UVLS			BIT(14)
+#define AW88461_BSTOCS			BIT(11)
+#define AW88461_BSTS			BIT(9)
+#define AW88461_SWS			BIT(8)
+#define AW88461_NOCLKS			BIT(5)
+#define AW88461_CLKS			BIT(4)
+#define AW88461_OCDS			BIT(3)
+#define AW88461_OTHS			BIT(1)
+#define AW88461_PLLS			BIT(0)
+
+#define AW88461_IIS_CHECK		(AW88461_CLKS | AW88461_PLLS)
+/* boost started, clock stable, PLL locked */
+#define AW88461_SYSST_CHECK		(AW88461_BSTS | AW88461_IIS_CHECK)
+/* ... and the output stage switching (only while the noise gate is off) */
+#define AW88461_SYSST_SWS_CHECK		(AW88461_SYSST_CHECK | AW88461_SWS)
+#define AW88461_SYSST_FAULTS		(AW88461_UVLS | AW88461_BSTOCS | \
+					 AW88461_OCDS | AW88461_OTHS)
+
+/* SYSCTRL (0x04) */
+#define AW88461_ULS_HMUTE		BIT(15)
+#define AW88461_I2SRXEN			BIT(14)
+#define AW88461_I2STXEN			BIT(13)
+#define AW88461_BOP_EN			BIT(12)
+#define AW88461_HMUTE			BIT(8)
+#define AW88461_RCV_MODE		BIT(7)
+#define AW88461_I2SEN			BIT(6)
+#define AW88461_WSINV			BIT(5)
+#define AW88461_BCKINV			BIT(4)
+#define AW88461_AMPPD			BIT(1)
+#define AW88461_PWDN			BIT(0)
+
+/* SYSCTRL2 (0x05) */
+#define AW88461_EN_MPD			BIT(15)
+#define AW88461_PSM_EN			BIT(14)
+#define AW88461_VOL_ADD_MASK		GENMASK(11, 10)
+#define AW88461_VOL_MASK		GENMASK(9, 0)
+
+/* I2SCTRL1 (0x06) */
+#define AW88461_CHSEL_MASK		GENMASK(11, 10)
+#define AW88461_I2SMD_MASK		GENMASK(9, 8)
+#define AW88461_I2SMD_PHILIPS		(0)
+#define AW88461_I2SMD_MSB		(1)
+#define AW88461_I2SMD_LSB		(2)
+#define AW88461_I2SFS_MASK		GENMASK(7, 6)
+#define AW88461_I2SFS_16_BITS		(0)
+#define AW88461_I2SFS_20_BITS		(1)
+#define AW88461_I2SFS_24_BITS		(2)
+#define AW88461_I2SFS_32_BITS		(3)
+#define AW88461_I2SBCK_MASK		GENMASK(5, 4)
+#define AW88461_I2SBCK_32FS		(0)
+#define AW88461_I2SBCK_48FS		(1)
+#define AW88461_I2SBCK_64FS		(2)
+#define AW88461_I2SSR_MASK		GENMASK(3, 0)
+#define AW88461_I2SSR_8KHZ		(0)
+#define AW88461_I2SSR_11P025KHZ		(1)
+#define AW88461_I2SSR_12KHZ		(2)
+#define AW88461_I2SSR_16KHZ		(3)
+#define AW88461_I2SSR_22P05KHZ		(4)
+#define AW88461_I2SSR_24KHZ		(5)
+#define AW88461_I2SSR_32KHZ		(6)
+#define AW88461_I2SSR_44P1KHZ		(7)
+#define AW88461_I2SSR_48KHZ		(8)
+#define AW88461_I2SSR_96KHZ		(9)
+
+/* I2SCTRL2 (0x07) */
+#define AW88461_SLOT_NUM_MASK		GENMASK(14, 12)
+#define AW88461_SLOT_NUM_I2S		(0)
+#define AW88461_SLOT_NUM_TDM1S		(1)
+#define AW88461_SLOT_NUM_TDM2S		(2)
+#define AW88461_SLOT_NUM_TDM4S		(3)
+#define AW88461_SLOT_NUM_TDM6S		(4)
+#define AW88461_SLOT_NUM_TDM8S		(5)
+#define AW88461_SLOT_NUM_TDM16S		(6)
+#define AW88461_TX_SLOTVLD_MASK		GENMASK(11, 8)
+#define AW88461_RXR_SLOTVLD_MASK	GENMASK(7, 4)
+#define AW88461_RXL_SLOTVLD_MASK	GENMASK(3, 0)
+#define AW88461_SLOT_MAX		(15)
+
+/* DBGCTRL (0x1F) */
+#define AW88461_CCO_MUX			BIT(13)	/* 0: PLL divider, 1: bypass */
+
+/* NGCTRL3 (0x5E) */
+#define AW88461_NOISE_GATE_EN		BIT(0)
+
+/* EFRH2 (0x7A): signed voltage sense offset, in units of 2 */
+#define AW88461_VSN_OFFSET_MASK		GENMASK(7, 0)
+
+/*
+ * VOL is an attenuation in steps of 1/64 of 6.02 dB (~0.094 dB), so
+ * 1023 is about -96.2 dB. VOL_ADD (+6/+12 dB) is never touched by the
+ * driver; it keeps whatever the acf profile programs.
+ */
+#define AW88461_MUTE_VOL		(1023)
+#define AW88461_VOL_DB_X100_MIN		(-9624)
+#define AW88461_CTL_MAX_VOL		AW88461_MUTE_VOL
+/* control attenuation at probe: 128 steps = -12 dB below the profile level */
+#define AW88461_CTL_DEFAULT_ATT		(128)
+
+#define AW88461_CHIP_ID			(0x2308)
+#define AW88461_SOFT_RESET_VALUE	(0x55aa)
+#define AW88461_ACF_FILE		"aw88461_acf.bin"
+#define AW88461_INIT_PROFILE		(0)
+#define AW88461_DEV_DEFAULT_CH		(0)
+#define AW88461_DEV_SYSST_CHECK_MAX	(10)
+#define AW88461_START_RETRIES		(5)
+#define AW88461_START_WORK_DELAY_MS	(10)
+
+#define AW88461_RATES (SNDRV_PCM_RATE_8000_48000 | \
+			SNDRV_PCM_RATE_12000 | \
+			SNDRV_PCM_RATE_24000 | \
+			SNDRV_PCM_RATE_96000)
+#define AW88461_FORMATS (SNDRV_PCM_FMTBIT_S16_LE | \
+			SNDRV_PCM_FMTBIT_S24_LE | \
+			SNDRV_PCM_FMTBIT_S32_LE)
+
+enum {
+	AW88461_1000_US = 1000,
+	AW88461_2000_US = 2000,
+	AW88461_5000_US = 5000,
+};
+
+enum {
+	AW88461_DEV_PW_OFF = 0,
+	AW88461_DEV_PW_ON,
+};
+
+enum {
+	AW88461_DEV_FW_FAILED = 0,
+	AW88461_DEV_FW_OK,
+};
+
+struct aw88461 {
+	struct aw_device *aw_pa;
+	/* serialises start/stop, profile and volume changes */
+	struct mutex lock;
+	/* the amp is started once the stream's clocks run (after trigger) */
+	struct delayed_work start_work;
+	struct gpio_desc *reset_gpio;
+	struct regmap *regmap;
+	struct aw_container *aw_cfg;
+
+	/* SYSCTRL state requested by the active acf profile */
+	bool amppd_st;
+	bool mute_st;
+	bool txen_st;
+
+	/* DAI format, only programmed once set_fmt() has run */
+	bool fmt_valid;
+	unsigned int md_value;
+	bool bck_inv;
+
+	/* stream parameters, only programmed once hw_params() has run */
+	bool params_valid;
+	unsigned int sr_value;
+	unsigned int fs_value;
+	unsigned int bck_value;
+	bool cco_mux_divided;
+
+	/* TDM layout, only programmed once set_tdm_slot() picked TDM */
+	bool tdm_valid;
+	unsigned int slot_num_value;
+	unsigned int tdm_bck_value;
+	unsigned int tx_slot;
+	unsigned int rxl_slot;
+	unsigned int rxr_slot;
+
+	bool phase_sync;
+};
+
+#endif
