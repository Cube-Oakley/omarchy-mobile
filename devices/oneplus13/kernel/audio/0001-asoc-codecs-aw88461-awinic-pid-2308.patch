+static int aw88461_profile_info(struct snd_kcontrol *kcontrol,
+				struct snd_ctl_elem_info *uinfo)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(codec);
+	char *prof_name;
+	int count, ret;
+
+	uinfo->type = SNDRV_CTL_ELEM_TYPE_ENUMERATED;
+	uinfo->count = 1;
+
+	count = aw88461->aw_pa->prof_info.count;
+	if (count <= 0) {
+		uinfo->value.enumerated.items = 0;
+		return 0;
+	}
+
+	uinfo->value.enumerated.items = count;
+
+	if (uinfo->value.enumerated.item >= count)
+		uinfo->value.enumerated.item = count - 1;
+
+	count = uinfo->value.enumerated.item;
+
+	ret = aw88461_dev_get_prof_name(aw88461->aw_pa, count, &prof_name);
+	if (ret) {
+		strscpy(uinfo->value.enumerated.name, "null");
+		return 0;
+	}
+
+	strscpy(uinfo->value.enumerated.name, prof_name);
+
+	return 0;
+}
+
+static int aw88461_profile_get(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(codec);
+
+	ucontrol->value.enumerated.item[0] = aw88461->aw_pa->prof_index;
+
+	return 0;
+}
+
+static int aw88461_profile_set(struct snd_kcontrol *kcontrol,
+			       struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(codec);
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	unsigned int index = ucontrol->value.enumerated.item[0];
+
+	guard(mutex)(&aw88461->lock);
+
+	if (index >= aw_dev->prof_info.count)
+		return -EINVAL;
+
+	if (aw_dev->prof_index == index)
+		return 0;
+
+	aw_dev->prof_index = index;
+
+	/* a running amplifier is restarted with the new register list */
+	if (aw_dev->status) {
+		aw88461_dev_stop(aw_dev);
+		aw88461_start(aw88461);
+	}
+
+	return 1;
+}
+
+static int aw88461_volume_get(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(codec);
+	struct aw_volume_desc *vol_desc = &aw88461->aw_pa->volume_desc;
+
+	ucontrol->value.integer.value[0] = AW88461_CTL_MAX_VOL - vol_desc->ctl_volume;
+
+	return 0;
+}
+
+static int aw88461_volume_set(struct snd_kcontrol *kcontrol,
+			      struct snd_ctl_elem_value *ucontrol)
+{
+	struct snd_soc_component *codec = snd_kcontrol_chip(kcontrol);
+	struct aw88461 *aw88461 = snd_soc_component_get_drvdata(codec);
+	struct aw_device *aw_dev = aw88461->aw_pa;
+	struct aw_volume_desc *vol_desc = &aw_dev->volume_desc;
+	struct soc_mixer_control *mc =
+		(struct soc_mixer_control *)kcontrol->private_value;
+	long value = ucontrol->value.integer.value[0];
+	unsigned int att;
+
+	if (value < mc->min || value > mc->max)
+		return -EINVAL;
+
+	att = AW88461_CTL_MAX_VOL - value;
+
+	guard(mutex)(&aw88461->lock);
+
+	if (vol_desc->ctl_volume == att)
+		return 0;
+
+	vol_desc->ctl_volume = att;
+
+	/* a stopped or muted amplifier picks the new level up at start */
+	if (aw_dev->status == AW88461_DEV_PW_ON && !aw88461->mute_st)
+		aw88461_dev_set_volume(aw_dev, att);
+
+	return 1;
+}
+
+/*
+ * 0 dB is the level set by the active acf profile: the control can only
+ * attenuate. One step is 1/64 of 6.02 dB.
+ */
+static const DECLARE_TLV_DB_MINMAX(aw88461_volume_tlv, AW88461_VOL_DB_X100_MIN, 0);
+
+static const struct snd_kcontrol_new aw88461_controls[] = {
+	SOC_SINGLE_EXT_TLV("PCM Playback Volume", AW88461_SYSCTRL2_REG,
+			   0, AW88461_CTL_MAX_VOL, 0,
+			   aw88461_volume_get, aw88461_volume_set,
+			   aw88461_volume_tlv),
+	{
+		.iface = SNDRV_CTL_ELEM_IFACE_MIXER,
+		.name = "Profile Set",
+		.info = aw88461_profile_info,
+		.get = aw88461_profile_get,
+		.put = aw88461_profile_set,
+	},
+};
