CONFIG_LOCALVERSION="-omarchy-oneplus13-probe2"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_INITRAMFS_FORCE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_USB_G_SERIAL=y
CONFIG_USB_CONFIGFS=y
CONFIG_PHY_QCOM_M31_EUSB=y
CONFIG_PHY_QCOM_EUSB2_REPEATER=y
CONFIG_SM_TCSRCC_8750=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_QCOM_SPMI_PMIC=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_INTERCONNECT_QCOM_SM8750=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_QCOM_SCM=y
CONFIG_DEBUG_FS=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
# CONFIG_CPU_IDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_REMOTEPROC is not set
# CONFIG_DRM_MSM is not set
# CONFIG_SND is not set
# CONFIG_SECURITY_SELINUX is not set
# CONFIG_RANDOMIZE_BASE is not set
CONFIG_CMDLINE="clk_ignore_unused pd_ignore_unused regulator_ignore_unused loglevel=8 panic=15 rdinit=/init cpuidle.off=1"
CONFIG_CMDLINE_FORCE=y
