+
+static void ath12k_qmi_msg_cold_boot_cal_done_cb(struct qmi_handle *qmi_hdl,
+						 struct sockaddr_qrtr *sq,
+						 struct qmi_txn *txn,
+						 const void *decoded)
+{
+	struct ath12k_qmi *qmi = container_of(qmi_hdl, struct ath12k_qmi, handle);
+	struct ath12k_base *ab = qmi->ab;
+
+	ab->qmi.cal_done = 1;
+	complete(&ab->qmi.peach_cal_complete);
+	ath12k_info(ab, "CPH2655 received cold-boot calibration complete\n");
+}
+
+static int ath12k_qmi_wlanfw_cal_report_send(struct ath12k_base *ab)
+{
+	struct qmi_wlanfw_cal_report_req_msg_v01 req = {};
+	struct qmi_wlanfw_cal_report_resp_msg_v01 resp = {};
+	struct qmi_txn txn;
+	u32 caldb_size = 0;
+	int ret;
+
+	/* Stock BDF reports CalDB=0; no calibration file was downloaded.
+	 * Report bytes actually supplied, not the capacity of a DMA buffer.
+	 */
+
+	req.cal_file_download_size_valid = 1;
+	req.cal_file_download_size = caldb_size;
+
+	ret = qmi_txn_init(&ab->qmi.handle, &txn,
+			   qmi_wlanfw_cal_report_resp_msg_v01_ei, &resp);
+	if (ret < 0)
+		return ret;
+
+	ret = qmi_send_request(&ab->qmi.handle, NULL, &txn,
+			       QMI_WLANFW_CAL_REPORT_REQ_V01,
+			       QMI_WLANFW_CAL_REPORT_REQ_MSG_V01_MAX_LEN,
+			       qmi_wlanfw_cal_report_req_msg_v01_ei, &req);
+	if (ret < 0) {
+		qmi_txn_cancel(&txn);
+		ath12k_warn(ab, "qmi failed to send cal report request: %d\n", ret);
+		return ret;
+	}
+
+	ret = qmi_txn_wait(&txn, msecs_to_jiffies(ATH12K_QMI_WLANFW_TIMEOUT_MS));
+	if (ret < 0) {
+		ath12k_warn(ab, "qmi failed cal report request: %d\n", ret);
+		return ret;
+	}
+
+	if (resp.resp.result != QMI_RESULT_SUCCESS_V01) {
+		ath12k_warn(ab, "qmi cal report request failed, result: %d err: %d\n",
+			    resp.resp.result, resp.resp.error);
+		return -EINVAL;
+	}
+
+	ath12k_dbg(ab, ATH12K_DBG_QMI, "qmi cal report sent, caldb size %u\n",
+		   caldb_size);
+	return 0;
+}
+
+static int ath12k_qmi_peach_calibration_probe(struct ath12k_base *ab)
+{
+	unsigned long completed;
+	int ret, off_ret;
+
+	if (ab->qmi.peach_cal_attempted)
+		return 0;
+	ab->qmi.peach_cal_attempted = true;
+	ret = ath12k_qmi_wlanfw_cal_report_send(ab);
+	if (ret < 0)
+		return ret;
+	ath12k_info(ab, "CPH2655 starting bounded stock calibration (RAM only)\n");
+	ret = ath12k_qmi_wlanfw_mode_send(ab, ATH12K_PEACH_CALIBRATION_MODE);
+	if (ret < 0)
+		return ret;
+	ret = 0;
+	completed = wait_for_completion_timeout(&ab->qmi.peach_cal_complete,
+						 msecs_to_jiffies(30000));
+	if (!completed) {
+		ath12k_warn(ab, "CPH2655 calibration timed out; stopping\n");
+		ret = -ETIMEDOUT;
+	}
+	off_ret = ath12k_qmi_wlanfw_mode_send(ab, ATH12K_QMI_FIRMWARE_MODE_OFF);
+	if (off_ret >= 0)
+		off_ret = 0;
+	ath12k_info(ab, "CPH2655 calibration result=%d off=%d; mission mode blocked\n",
+		    ret, off_ret);
+	return ret ? ret : off_ret;
 }
 
