# Build the entire Bluetooth stack and its UART drivers with these headers.
# Do not mix LE-enabled hci_core structures with old Bluetooth modules.
CONFIG_BT=m
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_LE_L2CAP_ECRED=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_HIDP=m
CONFIG_BT_QCA=m
CONFIG_BT_BCM=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
# BlueZ's userspace HID path for Bluetooth LE keyboards and mice.
CONFIG_UHID=m
