# Apply with sm8750-oneplus13-idle.dts (or its sensors derivative).
# Remove cpuidle.off=1 from the forced command line for this profile only.
# The DT removes cluster/APSS domain-idle states, retaining core state 4.
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_ARM_PSCI_CPUIDLE=y
CONFIG_ARM_PSCI_CPUIDLE_DOMAIN=y
