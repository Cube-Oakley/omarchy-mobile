@@ -0,0 +1,41 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/thermal/google,gs201-acpm-thermal.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google GS201 firmware-owned thermal sensors
+
+maintainers:
+  - Tudor Ambarus <tudor.ambarus@linaro.org>
+
+description: |
+  The GS201 ACPM firmware exposes seven temperature groups over IPC channel 9.
+  Sensor IDs are BIG (0), MID (1), LITTLE (2), G3D (3), ISP (4), TPU (5), AUR (6).
+  Sensors must be initialized by firmware before this polling interface is used.
+
+properties:
+  compatible:
+    const: google,gs201-acpm-thermal
+
+  samsung,acpm-ipc:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: Reference to the GS201 ACPM IPC controller.
+
+  '#thermal-sensor-cells':
+    const: 1
+
+required:
+  - compatible
+  - samsung,acpm-ipc
+  - '#thermal-sensor-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    thermal-sensor {
+        compatible = "google,gs201-acpm-thermal";
+        samsung,acpm-ipc = <&acpm>;
+        #thermal-sensor-cells = <1>;
+    };
