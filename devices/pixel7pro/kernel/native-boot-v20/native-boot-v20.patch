diff --git c/drivers/gpu/drm/sysfb/pixel_bandwidth.h i/drivers/gpu/drm/sysfb/pixel_bandwidth.h
new file mode 100644
index 000000000..5ac46350f
--- /dev/null
+++ i/drivers/gpu/drm/sysfb/pixel_bandwidth.h
@@ -0,0 +1,118 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Validated cheetah display bandwidth floor via CCF and ACPM firmware DVFS.
+ * The stock mif_int_map pairs 1352 MHz MIF with 200 MHz INT. The retained
+ * 120 Hz GPU/display path underruns at the 421 MHz boot MIF rate.
+ * This narrow handoff consumer precedes a full interconnect/devfreq policy.
+ */
+#ifndef PIXEL_BANDWIDTH_H
+#define PIXEL_BANDWIDTH_H
+
+#include <linux/clk.h>
+
+struct pixel_bandwidth {
+	struct clk *mif, *interconnect;
+	unsigned long saved_rate;
+	bool active;
+};
+
+static void pixel_clk_put(void *clk)
+{
+	clk_put(clk);
+}
+
+/* Resource discovery only; atomic TEST_ONLY must not change hardware rates. */
+static int bandwidth_get(struct device *dev, struct pixel_bandwidth *bw)
+{
+	struct of_phandle_args args = { .args_count = 1 };
+	struct device_node *np;
+	const __be32 *map;
+	struct clk *mif, *interconnect;
+	bool found = false;
+	int length, ret;
+
+	if (bw->mif)
+		return 0;
+	np = of_find_node_by_path("/exynos_devfreq/devfreq_mif@17000010");
+	if (!np)
+		return -ENODEV;
+	map = of_get_property(np, "mif_int_map", &length);
+	if (map && !(length % 8))
+		for (unsigned int i = 0; i < length / 4; i += 2)
+			if (be32_to_cpu(map[i]) == 1352000 && be32_to_cpu(map[i + 1]) == 200000)
+				found = true;
+	of_node_put(np);
+	if (!found)
+		return -ENODEV;
+	args.np = of_find_node_by_path("/power-management");
+	if (!args.np)
+		return -ENODEV;
+	args.args[0] = 0;
+	mif = of_clk_get_from_provider(&args);
+	args.args[0] = 1;
+	interconnect = of_clk_get_from_provider(&args);
+	of_node_put(args.np);
+	if (IS_ERR(mif) || IS_ERR(interconnect)) {
+		ret = IS_ERR(mif) ? PTR_ERR(mif) : PTR_ERR(interconnect);
+		if (!IS_ERR(mif))
+			clk_put(mif);
+		if (!IS_ERR(interconnect))
+			clk_put(interconnect);
+		return ret;
+	}
+	/* Only the measured boot baseline and its stock-DT dependency pair. */
+	if (clk_get_rate(mif) != 421000000 || clk_get_rate(interconnect) != 200000000) {
+		clk_put(mif);
+		clk_put(interconnect);
+		return -ENODEV;
+	}
+	ret = devm_add_action_or_reset(dev, pixel_clk_put, mif);
+	if (ret) {
+		clk_put(interconnect);
+		return ret;
+	}
+	ret = devm_add_action_or_reset(dev, pixel_clk_put, interconnect);
+	if (ret)
+		return ret;
+	bw->mif = mif;
+	bw->interconnect = interconnect;
+	bw->saved_rate = 421000000;
+	return 0;
+}
+
+static int bandwidth_release(struct pixel_bandwidth *bw)
+{
+	int ret;
+
+	if (!bw->active)
+		return 0;
+	ret = clk_set_rate(bw->mif, bw->saved_rate);
+	if (ret || clk_get_rate(bw->mif) != bw->saved_rate)
+		return ret ?: -EIO;
+	clk_rate_exclusive_put(bw->mif);
+	bw->active = false;
+	return 0;
+}
+
+static int bandwidth_acquire(struct pixel_bandwidth *bw)
+{
+	int ret;
+
+	if (!bw->mif)
+		return -ENODEV;
+	if (bw->active)
+		return clk_get_rate(bw->mif) == 1352000000 ? 0 : -EIO;
+	if (clk_get_rate(bw->mif) != bw->saved_rate ||
+	    clk_get_rate(bw->interconnect) != 200000000)
+		return -EBUSY;
+	ret = clk_rate_exclusive_get(bw->mif);
+	if (ret)
+		return ret;
+	bw->active = true;
+	ret = clk_set_rate(bw->mif, 1352000000);
+	if (!ret && clk_get_rate(bw->mif) != 1352000000)
+		ret = -EIO;
+	if (ret)
+		bandwidth_release(bw);
+	return ret;
+}
+#endif
diff --git c/drivers/gpu/drm/sysfb/pixel_handoff.c i/drivers/gpu/drm/sysfb/pixel_handoff.c
new file mode 100644
index 000000000..a7696e540
--- /dev/null
+++ i/drivers/gpu/drm/sysfb/pixel_handoff.c
@@ -0,0 +1,413 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Development-only cheetah retained-display bridge. Based on simpledrm's
+ * sysfb helpers. No DMA address, DSI, clock, regulator or firmware programming.
+ * ABL's verified DECON refresh sequence is the only hardware update operation.
+ */
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/pixel_handoff.h>
+#include <linux/platform_device.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_atomic_state_helper.h>
+#include <drm/drm_damage_helper.h>
+#include <drm/drm_debugfs.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_atomic_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_gem_shmem_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modeset_helper.h>
+#include <drm/drm_modeset_helper_vtables.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_print.h>
+#include "drm_sysfb_helper.h"
+
+#define PIXEL_FB 0xfac00000UL
+#define PIXEL_DMA 0x1c0b0000UL
+#define PIXEL_DECON 0x1c240000UL
+#define PIXEL_W 1440
+#define PIXEL_H 3120
+#define PIXEL_PITCH (PIXEL_W * 4)
+#define PIXEL_SIZE PAGE_ALIGN(PIXEL_PITCH * PIXEL_H)
+
+struct pixel_device {
+	struct drm_sysfb_device sysfb;
+	struct drm_plane plane;
+	struct drm_crtc crtc;
+	struct drm_encoder encoder;
+	struct drm_connector connector;
+	void __iomem *decon;
+	unsigned int commits, timeouts;
+	spinlock_t timing_lock;
+	u64 updates, copy_ns, refresh_ns, copy_max_ns, refresh_max_ns;
+	u64 copy_busy, refresh_busy, idle_wait_ns, idle_timeouts;
+	u64 local_wc_updates, local_cached_updates, imported_updates;
+};
+
+/* Diagnostic A/B controls, RAM-only. */
+static bool pixel_wait_idle = true;
+module_param_named(wait_idle, pixel_wait_idle, bool, 0644);
+MODULE_PARM_DESC(wait_idle, "Wait for retained DECON frame completion before overwriting its buffer");
+static bool pixel_legacy_bgra;
+module_param_named(legacy_bgra, pixel_legacy_bgra, bool, 0644);
+MODULE_PARM_DESC(legacy_bgra, "Reproduce the old channel rotation for retained-display color diagnosis");
+
+static int pixel_timing_show(struct seq_file *m, void *unused)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct pixel_device *p = container_of(to_drm_sysfb_device(entry->dev),
+					    struct pixel_device, sysfb);
+	u64 updates, copy, refresh, copy_max, refresh_max;
+	u64 copy_busy, refresh_busy, idle_wait, idle_timeouts;
+	u64 local_wc, local_cached, imported;
+
+	spin_lock(&p->timing_lock);
+	updates = p->updates;
+	copy = p->copy_ns;
+	refresh = p->refresh_ns;
+	copy_max = p->copy_max_ns;
+	refresh_max = p->refresh_max_ns;
+	copy_busy = p->copy_busy;
+	refresh_busy = p->refresh_busy;
+	idle_wait = p->idle_wait_ns;
+	idle_timeouts = p->idle_timeouts;
+	local_wc = p->local_wc_updates;
+	local_cached = p->local_cached_updates;
+	imported = p->imported_updates;
+	spin_unlock(&p->timing_lock);
+	seq_puts(m, "Retained-buffer diagnostics; completion is not hardware vblank.\n");
+	seq_printf(m, "updates %llu\ncopy_total_ns %llu\nrefresh_total_ns %llu\n",
+		   updates, copy, refresh);
+	seq_printf(m, "copy_max_ns %llu\nrefresh_max_ns %llu\n", copy_max, refresh_max);
+	seq_printf(m, "copy_started_busy %llu\nrefresh_returned_busy %llu\n",
+		   copy_busy, refresh_busy);
+	seq_printf(m, "idle_wait_total_ns %llu\nidle_timeouts %llu\nwait_idle %u\n",
+		   idle_wait, idle_timeouts, READ_ONCE(pixel_wait_idle));
+	seq_printf(m, "legacy_bgra %u\n", READ_ONCE(pixel_legacy_bgra));
+	seq_printf(m, "local_wc_updates %llu\nlocal_cached_updates %llu\nimported_updates %llu\n",
+		   local_wc, local_cached, imported);
+	return 0;
+}
+static bool pixel_enabled;
+static int __init pixel_option(char *s)
+{
+	return !kstrtobool(s, &pixel_enabled);
+}
+__setup("pixel_drm=", pixel_option);
+
+/* Preserve the ABL byte layout used by the original photographed RAM probe:
+ * 0xff181818 is gray. Rotating XRGB into DRM BGRA made black appear blue on
+ * this retained path. Do not infer its byte order solely from a vendor name.
+ * Force the high alpha byte opaque regardless of userspace's X channel.
+ */
+static void pixel_blit(struct iosys_map *dst, const unsigned int *dst_pitch,
+		       const struct iosys_map *src, const struct drm_framebuffer *fb,
+		       const struct drm_rect *clip, struct drm_format_conv_state *state)
+{
+	unsigned int width = drm_rect_width(clip), height = drm_rect_height(clip);
+	__le32 *row = drm_format_conv_state_reserve(state, width * 4, GFP_KERNEL);
+	bool legacy = READ_ONCE(pixel_legacy_bgra);
+
+	if (!row)
+		return;
+	for (unsigned int y = 0; y < height; y++) {
+		iosys_map_memcpy_from(row, src, (clip->y1 + y) * fb->pitches[0] + clip->x1 * 4, width * 4);
+		for (unsigned int x = 0; x < width; x++) {
+			u32 v = le32_to_cpu(row[x]);
+
+			if (legacy)
+				v = ((v & 0xff) << 24) | ((v & 0xff00) << 8) |
+				    ((v & 0xff0000) >> 8) | 0xff;
+			else
+				v |= 0xff000000;
+			row[x] = cpu_to_le32(v);
+		}
+		iosys_map_memcpy_to(dst, y * dst_pitch[0], row, width * 4);
+	}
+}
+
+static int pixel_begin_fb_access(struct drm_plane *plane, struct drm_plane_state *state)
+{
+	int ret = drm_gem_begin_shadow_fb_access(plane, state);
+
+	if (!ret && state->fb)
+		to_drm_sysfb_plane_state(state)->blit_to_crtc = pixel_blit;
+	return ret;
+}
+
+static void pixel_refresh(struct drm_device *dev)
+{
+	struct pixel_device *p = container_of(to_drm_sysfb_device(dev), struct pixel_device, sysfb);
+	void __iomem *r = p->decon;
+	u32 before = readl(r + 4), trigger = readl(r + 0x30), update;
+	int ret;
+
+	wmb();
+	writel(readl(r + 0x50) | 0x3f, r + 0x50);
+	writel(readl(r + 0x20) | 3, r + 0x20);
+	writel(readl(r + 0x50) | 0x80100000, r + 0x50);
+	writel((trigger & ~0x10U) | 1, r + 0x30);
+	ret = readl_poll_timeout(r + 0x50, update, !update, 50, 100000);
+	writel(trigger, r + 0x30);
+	p->commits++;
+	if (ret)
+		p->timeouts++;
+	if (p->commits <= 8 || ret)
+		dev_info_ratelimited(dev->dev, "handoff commit=%u frame=%u->%u update=%08x timeouts=%u\n",
+			p->commits, before, readl(r + 4), update, p->timeouts);
+}
+
+/* cal_9845 GLOBAL_CON bit 5 is idle, not merely shadow-register latched.
+ * The retained command-mode trigger must remain masked while we write.
+ * A timeout skips the write instead of modifying an active scanout buffer.
+ */
+static bool pixel_prepare_copy(struct pixel_device *p)
+{
+	u32 status;
+	u64 start, elapsed;
+	int ret;
+
+	if (!READ_ONCE(pixel_wait_idle))
+		return true;
+	start = ktime_get_ns();
+	if (!(readl(p->decon + 0x30) & BIT(4)))
+		ret = -EBUSY;
+	else
+		ret = readl_poll_timeout(p->decon + 0x20, status,
+					status & BIT(5), 50, 100000);
+	elapsed = ktime_get_ns() - start;
+	spin_lock(&p->timing_lock);
+	p->idle_wait_ns += elapsed;
+	p->idle_timeouts += !!ret;
+	spin_unlock(&p->timing_lock);
+	if (ret)
+		dev_err_ratelimited(p->sysfb.dev.dev, "retained display not idle; skipping buffer write\n");
+	return !ret;
+}
+
+static void pixel_update(struct drm_plane *plane, struct drm_atomic_commit *state)
+{
+	struct pixel_device *p = container_of(to_drm_sysfb_device(plane->dev),
+					    struct pixel_device, sysfb);
+	u64 start = 0, copied = 0, end;
+	bool copy_busy, refresh_busy;
+
+	if (!pixel_prepare_copy(p))
+		return;
+	copy_busy = !(readl(p->decon + 0x20) & BIT(5));
+	if (IS_ENABLED(CONFIG_DRM_PIXEL_HANDOFF_TIMING))
+		start = ktime_get_ns();
+	drm_sysfb_plane_helper_atomic_update(plane, state);
+	if (IS_ENABLED(CONFIG_DRM_PIXEL_HANDOFF_TIMING))
+		copied = ktime_get_ns();
+	pixel_refresh(plane->dev);
+	refresh_busy = !(readl(p->decon + 0x20) & BIT(5));
+	if (IS_ENABLED(CONFIG_DRM_PIXEL_HANDOFF_TIMING)) {
+		end = ktime_get_ns();
+		spin_lock(&p->timing_lock);
+		p->updates++;
+		{
+			struct drm_plane_state *ps = drm_atomic_get_new_plane_state(state, plane);
+			struct drm_gem_object *obj = drm_gem_fb_get_obj(ps->fb, 0);
+
+			if (drm_gem_is_imported(obj))
+				p->imported_updates++;
+			else if (to_drm_gem_shmem_obj(obj)->map_wc)
+				p->local_wc_updates++;
+			else
+				p->local_cached_updates++;
+		}
+		p->copy_busy += copy_busy;
+		p->refresh_busy += refresh_busy;
+		p->copy_ns += copied - start;
+		p->refresh_ns += end - copied;
+		p->copy_max_ns = max(p->copy_max_ns, copied - start);
+		p->refresh_max_ns = max(p->refresh_max_ns, end - copied);
+		spin_unlock(&p->timing_lock);
+	}
+}
+static void pixel_disable(struct drm_plane *plane, struct drm_atomic_commit *state)
+{
+	struct pixel_device *p = container_of(to_drm_sysfb_device(plane->dev),
+					    struct pixel_device, sysfb);
+
+	if (!pixel_prepare_copy(p))
+		return;
+	drm_sysfb_plane_helper_atomic_disable(plane, state);
+	pixel_refresh(plane->dev);
+}
+static const struct drm_plane_helper_funcs pixel_plane_helpers = {
+	.begin_fb_access = pixel_begin_fb_access,
+	.end_fb_access = drm_gem_end_shadow_fb_access,
+	.atomic_check = drm_sysfb_plane_helper_atomic_check,
+	.atomic_update = pixel_update,
+	.atomic_disable = pixel_disable,
+};
+static const struct drm_plane_funcs pixel_plane_funcs = {
+	DRM_SYSFB_PLANE_FUNCS,
+	.destroy = drm_plane_cleanup,
+};
+static const struct drm_crtc_helper_funcs pixel_crtc_helpers = {
+	DRM_SYSFB_CRTC_HELPER_FUNCS,
+};
+static const struct drm_crtc_funcs pixel_crtc_funcs = {
+	DRM_SYSFB_CRTC_FUNCS,
+	.destroy = drm_crtc_cleanup,
+};
+static const struct drm_encoder_funcs pixel_encoder_funcs = {
+	.destroy = drm_encoder_cleanup,
+};
+static const struct drm_connector_helper_funcs pixel_connector_helpers = {
+	DRM_SYSFB_CONNECTOR_HELPER_FUNCS,
+};
+static const struct drm_connector_funcs pixel_connector_funcs = {
+	DRM_SYSFB_CONNECTOR_FUNCS,
+	.destroy = drm_connector_cleanup,
+};
+static const struct drm_mode_config_funcs pixel_mode_funcs = {
+	DRM_SYSFB_MODE_CONFIG_FUNCS,
+};
+static const u64 pixel_modifiers[] = { DRM_SYSFB_PLANE_FORMAT_MODIFIERS };
+static const u32 pixel_formats[] = { DRM_FORMAT_XRGB8888 };
+DEFINE_DRM_GEM_FOPS(pixel_fops);
+
+static struct drm_gem_object *pixel_gem_create_object(struct drm_device *dev,
+						    size_t size)
+{
+	struct drm_gem_shmem_object *shmem;
+
+	shmem = kzalloc(sizeof(*shmem), GFP_KERNEL);
+	if (!shmem)
+		return ERR_PTR(-ENOMEM);
+	/* kmsro exports our dumb buffers to the non-coherent GPU. They remain
+	 * locally owned GEM objects, so imported-buffer CPU-access helpers do
+	 * not synchronize them. Use the standard shmem WC mapping for both
+	 * kernel vmap and userspace mmap instead of retaining stale CPU lines.
+	 * The shmem helper initializes and owns the rest of this object.
+	 */
+	shmem->map_wc = true;
+	return &shmem->base;
+}
+
+static struct drm_driver pixel_driver = {
+	DRM_GEM_SHMEM_DRIVER_OPS,
+	.gem_create_object = pixel_gem_create_object,
+	.name = "pixel-handoff",
+	.desc = "Pixel retained framebuffer (development)",
+	.major = 0, .minor = 1,
+	.driver_features = DRIVER_ATOMIC | DRIVER_GEM | DRIVER_MODESET,
+	.fops = &pixel_fops,
+};
+
+static int pixel_probe(struct platform_device *pdev)
+{
+	struct pixel_device *p;
+	struct drm_device *dev;
+	struct drm_sysfb_device *s;
+	void __iomem *dma, *fb;
+	u32 ctrl, trigger;
+	int ret;
+
+	p = devm_drm_dev_alloc(&pdev->dev, &pixel_driver, struct pixel_device, sysfb.dev);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	s = &p->sysfb;
+	dev = &s->dev;
+	platform_set_drvdata(pdev, p);
+	spin_lock_init(&p->timing_lock);
+	if (IS_ENABLED(CONFIG_DRM_PIXEL_HANDOFF_TIMING))
+		drm_debugfs_add_file(dev, "pixel_timing", pixel_timing_show, NULL);
+	dma = devm_ioremap(&pdev->dev, PIXEL_DMA, PAGE_SIZE);
+	p->decon = devm_ioremap(&pdev->dev, PIXEL_DECON, PAGE_SIZE);
+	if (!dma || !p->decon)
+		return -ENOMEM;
+	ctrl = readl(dma + 8);
+	trigger = readl(p->decon + 0x30);
+	if (readl(dma + 0x40) != PIXEL_FB ||
+	    readl(dma + 0x440) != PIXEL_FB || readl(dma + 0x408) != ctrl ||
+	    readl(dma + 0x410) != (PIXEL_H << 16 | PIXEL_W) ||
+	    readl(dma + 0x10) != (PIXEL_H << 16 | PIXEL_W) ||
+	    (ctrl & 7) || ((ctrl >> 8) & 63) != 0 || readl(dma + 0x14) ||
+	    (readl(dma + 0x50) & BIT(20)) || !(readl(p->decon + 0x20) & BIT(8)) ||
+	    !(trigger & 0x11) || (trigger & 0x102)) {
+		dev_err(&pdev->dev, "retained display guard mismatch; refusing takeover\n");
+		return -ENODEV;
+	}
+	fb = devm_ioremap_wc(&pdev->dev, PIXEL_FB, PIXEL_SIZE);
+	if (!fb)
+		return -ENOMEM;
+	iosys_map_set_vaddr_iomem(&s->fb_addr, fb);
+	s->fb_mode = drm_sysfb_mode(PIXEL_W, PIXEL_H, 0, 0);
+	s->fb_format = drm_format_info(DRM_FORMAT_ARGB8888);
+	s->fb_pitch = PIXEL_PITCH;
+	ret = drmm_mode_config_init(dev);
+	if (ret)
+		return ret;
+	dev->mode_config.min_width = dev->mode_config.max_width = PIXEL_W;
+	dev->mode_config.min_height = dev->mode_config.max_height = PIXEL_H;
+	dev->mode_config.preferred_depth = 24;
+	dev->mode_config.funcs = &pixel_mode_funcs;
+	ret = drm_universal_plane_init(dev, &p->plane, 0, &pixel_plane_funcs,
+				      pixel_formats, ARRAY_SIZE(pixel_formats), pixel_modifiers,
+				      DRM_PLANE_TYPE_PRIMARY, NULL);
+	if (ret)
+		return ret;
+	drm_plane_helper_add(&p->plane, &pixel_plane_helpers);
+	drm_plane_enable_fb_damage_clips(&p->plane);
+	ret = drm_crtc_init_with_planes(dev, &p->crtc, &p->plane, NULL, &pixel_crtc_funcs, NULL);
+	if (ret)
+		return ret;
+	drm_crtc_helper_add(&p->crtc, &pixel_crtc_helpers);
+	ret = drm_encoder_init(dev, &p->encoder, &pixel_encoder_funcs, DRM_MODE_ENCODER_NONE, NULL);
+	if (ret)
+		return ret;
+	p->encoder.possible_crtcs = drm_crtc_mask(&p->crtc);
+	ret = drm_connector_init(dev, &p->connector, &pixel_connector_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+	drm_connector_helper_add(&p->connector, &pixel_connector_helpers);
+	ret = drm_connector_attach_encoder(&p->connector, &p->encoder);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(dev);
+	ret = pixel_earlycon_takeover();
+	if (ret)
+		return ret;
+	ret = drm_dev_register(dev, 0);
+	if (ret)
+		pixel_earlycon_release();
+	else
+		drm_info(dev, "1440x3120 retained scanout; earlycon now RAM-log only\n");
+	return ret;
+}
+static struct platform_driver pixel_platform_driver = {
+	.probe = pixel_probe,
+	.driver.name = "pixel-handoff",
+};
+static int __init pixel_init(void)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	if (IS_ENABLED(CONFIG_DRM_PIXEL_SCANOUT) || !pixel_enabled ||
+	    !of_machine_is_compatible("google,GS201 CHEETAH"))
+		return 0;
+	ret = platform_driver_register(&pixel_platform_driver);
+	if (ret)
+		return ret;
+	pdev = platform_device_register_simple("pixel-handoff", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&pixel_platform_driver);
+		return PTR_ERR(pdev);
+	}
+	return 0;
+}
+module_init(pixel_init);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Pixel retained framebuffer development driver");
diff --git c/drivers/gpu/drm/sysfb/pixel_panel.h i/drivers/gpu/drm/sysfb/pixel_panel.h
new file mode 100644
index 000000000..9d27e54ac
--- /dev/null
+++ i/drivers/gpu/drm/sysfb/pixel_panel.h
@@ -0,0 +1,281 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Retained DSIM0/S6E3HC4 refresh control, exclusively owned by pixel-scanout.
+ * This is a bounded handoff driver, not general DSIM power/PHY support.
+ * Source: Google display 0137241105270acf53c329e899ea9c4b6b1c8e66,
+ * s6e3hc4_set_panel_feat(), dsim_calc_underrun(), dsim_reg_set_cmd_ctrl().
+ */
+#ifndef PIXEL_PANEL_H
+#define PIXEL_PANEL_H
+
+struct pixel_panel {
+	void __iomem *dsi;
+	u32 timer, te0, underrun;
+	unsigned int refresh;
+	bool validated;
+	bool blanked;
+};
+
+static int panel_read(struct pixel_panel *panel, u8 command, unsigned int length, u8 *result)
+{
+	void __iomem *dsi = panel->dsi;
+	u8 data[16] = { 0 };
+	u32 value, header, count, type;
+	int ret;
+
+	if (!length || length > sizeof(data))
+		return -EINVAL;
+	/* Never consume a pre-existing response belonging to another owner. */
+	if (!(readl(dsi + 0x68) & BIT(12)))
+		return -EBUSY;
+	ret = readl_poll_timeout(dsi + 0x68, value,
+		(value & (BIT(10) | BIT(8))) == (BIT(10) | BIT(8)), 50, 50000);
+	if (ret)
+		return ret;
+	writel(BIT(18) | BIT(28), dsi + 0x50);
+	/* Set maximum return packet size, followed by DCS_READ with BTA. */
+	writel((length << 8) | 0x37, dsi + 0x58);
+	writel(BIT(24) | (command << 8) | 0x06, dsi + 0x58);
+	ret = readl_poll_timeout(dsi + 0x50, value, value & BIT(18), 50, 100000);
+	if (ret) {
+		pr_err("pixel-dsi: read %02x timeout irq=%08x fifo=%08x status=%08x\n",
+			command, value, readl(dsi + 0x68), readl(dsi + 0x8c));
+		return ret;
+	}
+	if (readl(dsi + 0x68) & BIT(12))
+		return -ENODATA;
+	header = readl(dsi + 0x60);
+	type = header & 0x3f;
+	if (type == 0x21 || type == 0x22) {
+		count = type == 0x21 ? 1 : 2;
+		data[0] = header >> 8;
+		data[1] = header >> 16;
+	} else if (type == 0x1c) {
+		count = (header >> 8) & 0xffff;
+		if (!count || count > sizeof(data))
+			return -EMSGSIZE;
+		for (unsigned int i = 0; i < count; i++) {
+			if (!(i % 4)) {
+				if (readl(dsi + 0x68) & BIT(12))
+					return -ENODATA;
+				value = readl(dsi + 0x60);
+			}
+			data[i] = value >> (8 * (i % 4));
+		}
+	} else {
+		pr_err("pixel-dsi: read %02x unexpected response %08x\n", command, header);
+		return -EPROTO;
+	}
+	if (!(readl(dsi + 0x68) & BIT(12))) {
+		/* The vendor host drains trailers with a bounded loop. */
+		for (unsigned int i = 0; i < 4 && !(readl(dsi + 0x68) & BIT(12)); i++)
+			pr_info("pixel-dsi: RX trailer %08x\n", readl(dsi + 0x60));
+		if (!(readl(dsi + 0x68) & BIT(12)))
+			return -EOVERFLOW;
+	}
+	writel(BIT(18) | BIT(28), dsi + 0x50);
+	pr_info("pixel-dsi: DCS %02x response=%08x bytes=%u data=%*ph\n",
+		command, header, count, count, data);
+	if (count != length)
+		return -EMSGSIZE;
+	memcpy(result, data, count);
+	return 0;
+}
+
+static void panel_queue(struct pixel_panel *panel, const u8 *data, unsigned int length)
+{
+	void __iomem *dsi = panel->dsi;
+	u32 payload;
+
+	if (length == 2) {
+		writel((data[1] << 16) | (data[0] << 8) | 0x15, dsi + 0x58);
+		return;
+	}
+	for (unsigned int i = 0; i < length; i += 4) {
+		payload = 0;
+		for (unsigned int j = 0; j < 4 && i + j < length; j++)
+			payload |= (u32)data[i + j] << (8 * j);
+		writel(payload, dsi + 0x5c);
+	}
+	writel((length << 8) | 0x39, dsi + 0x58);
+}
+#define PANEL_CMD(...) do { \
+	const u8 bytes[] = { __VA_ARGS__ }; \
+	panel_queue(panel, bytes, ARRAY_SIZE(bytes)); \
+} while (0)
+
+
+static int panel_flush(struct pixel_panel *panel)
+{
+	void __iomem *dsi = panel->dsi;
+	u32 state;
+	int ret;
+
+	writel(BIT(28) | BIT(29), dsi + 0x50);
+	writel(BIT(16) | BIT(17), dsi + 0x80);
+	ret = readl_poll_timeout(dsi + 0x68, state,
+		(state & 0x500) == 0x500, 50, 100000);
+	writel(0, dsi + 0x80);
+	return ret;
+}
+
+/* DCS display-off retains panel timing/DSC state. This is not sleep-in or
+ * rail power-off. The caller owns commit ordering and has stopped DMA.
+ */
+static int panel_blank(struct pixel_panel *panel, bool blank)
+{
+	void __iomem *dsi = panel->dsi;
+	u32 state;
+	u8 power;
+	int ret;
+
+	if (!panel->validated)
+		return -EINVAL;
+	if (blank == panel->blanked)
+		return 0;
+	if (readl(dsi + 0x80))
+		return -EBUSY;
+	ret = readl_poll_timeout(dsi + 0x68, state,
+		(state & 0x500) == 0x500, 50, 50000);
+	if (ret)
+		return ret;
+	/* One-byte DCS short write, no parameter. */
+	writel(BIT(16), dsi + 0x80);
+	writel(((blank ? 0x28 : 0x29) << 8) | 0x05, dsi + 0x58);
+	ret = panel_flush(panel);
+	if (ret)
+		return ret;
+	msleep(20);
+	ret = panel_read(panel, 0x0a, 1, &power);
+	if (ret)
+		return ret;
+	if (!!(power & BIT(2)) == blank)
+		return -EIO;
+	panel->blanked = blank;
+	pr_info("pixel-panel: display %s power=%02x\n", blank ? "off" : "on", power);
+	return 0;
+}
+
+static int panel_key(struct pixel_panel *panel, bool unlock)
+{
+	writel(BIT(16), panel->dsi + 0x80);
+	PANEL_CMD(0xf0, unlock ? 0x5a : 0xa5, unlock ? 0x5a : 0xa5);
+	return panel_flush(panel);
+}
+
+/* Called only with DECON idle and its trigger masked, under commit ordering. */
+static int panel_refresh(struct pixel_panel *panel, unsigned int refresh)
+{
+	void __iomem *dsi = panel->dsi;
+	bool fast = refresh == 120;
+	u32 state;
+	int ret;
+
+	if (!panel->validated || (refresh != 60 && refresh != 120))
+		return -EINVAL;
+	if (refresh == panel->refresh)
+		return 0;
+	if (readl(dsi + 0x80))
+		return -EBUSY;
+	ret = readl_poll_timeout(dsi + 0x68, state,
+		(state & 0x500) == 0x500, 50, 50000);
+	if (ret)
+		return ret;
+	/* Full correlated non-HBM, HS, manual-refresh group; do not split. */
+	writel(BIT(16), dsi + 0x80);
+	PANEL_CMD(0xf0, 0x5a, 0x5a);
+	PANEL_CMD(0xb9, fast ? 0x51 : 0x04);
+	PANEL_CMD(0xbd, 0x21, fast ? 0x01 : 0x81, 0x83, 0x03, 0x03);
+	PANEL_CMD(0xb0, 0x00, 0x1e, 0xbd);
+	PANEL_CMD(0xbd, 0x00, 0x00, 0x00, 0x02, 0x00, 0x06, 0x00, 0x16);
+	PANEL_CMD(0xbd, 0x21);
+	PANEL_CMD(0x60, fast ? 0x00 : 0x01);
+	PANEL_CMD(0xf7, 0x0f);
+	PANEL_CMD(0xf0, 0xa5, 0xa5);
+	ret = panel_flush(panel);
+	if (ret) {
+		/* A partial transaction is not a known mode; force later recovery. */
+		panel->refresh = 0;
+		return ret;
+	}
+	/* Vendor timing formula, validated 1346 MHz PLL, four lanes, DSC 3:1.
+	 * max_frame=7,900,825ns, min_transfer=6,708,231ns => 1004 LP units.
+	 * Restore the exact firmware values for the original 60 Hz mode.
+	 */
+	writel(fast ? 1004 : panel->underrun, dsi + 0x34);
+	writel(fast ? 28 : panel->te0, dsi + 0x84);
+	writel(fast ? 0x1a031e1f : panel->timer, dsi + 0x88);
+	panel->refresh = refresh;
+	return 0;
+}
+
+static int panel_validate(struct device *dev, struct pixel_panel *panel)
+{
+	struct device_node *np;
+	struct resource res;
+	void __iomem *phy;
+	bool valid;
+	u8 data[16];
+	int ret, lock_ret;
+	static const u8 te[] = { 0, 4, 0, 0, 0x0c, 0x42, 0, 0x1b,
+				0x0c, 0x42, 0, 0x1b, 0x0c, 0x42, 0, 0x1b };
+	static const u8 bd[] = { 0x21, 0x81, 0x83, 3, 3 };
+
+	np = of_find_node_by_path("/drmdsim@0x1C2C0000");
+	if (!np)
+		return -ENODEV;
+	valid = !of_address_to_resource(np, 0, &res) && res.start == 0x1c2c0000 &&
+		resource_size(&res) == 0x300;
+	valid = valid && !of_address_to_resource(np, 1, &res) &&
+		res.start == 0x1c2e0100 && resource_size(&res) == 0x700;
+	of_node_put(np);
+	if (!valid)
+		return -ENODEV;
+	panel->dsi = devm_ioremap(dev, 0x1c2c0000, PAGE_SIZE);
+	phy = ioremap(0x1c2e0100, 0x100);
+	if (!phy || !panel->dsi) {
+		if (phy)
+			iounmap(phy);
+		return -ENOMEM;
+	}
+	valid = (readl(phy) & 0x173f) == 0x1202 &&
+		(readl(phy + 4) & 0xffff) == 0x1355 &&
+		(readl(phy + 8) & 0x3ff) == 0xdb;
+	iounmap(phy);
+	if (!valid || readl(panel->dsi) != 0x02060000 ||
+	    readl(panel->dsi + 0x4c) != 0x04887cff || readl(panel->dsi + 0x80))
+		return -ENODEV;
+	panel->timer = readl(panel->dsi + 0x88);
+	panel->te0 = readl(panel->dsi + 0x84);
+	panel->underrun = readl(panel->dsi + 0x34);
+	if (panel->timer != 0x33eb3b26 || panel->te0 != 86 || panel->underrun != 7945)
+		return -ENODEV;
+	ret = panel_read(panel, 0xda, 1, data);
+	if (ret || data[0] != 0x0a)
+		return ret ?: -ENODEV;
+	ret = panel_read(panel, 0xdb, 1, data);
+	if (ret || data[0] != 0x80)
+		return ret ?: -ENODEV;
+	ret = panel_read(panel, 0xdc, 1, data);
+	if (ret || data[0] != 0x06)
+		return ret ?: -ENODEV;
+	ret = panel_read(panel, 0x54, 1, data);
+	if (ret || data[0] != 0x20)
+		return ret ?: -ENODEV;
+	ret = panel_key(panel, true);
+	if (!ret)
+		ret = panel_read(panel, 0xb9, sizeof(te), data);
+	if (!ret && memcmp(data, te, sizeof(te)))
+		ret = -ENODEV;
+	if (!ret)
+		ret = panel_read(panel, 0xbd, sizeof(bd), data);
+	if (!ret && memcmp(data, bd, sizeof(bd)))
+		ret = -ENODEV;
+	lock_ret = panel_key(panel, false);
+	if (ret || lock_ret)
+		return ret ?: lock_ret;
+	panel->refresh = 60;
+	panel->validated = true;
+	return 0;
+}
+#undef PANEL_CMD
+#endif
diff --git c/drivers/gpu/drm/sysfb/pixel_scanout.c i/drivers/gpu/drm/sysfb/pixel_scanout.c
new file mode 100644
index 000000000..b9b053a7c
--- /dev/null
+++ i/drivers/gpu/drm/sysfb/pixel_scanout.c
@@ -0,0 +1,581 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cheetah retained-mode native DMA scanout. Standard GEM DMA allocation/import
+ * and atomic fences; real DECON frame-done IRQ completion. DSI/DSC/panel mode,
+ * clocks and disabled SysMMU state remain owned by the firmware handoff.
+ * Optional validated S6E3HC4 control owns 60/120 Hz refresh transitions.
+ */
+#include <linux/completion.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/pixel_handoff.h>
+#include <linux/platform_device.h>
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_debugfs.h>
+#include <drm/drm_drv.h>
+#include <drm/drm_fb_dma_helper.h>
+#include <drm/drm_fourcc.h>
+#include <drm/drm_framebuffer.h>
+#include <drm/drm_gem_dma_helper.h>
+#include <drm/drm_gem_framebuffer_helper.h>
+#include <drm/drm_managed.h>
+#include <drm/drm_modeset_helper.h>
+#include <drm/drm_probe_helper.h>
+#include <drm/drm_print.h>
+#include <drm/drm_simple_kms_helper.h>
+#include <drm/drm_vblank.h>
+#include "drm_sysfb_helper.h"
+#include "pixel_panel.h"
+#include "pixel_bandwidth.h"
+
+static bool panel120;
+module_param(panel120, bool, 0444);
+
+#define ORIGINAL_FB 0xfac00000U
+#define WIDTH 1440
+#define HEIGHT 3120
+#define PITCH (WIDTH * 4)
+#define FRAME_START BIT(12)
+#define FRAME_DONE BIT(13)
+#define FRAME_MASK (FRAME_START | FRAME_DONE)
+
+struct pixel_scanout {
+	struct drm_device drm;
+	struct drm_simple_display_pipe pipe;
+	struct drm_connector connector;
+	struct drm_display_mode mode, fast_mode;
+	struct pixel_panel panel;
+	struct pixel_bandwidth bandwidth;
+	void __iomem *decon, *dma;
+	struct completion done;
+	struct drm_pending_vblank_event *pending_event;
+	u32 pending_dma;
+	struct drm_framebuffer *held, *failed_fb;
+	int irq_start, irq_done;
+	bool running, faulted, event_armed;
+	atomic64_t starts, dones, flips, failures, start_events, late_events, underruns;
+};
+
+static struct pixel_scanout *to_pixel(struct drm_device *drm)
+{
+	return container_of(drm, struct pixel_scanout, drm);
+}
+
+/* Own the event independently of crtc->state: userspace can queue the next
+ * atomic state as soon as this event is delivered. The current DMA buffer and
+ * the old buffer remain pinned until frame-done, irrespective of event timing.
+ */
+static void pixel_pending_event(struct pixel_scanout *p, bool at_start)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&p->drm.event_lock, flags);
+	if (p->pending_event) {
+		WRITE_ONCE(p->event_armed, false);
+		drm_crtc_send_vblank_event(&p->pipe.crtc, p->pending_event);
+		p->pending_event = NULL;
+		atomic64_inc(at_start ? &p->start_events : &p->late_events);
+	}
+	spin_unlock_irqrestore(&p->drm.event_lock, flags);
+}
+
+static irqreturn_t pixel_irq(int irq, void *data)
+{
+	struct pixel_scanout *p = data;
+	u32 bit = irq == p->irq_start ? FRAME_START : FRAME_DONE;
+
+	if (!(readl(p->decon + 0x70) & bit))
+		return IRQ_NONE;
+	writel(bit, p->decon + 0x70);
+	readl(p->decon + 0x70);
+	if (bit == FRAME_START) {
+		atomic64_inc(&p->starts);
+		if (panel120 && READ_ONCE(p->running)) {
+			drm_crtc_handle_vblank(&p->pipe.crtc);
+			/* Require hardware to have latched the submitted buffer. */
+			if (READ_ONCE(p->event_armed) &&
+			    readl(p->dma + 0x440) == READ_ONCE(p->pending_dma))
+				pixel_pending_event(p, true);
+		}
+	} else {
+		atomic64_inc(&p->dones);
+		if (!panel120 && READ_ONCE(p->running))
+			drm_crtc_handle_vblank(&p->pipe.crtc);
+		complete(&p->done);
+	}
+	return IRQ_HANDLED;
+}
+
+/* Caller keeps both old and new GEM objects alive until completion and idle.
+ * This command-mode handoff sends frames on demand. Its frame-done counter is
+ * real hardware completion, not a continuous TE or optical-refresh counter.
+ */
+static int pixel_transfer(struct pixel_scanout *p, u32 address)
+{
+	u32 trigger = readl(p->decon + 0x30), status;
+	int ret;
+
+	if (!(trigger & BIT(4))) {
+		ret = -EBUSY;
+		goto failed;
+	}
+	ret = readl_poll_timeout(p->decon + 0x20, status, status & BIT(5), 50, 100000);
+	if (ret)
+		goto failed;
+	synchronize_irq(p->irq_start);
+	synchronize_irq(p->irq_done);
+	reinit_completion(&p->done);
+	if (panel120)
+		writel(BIT(19), p->panel.dsi + 0x50);
+	/* Publish completed CPU writes before the DMA address and trigger. */
+	wmb();
+	writel(address, p->dma + 0x40);
+	writel(readl(p->decon + 0x50) | 0x3f, p->decon + 0x50);
+	writel(readl(p->decon + 0x20) | 3, p->decon + 0x20);
+	writel(readl(p->decon + 0x50) | 0x80100000, p->decon + 0x50);
+	/* Ignore any stale start IRQ before this new transfer is armed. */
+	WRITE_ONCE(p->event_armed, panel120 && p->pending_event);
+	writel((trigger & ~BIT(4)) | 1, p->decon + 0x30);
+	ret = wait_for_completion_timeout(&p->done, msecs_to_jiffies(100)) ? 0 : -ETIMEDOUT;
+	writel(trigger, p->decon + 0x30);
+	if (!ret)
+		ret = readl_poll_timeout(p->decon + 0x20, status, status & BIT(5), 50, 100000);
+	if (!ret && panel120 && (readl(p->panel.dsi + 0x50) & BIT(19))) {
+		atomic64_inc(&p->underruns);
+		ret = -EPIPE;
+	}
+	if (!ret && readl(p->dma + 0x440) != address)
+		ret = -EIO;
+failed:
+	if (ret) {
+		p->faulted = true;
+		atomic64_inc(&p->failures);
+		drm_err(&p->drm, "DMA scanout failed %d address=%08x shadow=%08x; buffers retained\n",
+			ret, address, readl(p->dma + 0x440));
+	} else {
+		atomic64_inc(&p->flips);
+	}
+	return ret;
+}
+
+static void pixel_send_event(struct drm_crtc *crtc)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&crtc->dev->event_lock, flags);
+	if (crtc->state->event) {
+		drm_crtc_send_vblank_event(crtc, crtc->state->event);
+		crtc->state->event = NULL;
+	}
+	spin_unlock_irqrestore(&crtc->dev->event_lock, flags);
+}
+
+static int pixel_check(struct drm_simple_display_pipe *pipe,
+		       struct drm_plane_state *ps, struct drm_crtc_state *cs)
+{
+	struct pixel_scanout *p = to_pixel(pipe->crtc.dev);
+	struct drm_framebuffer *fb = ps->fb;
+	struct drm_gem_dma_object *obj;
+	int ret;
+
+	if (p->faulted)
+		return -EIO;
+	if (!fb)
+		return 0;
+	if (panel120 && drm_mode_vrefresh(&cs->mode) == 120) {
+		ret = bandwidth_get(p->drm.dev, &p->bandwidth);
+		if (ret)
+			return ret;
+	}
+	if (fb->width != WIDTH || fb->height != HEIGHT || fb->pitches[0] != PITCH ||
+	    fb->offsets[0] || fb->modifier != DRM_FORMAT_MOD_LINEAR ||
+	    ps->src_x || ps->src_y || ps->src_w != WIDTH << 16 || ps->src_h != HEIGHT << 16)
+		return -EINVAL;
+	obj = drm_fb_dma_get_gem_obj(fb, 0);
+	if (!obj || obj->base.size < PITCH * HEIGHT ||
+	    upper_32_bits(obj->dma_addr + PITCH * HEIGHT - 1))
+		return -EINVAL;
+	return 0;
+}
+
+static void pixel_update(struct drm_simple_display_pipe *pipe, struct drm_plane_state *old)
+{
+	struct pixel_scanout *p = to_pixel(pipe->crtc.dev);
+	struct drm_framebuffer *fb = pipe->plane.state->fb;
+	struct drm_gem_dma_object *obj;
+	unsigned long flags;
+
+	if (!fb || p->faulted)
+		goto event;
+	obj = drm_fb_dma_get_gem_obj(fb, 0);
+	drm_framebuffer_get(fb);
+	if (panel120) {
+		spin_lock_irqsave(&p->drm.event_lock, flags);
+		WRITE_ONCE(p->event_armed, false);
+		p->pending_event = pipe->crtc.state->event;
+		pipe->crtc.state->event = NULL;
+		p->pending_dma = lower_32_bits(obj->dma_addr);
+		spin_unlock_irqrestore(&p->drm.event_lock, flags);
+	}
+	if (pixel_transfer(p, lower_32_bits(obj->dma_addr))) {
+		/* Fail closed: reject later commits and pin every potentially active
+		 * buffer until a confirmed restore or the end of this RAM boot.
+		 */
+		p->failed_fb = fb;
+	} else {
+		if (p->held)
+			drm_framebuffer_put(p->held);
+		p->held = fb;
+	}
+	if (panel120) {
+		/* A missed start or failed transfer must still release its waiter.
+		 * Never access the live CRTC state after sending an early event.
+		 */
+		pixel_pending_event(p, false);
+		return;
+	}
+event:
+	/* Successful updates reach here only after real frame-done and idle.
+	 * On a logged hardware failure release the commit waiter, while extra
+	 * references prevent hardware from accessing a freed buffer.
+	 */
+	pixel_send_event(&pipe->crtc);
+}
+
+static int pixel_enable_vblank(struct drm_simple_display_pipe *pipe)
+{
+	/* IRQs stay enabled for transfer completion while the device is bound. */
+	return 0;
+}
+
+static void pixel_enable(struct drm_simple_display_pipe *pipe,
+			 struct drm_crtc_state *cs, struct drm_plane_state *ps)
+{
+	struct pixel_scanout *p = to_pixel(pipe->crtc.dev);
+
+	if (panel120 &&
+	    ((drm_mode_vrefresh(&cs->mode) == 120 && bandwidth_acquire(&p->bandwidth)) ||
+	     panel_refresh(&p->panel, drm_mode_vrefresh(&cs->mode)) ||
+	     panel_blank(&p->panel, false))) {
+		p->faulted = true;
+		atomic64_inc(&p->failures);
+		drm_err(&p->drm, "panel/bandwidth mode change failed; rejecting further transfers\n");
+		return;
+	}
+	drm_crtc_vblank_on(&pipe->crtc);
+	if (drm_crtc_vblank_get(&pipe->crtc))
+		drm_warn(&p->drm, "failed to enable completion counting\n");
+	WRITE_ONCE(p->running, true);
+}
+
+static void pixel_disable(struct drm_simple_display_pipe *pipe)
+{
+	struct pixel_scanout *p = to_pixel(pipe->crtc.dev);
+	int ret;
+
+	if (panel120) {
+		u32 status;
+
+		/* Keep the compositor's final (CRT black) image in panel GRAM.
+		 * Do not flash the boot console by restoring ORIGINAL_FB here.
+		 * Hold the last DMA buffer across DPMS until a new transfer replaces
+		 * it; the hardware shadow still refers to that allocation.
+		 */
+		ret = (readl(p->decon + 0x30) & BIT(4)) ?
+			readl_poll_timeout(p->decon + 0x20, status,
+					   status & BIT(5), 50, 100000) : -EBUSY;
+	} else {
+		ret = pixel_transfer(p, ORIGINAL_FB);
+	}
+	if (!ret && !panel120) {
+		if (p->held)
+			drm_framebuffer_put(p->held);
+		if (p->failed_fb)
+			drm_framebuffer_put(p->failed_fb);
+		p->held = NULL;
+		p->failed_fb = NULL;
+	}
+	if (panel120 && (ret || panel_refresh(&p->panel, 60) ||
+			 bandwidth_release(&p->bandwidth) || panel_blank(&p->panel, true))) {
+		p->faulted = true;
+		atomic64_inc(&p->failures);
+		drm_err(&p->drm, "panel/bandwidth restore failed\n");
+	}
+	pixel_send_event(&pipe->crtc);
+	if (!p->running)
+		return;
+	WRITE_ONCE(p->running, false);
+	drm_crtc_vblank_put(&pipe->crtc);
+	drm_crtc_vblank_off(&pipe->crtc);
+}
+
+static enum drm_mode_status pixel_mode_valid(struct drm_simple_display_pipe *pipe,
+					    const struct drm_display_mode *mode)
+{
+	struct pixel_scanout *p = to_pixel(pipe->crtc.dev);
+
+	return drm_mode_equal(mode, &p->mode) ||
+		(panel120 && drm_mode_equal(mode, &p->fast_mode)) ? MODE_OK : MODE_BAD;
+}
+
+static const struct drm_simple_display_pipe_funcs pixel_pipe_funcs = {
+	.mode_valid = pixel_mode_valid,
+	.check = pixel_check,
+	.update = pixel_update,
+	.enable = pixel_enable,
+	.disable = pixel_disable,
+	.enable_vblank = pixel_enable_vblank,
+};
+
+static int pixel_get_modes(struct drm_connector *connector)
+{
+	struct pixel_scanout *p = to_pixel(connector->dev);
+	struct drm_display_mode *mode = drm_mode_duplicate(connector->dev, &p->mode);
+
+	if (!mode)
+		return 0;
+	mode->type |= DRM_MODE_TYPE_DRIVER;
+	if (!panel120)
+		mode->type |= DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	if (!panel120)
+		return 1;
+	mode = drm_mode_duplicate(connector->dev, &p->fast_mode);
+	if (!mode)
+		return 1;
+	mode->type |= DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	return 2;
+}
+
+static const struct drm_connector_helper_funcs pixel_connector_helpers = {
+	.get_modes = pixel_get_modes,
+};
+static const struct drm_connector_funcs pixel_connector_funcs = {
+	DRM_SYSFB_CONNECTOR_FUNCS,
+	.destroy = drm_connector_cleanup,
+};
+static const struct drm_mode_config_funcs pixel_mode_funcs = {
+	.fb_create = drm_gem_fb_create,
+	.atomic_check = drm_atomic_helper_check,
+	.atomic_commit = drm_atomic_helper_commit,
+};
+
+static void pixel_commit_tail(struct drm_atomic_commit *state)
+{
+	struct drm_device *dev = state->dev;
+
+	drm_atomic_helper_commit_modeset_disables(dev, state);
+	drm_atomic_helper_commit_modeset_enables(dev, state);
+	drm_atomic_helper_commit_planes(dev, state, DRM_PLANE_COMMIT_ACTIVE_ONLY);
+	drm_atomic_helper_commit_hw_done(state);
+	/* Command-mode transfer is already complete. No further vblank is
+	 * promised while the panel is idle; wait for our delivered flip event.
+	 */
+	drm_atomic_helper_wait_for_flip_done(dev, state);
+	drm_atomic_helper_cleanup_planes(dev, state);
+}
+
+static const struct drm_mode_config_helper_funcs pixel_mode_helpers = {
+	/* Turn completion accounting on before the initial plane update. */
+	.atomic_commit_tail = pixel_commit_tail,
+};
+static const u32 pixel_formats[] = { DRM_FORMAT_XRGB8888 };
+static const u64 pixel_modifiers[] = { DRM_FORMAT_MOD_LINEAR, DRM_FORMAT_MOD_INVALID };
+DEFINE_DRM_GEM_DMA_FOPS(pixel_fops);
+static const struct drm_driver pixel_driver = {
+	DRM_GEM_DMA_DRIVER_OPS,
+	/* Preserve the Mesa kmsro device match from the validated userspace. */
+	.name = "pixel-handoff",
+	.desc = "Pixel native DMA scanout (retained panel mode)",
+	.major = 0, .minor = 2,
+	.driver_features = DRIVER_ATOMIC | DRIVER_GEM | DRIVER_MODESET,
+	.fops = &pixel_fops,
+};
+
+static int pixel_stats(struct seq_file *m, void *unused)
+{
+	struct drm_debugfs_entry *entry = m->private;
+	struct pixel_scanout *p = to_pixel(entry->dev);
+
+	seq_puts(m, "Native DMA scanout; on-demand frame IRQs, not continuous panel TE.\n");
+	seq_printf(m, "starts %lld\ndones %lld\ncompleted_transfers %lld\nfailures %lld\n",
+		   atomic64_read(&p->starts), atomic64_read(&p->dones),
+		   atomic64_read(&p->flips), atomic64_read(&p->failures));
+	seq_printf(m, "cpu_pixel_copy_bytes 0\nactive_dma %08x\nfaulted %u\n",
+		   readl(p->dma + 0x440), p->faulted);
+	seq_printf(m, "panel_blanked %u\n", p->panel.blanked);
+	seq_printf(m, "panel_refresh_hz %u\nstart_events %lld\nlate_events %lld\n",
+		   p->panel.refresh, atomic64_read(&p->start_events), atomic64_read(&p->late_events));
+	seq_printf(m, "bandwidth_active %u\nmif_rate_hz %lu\ndsi_underruns %lld\n",
+		   p->bandwidth.active, p->bandwidth.mif ? clk_get_rate(p->bandwidth.mif) : 0,
+		   atomic64_read(&p->underruns));
+	return 0;
+}
+
+static void pixel_irq_off(void *data)
+{
+	struct pixel_scanout *p = data;
+
+	writel(FRAME_MASK, p->decon + 0x60);
+	readl(p->decon + 0x60);
+}
+
+static int pixel_probe(struct platform_device *pdev)
+{
+	struct pixel_scanout *p;
+	struct device_node *np;
+	struct resource res;
+	void __iomem *pmu, *mmu;
+	u32 cells[6];
+	bool valid;
+	int ret;
+
+	pdev->dev.dma_mask = &pdev->dev.coherent_dma_mask;
+	ret = dma_set_mask_and_coherent(&pdev->dev, DMA_BIT_MASK(32));
+	if (ret)
+		return ret;
+	p = devm_drm_dev_alloc(&pdev->dev, &pixel_driver, struct pixel_scanout, drm);
+	if (IS_ERR(p))
+		return PTR_ERR(p);
+	platform_set_drvdata(pdev, p);
+	init_completion(&p->done);
+	pmu = devm_ioremap(&pdev->dev, 0x18062000, PAGE_SIZE);
+	if (!pmu || !(readl(pmu + 0x204) & 1) || !(readl(pmu + 0x284) & 1))
+		return -ENODEV;
+	mmu = devm_ioremap(&pdev->dev, 0x1c100000, 0x10000);
+	if (!mmu || readl(mmu + 0x34) != 0x80200001 ||
+	    readl(mmu + 0x874) != 0xe0a1 || readl(mmu) ||
+	    readl(mmu + 0x8000) || readl(mmu + 0x800c))
+		return -ENODEV;
+	p->decon = devm_ioremap(&pdev->dev, 0x1c240000, PAGE_SIZE);
+	p->dma = devm_ioremap(&pdev->dev, 0x1c0b0000, PAGE_SIZE);
+	if (!p->decon || !p->dma)
+		return -ENOMEM;
+	if (readl(p->decon + 0x60) != FRAME_MASK ||
+	    !(readl(p->decon + 0x20) & BIT(8)) ||
+	    (readl(p->decon + 0x30) & 0x11) != 0x10 ||
+	    readl(p->dma + 0x40) != ORIGINAL_FB || readl(p->dma + 0x440) != ORIGINAL_FB ||
+	    readl(p->dma + 0x408) != 0xff400000 || readl(p->dma + 0x410) != 0x0c3005a0 ||
+	    readl(p->dma + 0x414) || readl(p->dma + 0x450))
+		return -ENODEV;
+	np = of_find_node_by_path("/drmdecon@0x1C240000");
+	if (!np)
+		return -ENODEV;
+	valid = !of_address_to_resource(np, 0, &res) && res.start == 0x1c240000 &&
+		resource_size(&res) == 0x6000 &&
+		!of_property_read_u32_array(np, "interrupts", cells, 6) &&
+		!cells[0] && cells[1] == 241 && cells[2] == 4 &&
+		!cells[3] && cells[4] == 240 && cells[5] == 4;
+	p->irq_start = of_irq_get_byname(np, "frame_start");
+	p->irq_done = of_irq_get_byname(np, "frame_done");
+	of_node_put(np);
+	if (!valid || p->irq_start <= 0 || p->irq_done <= 0)
+		return -ENODEV;
+	ret = drmm_mode_config_init(&p->drm);
+	if (ret)
+		return ret;
+	p->mode = drm_sysfb_mode(WIDTH, HEIGHT, 71, 155);
+	if (panel120) {
+		p->mode = (struct drm_display_mode) {
+			.clock = 298620,
+			.hdisplay = WIDTH, .hsync_start = 1520,
+			.hsync_end = 1544, .htotal = 1580,
+			.vdisplay = HEIGHT, .vsync_start = 3132,
+			.vsync_end = 3136, .vtotal = 3150,
+			.width_mm = 71, .height_mm = 155,
+		};
+		p->fast_mode = p->mode;
+		p->fast_mode.clock = 597240;
+		drm_mode_set_name(&p->fast_mode);
+	}
+	drm_mode_set_name(&p->mode);
+	p->drm.mode_config.min_width = p->drm.mode_config.max_width = WIDTH;
+	p->drm.mode_config.min_height = p->drm.mode_config.max_height = HEIGHT;
+	p->drm.mode_config.preferred_depth = 24;
+	p->drm.mode_config.funcs = &pixel_mode_funcs;
+	p->drm.mode_config.helper_private = &pixel_mode_helpers;
+	ret = drm_connector_init(&p->drm, &p->connector, &pixel_connector_funcs,
+				 DRM_MODE_CONNECTOR_DSI);
+	if (ret)
+		return ret;
+	drm_connector_helper_add(&p->connector, &pixel_connector_helpers);
+	ret = drm_simple_display_pipe_init(&p->drm, &p->pipe, &pixel_pipe_funcs,
+		pixel_formats, ARRAY_SIZE(pixel_formats), pixel_modifiers, &p->connector);
+	if (ret)
+		return ret;
+	ret = drm_vblank_init(&p->drm, 1);
+	if (ret)
+		return ret;
+	drm_mode_config_reset(&p->drm);
+	ret = pixel_earlycon_takeover();
+	if (ret)
+		return ret;
+	if (panel120) {
+		ret = panel_validate(&pdev->dev, &p->panel);
+		if (ret) {
+			drm_err(&p->drm, "panel/DSIM baseline rejected: %d\n", ret);
+			goto release_console;
+		}
+	}
+	ret = devm_request_irq(&pdev->dev, p->irq_start, pixel_irq, 0, "pixel-decon-start", p);
+	if (ret)
+		goto release_console;
+	ret = devm_request_irq(&pdev->dev, p->irq_done, pixel_irq, 0, "pixel-decon-done", p);
+	if (ret)
+		goto release_console;
+	ret = devm_add_action_or_reset(&pdev->dev, pixel_irq_off, p);
+	if (ret)
+		goto release_console;
+	writel(FRAME_MASK, p->decon + 0x70);
+	writel(FRAME_MASK | BIT(0), p->decon + 0x60);
+	drm_debugfs_add_file(&p->drm, "pixel_scanout", pixel_stats, NULL);
+	ret = drm_dev_register(&p->drm, 0);
+	if (ret)
+		goto release_console;
+	drm_info(&p->drm, "native DMA scanout, hardware frame completion, panel120=%u\n", panel120);
+	return 0;
+release_console:
+	pixel_irq_off(p);
+	pixel_earlycon_release();
+	return ret;
+}
+
+static void pixel_shutdown(struct platform_device *pdev)
+{
+	struct pixel_scanout *p = platform_get_drvdata(pdev);
+
+	drm_atomic_helper_shutdown(&p->drm);
+	pixel_irq_off(p);
+}
+static struct platform_driver pixel_platform_driver = {
+	.probe = pixel_probe,
+	.shutdown = pixel_shutdown,
+	.driver.name = "pixel-scanout",
+	.driver.suppress_bind_attrs = true,
+};
+static int __init pixel_init(void)
+{
+	struct platform_device *pdev;
+	int ret;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return -ENODEV;
+	ret = platform_driver_register(&pixel_platform_driver);
+	if (ret)
+		return ret;
+	pdev = platform_device_register_simple("pixel-scanout", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		platform_driver_unregister(&pixel_platform_driver);
+		return PTR_ERR(pdev);
+	}
+	return 0;
+}
+module_init(pixel_init);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("Pixel native DMA scanout with retained panel mode");
