diff --git c/Documentation/devicetree/bindings/clock/google,gs201-cmu-apm.yaml i/Documentation/devicetree/bindings/clock/google,gs201-cmu-apm.yaml
new file mode 100644
index 000000000..25dd6acf5
--- /dev/null
+++ i/Documentation/devicetree/bindings/clock/google,gs201-cmu-apm.yaml
@@ -0,0 +1,55 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/google,gs201-cmu-apm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google GS201 APM clock controller
+
+maintainers:
+  - Tudor Ambarus <tudor.ambarus@linaro.org>
+
+description: |
+  CMU_APM contains the clock selectors and gates supplying the ACPM mailbox.
+  The initial implementation exposes this path and the firmware-owned ALIVE
+  PLL's nominal fixed outputs. Selectors are read-only; PLL programming is
+  reserved to firmware. Clock identifiers are in dt-bindings/clock/google,gs201.h.
+
+properties:
+  compatible:
+    const: google,gs201-cmu-apm
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: Board oscillator clock
+      - description: External pad clock
+
+  clock-names:
+    items:
+      - const: oscclk
+      - const: padclk
+
+  '#clock-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - '#clock-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@18000000 {
+        compatible = "google,gs201-cmu-apm";
+        reg = <0x18000000 0x8000>;
+        clocks = <&oscclk>, <&padclk>;
+        clock-names = "oscclk", "padclk";
+        #clock-cells = <1>;
+    };
