diff --git c/arch/arm64/kernel/pixel_acpm.c i/arch/arm64/kernel/pixel_acpm.c
new file mode 100644
index 000000000..daa2a0186
--- /dev/null
+++ i/arch/arm64/kernel/pixel_acpm.c
@@ -0,0 +1,301 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM-only test glue for proper GS201 CCF/mailbox/ACPM drivers.
+ * No automatic activation: inspect first, then explicitly write activate=1.
+ * Queries are available after activation. CPU governors require a separate,
+ * guarded opt-in and are limited by the board test OPP tables.
+ */
+#include <linux/cpu.h>
+#include <linux/device.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/io.h>
+#include <linux/libfdt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/slab.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+#include "pixel_acpm_overlay.h"
+
+#define SRAM_BASE 0x18500000
+#define SRAM_SIZE 0x48000
+static int overlay_id;
+static bool activated;
+static struct device *query_dev;
+static struct acpm_handle *handle;
+
+static bool sram_range(u32 offset, u32 length)
+{
+	return !(offset & 3) && offset <= SRAM_SIZE && length <= SRAM_SIZE - offset;
+}
+
+static int inspect_handoff(void)
+{
+	struct device_node *np;
+	struct resource res;
+	void __iomem *sram, *cmu;
+	u32 table, count, i;
+	int ret;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return -ENODEV;
+	np = of_find_node_by_path("/acpm_ipc");
+	if (!np)
+		return -ENODEV;
+	ret = of_address_to_resource(np, 1, &res);
+	of_node_put(np);
+	if (ret || res.start != SRAM_BASE || resource_size(&res) != SRAM_SIZE)
+		return -EINVAL;
+	sram = ioremap(SRAM_BASE, SRAM_SIZE);
+	if (!sram)
+		return -ENOMEM;
+	table = readl(sram + 0xa008);
+	count = readl(sram + 0xa018);
+	pr_info("Pixel ACPM: AP channels=%u table=%#x\n", count, table);
+	ret = -EINVAL;
+	if (!count || count > 16 || !sram_range(table, count * 72))
+		goto out;
+	for (i = 0; i < count; i++) {
+		void __iomem *ch = sram + table + i * 72;
+		u32 id = readl(ch), type = readl(ch + 12), qlen = readl(ch + 52);
+		u32 mlen = readl(ch + 56), poll = readl(ch + 68);
+		u32 ptrs[] = { 16, 20, 40, 44 };
+		u32 queues[] = { 24, 48 };
+		unsigned int j;
+
+		pr_info("Pixel ACPM: channel %u id=%u type=%u qlen=%u mlen=%u poll=%u\n",
+			i, id, type, qlen, mlen, poll);
+		if (id != i || (type != 1 && type != 2))
+			goto out;
+		/*
+		 * Register/buffer channels use a different transport and may contain
+		 * firmware-local addresses. The ACPM driver must skip them entirely.
+		 */
+		if (type == 2)
+			continue;
+		if (qlen < 2 || qlen > 1024 || !mlen ||
+		    mlen > 256 || (mlen & 3) || poll > 1)
+			goto out;
+		for (j = 0; j < ARRAY_SIZE(ptrs); j++) {
+			u32 off = readl(ch + ptrs[j]);
+
+			if (!sram_range(off, 4) ||
+			    (qlen > 1 && readl(sram + off) >= qlen))
+				goto out;
+		}
+		for (j = 0; j < ARRAY_SIZE(queues); j++)
+			if (!sram_range(readl(ch + queues[j]), qlen * mlen))
+				goto out;
+		if (!i && (!poll || mlen != 16 || qlen < 2))
+			goto out;
+	}
+	ret = 0;
+out:
+	iounmap(sram);
+	if (ret)
+		return ret;
+	cmu = ioremap(0x18000000, 0x8000);
+	if (!cmu)
+		return -ENOMEM;
+	pr_info("Pixel ACPM: CMU func=%08x source=%08x gate=%08x mailbox=%08x\n",
+		readl(cmu + 0x1000), readl(cmu + 0x1004),
+		readl(cmu + 0x2084), readl(cmu + 0x20d4));
+	iounmap(cmu);
+	return 0;
+}
+
+static int inspect_set(const char *val, const struct kernel_param *kp)
+{
+	if (!sysfs_streq(val, "1"))
+		return -EINVAL;
+	return inspect_handoff();
+}
+
+static int activate_set(const char *val, const struct kernel_param *kp)
+{
+	struct device_node *osc, *pad, *gic, *np;
+	void *blob;
+	fdt32_t clocks[2];
+	int off, ret;
+
+	if (!sysfs_streq(val, "1") || activated)
+		return -EINVAL;
+	ret = inspect_handoff();
+	if (ret)
+		return ret;
+	osc = of_find_node_by_path("/ext_24_5m");
+	pad = of_find_node_by_path("/ext_100m");
+	gic = of_find_compatible_node(NULL, NULL, "arm,gic-v3");
+	if (!osc || !pad || !gic || !osc->phandle || !pad->phandle || !gic->phandle) {
+		ret = -EINVAL;
+		goto put_nodes;
+	}
+	blob = kmemdup(pixel_acpm_overlay, sizeof(pixel_acpm_overlay), GFP_KERNEL);
+	if (!blob) {
+		ret = -ENOMEM;
+		goto put_nodes;
+	}
+	clocks[0] = cpu_to_fdt32(osc->phandle);
+	clocks[1] = cpu_to_fdt32(pad->phandle);
+	off = fdt_path_offset(blob, "/fragment@1/__overlay__/clock-controller@18000000");
+	ret = fdt_setprop_inplace(blob, off, "clocks", clocks, sizeof(clocks));
+	if (!ret) {
+		off = fdt_path_offset(blob, "/fragment@1/__overlay__/mailbox@18210000");
+		ret = fdt_setprop_inplace_u32(blob, off, "interrupt-parent", gic->phandle);
+	}
+	if (!ret) {
+		static const char * const zones[] = { "big", "mid", "little" };
+		static const unsigned int cpus[] = { 6, 4, 0 };
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(zones); i++) {
+			struct device_node *cpu = of_get_cpu_node(cpus[i], NULL);
+			fdt32_t map[3];
+			char path[96];
+
+			if (!cpu || !cpu->phandle) {
+				of_node_put(cpu);
+				ret = -EINVAL;
+				break;
+			}
+			map[0] = cpu_to_fdt32(cpu->phandle);
+			map[1] = cpu_to_fdt32(0);
+			map[2] = cpu_to_fdt32(U32_MAX);
+			of_node_put(cpu);
+			snprintf(path, sizeof(path),
+				 "/fragment@2/__overlay__/pixel-%s/cooling-maps/map", zones[i]);
+			off = fdt_path_offset(blob, path);
+			ret = fdt_setprop_inplace(blob, off, "cooling-device", map, sizeof(map));
+			if (ret)
+				break;
+		}
+	}
+	if (!ret)
+		ret = of_overlay_fdt_apply(blob, sizeof(pixel_acpm_overlay), &overlay_id, NULL);
+	kfree(blob);
+	if (ret)
+		goto put_nodes;
+	activated = true;
+	pr_info("Pixel ACPM: overlay %d applied; cpufreq requires separate opt-in\n", overlay_id);
+	query_dev = root_device_register("pixel-acpm-query");
+	if (IS_ERR(query_dev)) {
+		ret = PTR_ERR(query_dev);
+		query_dev = NULL;
+		goto put_nodes;
+	}
+	np = of_find_node_by_path("/power-management");
+	handle = devm_acpm_get_by_node(query_dev, np);
+	of_node_put(np);
+	if (IS_ERR(handle)) {
+		ret = PTR_ERR(handle);
+		handle = NULL;
+		pr_err("Pixel ACPM: firmware driver not ready: %d\n", ret);
+	}
+put_nodes:
+	of_node_put(osc);
+	of_node_put(pad);
+	of_node_put(gic);
+	return ret;
+}
+
+static int query_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int id;
+	unsigned long rate;
+	int ret = kstrtouint(val, 0, &id);
+
+	if (ret)
+		return ret;
+	if (!handle)
+		return -ENODEV;
+	if (id > 13)
+		return -EINVAL;
+	rate = handle->ops->dvfs.get_rate(handle, 0, id);
+	pr_info("Pixel ACPM: frequency query id=%u rate=%lu Hz\n", id, rate);
+	return rate ? 0 : -EIO;
+}
+
+static int temperature_set(const char *val, const struct kernel_param *kp)
+{
+	static const char * const names[] = {
+		"BIG", "MID", "LITTLE", "G3D", "ISP", "TPU", "AUR",
+	};
+	unsigned int id;
+	int temp, ret = kstrtouint(val, 0, &id);
+
+	if (ret)
+		return ret;
+	if (!handle)
+		return -ENODEV;
+	if (id >= ARRAY_SIZE(names))
+		return -EINVAL;
+	/* Stock GS201 DT selects channel 9 and zone IDs 0..6. */
+	ret = handle->ops->tmu.read_temp(handle, 9, id, &temp);
+	if (ret) {
+		pr_err("Pixel ACPM: temperature query %s failed: %d\n", names[id], ret);
+		return ret;
+	}
+	pr_info("Pixel ACPM: temperature query id=%u %s=%d C\n", id, names[id], temp);
+	return 0;
+}
+
+static int cpufreq_set(const char *val, const struct kernel_param *kp)
+{
+	static const char * const zones[] = {
+		"pixel-big", "pixel-mid", "pixel-little", "pixel-g3d",
+		"pixel-isp", "pixel-tpu", "pixel-aur",
+	};
+	static const unsigned long boot_rates[] = { 1197000000, 1197000000, 1106000000 };
+	static struct platform_device *pdev;
+	struct thermal_zone_device *tz;
+	unsigned int i;
+	int temp, ret;
+
+	if (!sysfs_streq(val, "1") || pdev)
+		return -EINVAL;
+	if (!handle || num_online_cpus() != 8)
+		return -ENODEV;
+	/* Require live thermal zones and fresh, plausible firmware temperatures. */
+	for (i = 0; i < ARRAY_SIZE(zones); i++) {
+		tz = thermal_zone_get_zone_by_name(zones[i]);
+		if (IS_ERR(tz))
+			return PTR_ERR(tz);
+		ret = handle->ops->tmu.read_temp(handle, 9, i, &temp);
+		if (ret)
+			return ret;
+		if (temp < 5 || temp >= 60)
+			return -ERANGE;
+	}
+	/* Never bootstrap a governor from an unexpected firmware clock state.
+	 * A normal (not fastboot) boot leaves the little cluster at 1598 MHz,
+	 * above its bounded table; cpufreq moves an unlisted initial rate to a
+	 * table rate as it starts, so that state is accepted too.
+	 */
+	for (i = 0; i < ARRAY_SIZE(boot_rates); i++) {
+		unsigned long rate = handle->ops->dvfs.get_rate(handle, 0, i + 2);
+
+		if (rate != boot_rates[i] && !(i == 0 && rate == 1598000000))
+			return -ERANGE;
+	}
+	pdev = platform_device_register_simple("cpufreq-dt", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		ret = PTR_ERR(pdev);
+		pdev = NULL;
+		return ret;
+	}
+	pr_info("Pixel ACPM: cpufreq-dt requested with bounded OPPs and thermal cooling\n");
+	return 0;
+}
+
+static const struct kernel_param_ops inspect_ops = { .set = inspect_set };
