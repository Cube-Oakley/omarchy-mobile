diff --git c/drivers/pmdomain/samsung/gs201-g3d-pd.c i/drivers/pmdomain/samsung/gs201-g3d-pd.c
new file mode 100644
index 000000000..03f71f34e
--- /dev/null
+++ i/drivers/pmdomain/samsung/gs201-g3d-pd.c
@@ -0,0 +1,262 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GS201 GPU domains: firmware-mediated PMU writes and CMU/TZPC retention. */
+#include <linux/arm-smccc.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/pm_domain.h>
+
+#define GS201_PMU_BASE 0x18061e00
+#define GS201_SMC_PRIV_REG 0x82000504
+#define GS201_SMC_PD_CONTEXT 0x82000410
+#define GS201_G3D_TZPC 0x27f10204
+
+struct gs201_g3d;
+struct gs201_domain {
+	struct generic_pm_domain genpd;
+	struct gs201_g3d *ctrl;
+	u32 offset;
+};
+
+/* Ordered SAVE_RESTORE entries from Google's flexpmu_cal_local_gs201.h. */
+static const struct {
+	u8 region;
+	u16 offset;
+} gs201_g3d_saved_regs[] = {
+	{ 0, 0x1800 },
+	{ 0, 0x1804 },
+	{ 0, 0x1808 },
+	{ 0, 0x180c },
+	{ 0, 0x1810 },
+	{ 0, 0x1814 },
+	{ 0, 0x1000 },
+	{ 0, 0x1004 },
+	{ 0, 0x1008 },
+	{ 0, 0x0004 },
+	{ 0, 0x0008 },
+	{ 0, 0x0104 },
+	{ 0, 0x0144 },
+	{ 0, 0x0108 },
+	{ 0, 0x0148 },
+	{ 0, 0x010c },
+	{ 0, 0x014c },
+	{ 0, 0x0100 },
+	{ 0, 0x0140 },
+	{ 0, 0x0600 },
+	{ 0, 0x0610 },
+	{ 0, 0x0620 },
+	{ 0, 0x0630 },
+	{ 0, 0x0640 },
+	{ 0, 0x0650 },
+	{ 0, 0x302c },
+	{ 0, 0x3030 },
+	{ 0, 0x3034 },
+	{ 0, 0x3038 },
+	{ 0, 0x303c },
+	{ 0, 0x3040 },
+	{ 0, 0x3044 },
+	{ 0, 0x3048 },
+	{ 0, 0x304c },
+	{ 0, 0x3050 },
+	{ 0, 0x3054 },
+	{ 0, 0x3058 },
+	{ 0, 0x305c },
+	{ 0, 0x3060 },
+	{ 0, 0x3064 },
+	{ 0, 0x3068 },
+	{ 0, 0x306c },
+	{ 0, 0x3070 },
+	{ 0, 0x3074 },
+	{ 0, 0x0800 },
+	{ 0, 0x0804 },
+	{ 1, 0x0104 },
+	{ 1, 0x0108 },
+};
+
+struct gs201_g3d {
+	struct device *dev;
+	void __iomem *pmu;
+	void __iomem *regs[2];
+	struct gs201_domain pd[2];
+	struct generic_pm_domain *domains[2];
+	struct genpd_onecell_data data;
+	u32 saved[ARRAY_SIZE(gs201_g3d_saved_regs)];
+	bool saved_valid;
+	bool protection_enabled;
+};
+
+static int gs201_pd_context(bool restore)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(GS201_SMC_PD_CONTEXT, restore, GS201_G3D_TZPC,
+		      2, 0, 0, 0, 0, &res);
+	if (res.a0)
+		pr_err("GS201 GPU: secure context %s failed: %#lx\n",
+		       restore ? "restore" : "save", res.a0);
+	return res.a0 ? -EIO : 0;
+}
+
+static int gs201_gpu_protection(struct gs201_g3d *ctrl, bool enable)
+{
+	struct arm_smccc_res res;
+
+	if (ctrl->protection_enabled == enable)
+		return 0;
+	/* Google's GS201 GPU power callback: SMC_PROTECTION_SET, PROT_G3D. */
+	arm_smccc_smc(0x82002010, 0, 12, enable, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(ctrl->dev, "GPU security configuration failed: %#lx\n", res.a0);
+		return -EACCES;
+	}
+	ctrl->protection_enabled = enable;
+	return 0;
+}
+
+static int gs201_pd_set(struct gs201_domain *pd, bool on)
+{
+	struct gs201_g3d *ctrl = pd->ctrl;
+	struct arm_smccc_res res;
+	u32 value = readl(ctrl->pmu + pd->offset);
+	int ret;
+
+	value = (value & ~BIT(0)) | on;
+	arm_smccc_smc(GS201_SMC_PRIV_REG, GS201_PMU_BASE + pd->offset,
+		      1, value, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return dev_err_probe(ctrl->dev, -EACCES, "Secure PMU write failed: %#lx\n",
+				     res.a0);
+	ret = readl_poll_timeout(ctrl->pmu + pd->offset + 4, value,
+				!!(value & BIT(0)) == on, 10, 100000);
+	if (ret)
+		dev_err(ctrl->dev, "%s transition to %u timed out\n", pd->genpd.name, on);
+	return ret;
+}
+
+static int gs201_pd_on(struct generic_pm_domain *genpd)
+{
+	struct gs201_domain *pd = container_of(genpd, struct gs201_domain, genpd);
+	struct gs201_g3d *ctrl = pd->ctrl;
+	unsigned int i;
+	int ret;
+
+	ret = gs201_pd_set(pd, true);
+	if (ret)
+		return ret;
+	if (pd->offset)
+		return gs201_gpu_protection(ctrl, true);
+	ret = gs201_pd_context(true);
+	if (ret)
+		return ret;
+	if (ctrl->saved_valid) {
+		for (i = 0; i < ARRAY_SIZE(gs201_g3d_saved_regs); i++)
+			writel(ctrl->saved[i], ctrl->regs[gs201_g3d_saved_regs[i].region] +
+			       gs201_g3d_saved_regs[i].offset);
+		ctrl->saved_valid = false;
+	}
+	dev_dbg(ctrl->dev, "GPU top domain restored\n");
+	return 0;
+}
+
+static int gs201_pd_off(struct generic_pm_domain *genpd)
+{
+	struct gs201_domain *pd = container_of(genpd, struct gs201_domain, genpd);
+	struct gs201_g3d *ctrl = pd->ctrl;
+	unsigned int i;
+	u32 option;
+	int ret;
+
+	if (!pd->offset) {
+		ret = gs201_gpu_protection(ctrl, false);
+		if (ret)
+			return ret;
+		for (i = 0; i < ARRAY_SIZE(gs201_g3d_saved_regs); i++)
+			ctrl->saved[i] = readl(ctrl->regs[gs201_g3d_saved_regs[i].region] +
+					      gs201_g3d_saved_regs[i].offset);
+		ctrl->saved_valid = true;
+		ret = gs201_pd_context(false);
+		if (ret)
+			return ret;
+		option = readl(ctrl->regs[0] + 0x800);
+		writel(option & ~BIT(24), ctrl->regs[0] + 0x800);
+	}
+	ret = gs201_pd_set(pd, false);
+	if (!ret)
+		dev_dbg(ctrl->dev, "%s powered off\n", genpd->name);
+	return ret;
+}
+
+static int gs201_g3d_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = { "gs201-g3d-top", "gs201-g3d-cores" };
+	struct device *dev = &pdev->dev;
+	struct gs201_g3d *ctrl;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
+	ctrl = devm_kzalloc(dev, sizeof(*ctrl), GFP_KERNEL);
+	if (!ctrl)
+		return -ENOMEM;
+	ctrl->dev = dev;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != GS201_PMU_BASE || resource_size(res) != 0x208)
+		return -EINVAL;
+	ctrl->pmu = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ctrl->pmu))
+		return PTR_ERR(ctrl->pmu);
+	for (i = 0; i < 2; i++) {
+		ctrl->regs[i] = devm_platform_ioremap_resource(pdev, i + 1);
+		if (IS_ERR(ctrl->regs[i]))
+			return PTR_ERR(ctrl->regs[i]);
+	}
+	for (i = 0; i < 2; i++) {
+		struct gs201_domain *pd = &ctrl->pd[i];
+
+		pd->ctrl = ctrl;
+		pd->offset = i * 0x200;
+		pd->genpd.name = names[i];
+		pd->genpd.power_on = gs201_pd_on;
+		pd->genpd.power_off = gs201_pd_off;
+		ctrl->domains[i] = &pd->genpd;
+		ret = pm_genpd_init(&pd->genpd, NULL,
+				    !(readl(ctrl->pmu + pd->offset + 4) & BIT(0)));
+		if (ret)
+			goto remove_domains;
+	}
+	ret = pm_genpd_add_subdomain(ctrl->domains[0], ctrl->domains[1]);
+	if (ret)
+		goto remove_domains;
+	ctrl->data.domains = ctrl->domains;
+	ctrl->data.num_domains = ARRAY_SIZE(ctrl->domains);
+	ret = of_genpd_add_provider_onecell(dev->of_node, &ctrl->data);
+	if (ret) {
+		pm_genpd_remove_subdomain(ctrl->domains[0], ctrl->domains[1]);
+		goto remove_domains;
+	}
+	dev_info(dev, "GPU domains registered: top=%u cores=%u\n",
+		 readl(ctrl->pmu + 4) & 1, readl(ctrl->pmu + 0x204) & 1);
+	return 0;
+remove_domains:
+	while (i--)
+		pm_genpd_remove(ctrl->domains[i]);
+	return ret;
+}
+
+static const struct of_device_id gs201_g3d_match[] = {
+	{ .compatible = "google,gs201-g3d-pmu" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gs201_g3d_match);
+
+static struct platform_driver gs201_g3d_driver = {
+	.probe = gs201_g3d_probe,
+	.driver = {
+		.name = "gs201-g3d-pd",
+		.of_match_table = gs201_g3d_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(gs201_g3d_driver);
