--- /dev/null
+++ i/arch/arm64/kernel/pixel_usb.c
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GS201 USB device mode. No persistent DT or partition changes.
+ *
+ * After fastboot, ABL leaves the USB2 PHY powered and configured. After a
+ * normal boot it is isolated in the PMU and its controller block is at reset
+ * defaults, so no gadget ever reaches the host. pixel_usb_phy_init() then
+ * brings the PHY up the way Google's GS201 driver does (google-modules/soc/gs
+ * drivers/phy/samsung, phy-exynos-usbdrd.c exynos_usbdrd_utmi_init and
+ * phy-exynos-usb3p1.c phy_exynos_usb_v3p1_enable, phy_version 0x301), ending
+ * in the state a fastboot handoff leaves (read from a working RAM boot).
+ */
+#include <linux/arm-smccc.h>
+#include <linux/delay.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kstrtox.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/printk.h>
+
+static bool pixel_usb_bind;
+static int __init pixel_usb_arg(char *s)
+{
+	return !kstrtobool(s, &pixel_usb_bind);
+}
+__setup("pixel_usb=", pixel_usb_arg);
+
+/* Stock DT: exynos-pmu 0x18060000, pmu_offset 0x3eb0 / pmu_offset_dp 0x3eb4
+ * with pmu_mask 0 (BIT(0)); phy@11200000 is the USB PHY controller.
+ */
+#define GS201_PMU_USB		0x18063eb0UL
+#define GS201_SMC_PRIV_REG	0x82000504
+#define GS201_USBCON		0x11200000UL
+
+#define USBCON_LINK_CTRL	0x04
+#define  LINKCTRL_PIPE3_FORCE_RX_ELEC_IDLE	BIT(18)
+#define  LINKCTRL_PIPE3_FORCE_PHY_STATUS	BIT(17)
+#define  LINKCTRL_PIPE3_FORCE_EN		BIT(16)
+#define  LINKCTRL_DIS_QACT_LINKGATE		BIT(12)
+#define  LINKCTRL_DIS_QACT_ID0			BIT(11)
+#define  LINKCTRL_DIS_QACT_VBUS_VALID		BIT(10)
+#define  LINKCTRL_DIS_QACT_BVALID		BIT(9)
+#define  LINKCTRL_FORCE_QACT			BIT(8)
+#define  LINKCTRL_BUS_FILTER_BYPASS		(0xf << 4)
+#define USBCON_LINK_PORT	0x08
+#define  LINKPORT_SEL_OCD_U3			BIT(3)
+#define  LINKPORT_SEL_OCD_U2			BIT(2)
+#define USBCON_CLKRST		0x20
+#define  CLKRST_PHY20_SW_RST			BIT(13)
+#define  CLKRST_PHY20_RST_SEL			BIT(12)
+#define  CLKRST_LINK_PCLK_SEL			BIT(7)
+#define  CLKRST_PHY30_SW_RST			BIT(3)
+#define  CLKRST_PHY30_RST_SEL			BIT(2)
+#define  CLKRST_PORT_RST			BIT(1)
+#define  CLKRST_LINK_SW_RST			BIT(0)
+#define USBCON_SSP_PLL		0x30
+#define  SSP_PLL_FSEL_MASK			0x3f
+#define USBCON_COMBO_PMA_CTRL	0x48
+#define  PMA_LOW_PWR				BIT(4)
+#define USBCON_UTMI		0x50
+#define  UTMI_FORCE_VBUSVALID			BIT(5)
+#define  UTMI_FORCE_BVALID			BIT(4)
+#define  UTMI_DP_PULLDOWN			BIT(3)
+#define  UTMI_DM_PULLDOWN			BIT(2)
+#define  UTMI_FORCE_SUSPEND			BIT(1)
+#define  UTMI_FORCE_SLEEP			BIT(0)
+#define USBCON_HSP		0x54
+#define  HSP_VBUSVLDEXTSEL			BIT(13)
+#define  HSP_VBUSVLDEXT				BIT(12)
+#define  HSP_EN_UTMISUSPEND			BIT(9)
+#define  HSP_COMMONONN				BIT(8)
+#define USBCON_HSP_TUNE		0x58
+/* The HS tuning ABL programs on cheetah (from the DT hs_tune_param). */
+#define  HSP_TUNE_CHEETAH			0x736f3537
+#define USBCON_HSP_TEST		0x5c
+#define  HSP_TEST_SIDDQ				BIT(24)
+
+/* Set bit 0 of a secure PMU register (reads are open, writes go to EL3). */
+static int __init pixel_usb_pmu_set(void __iomem *va, unsigned long pa)
+{
+	struct arm_smccc_res res;
+	u32 value = readl(va);
+
+	if (value & BIT(0))
+		return 0;
+	arm_smccc_smc(GS201_SMC_PRIV_REG, pa, 1, value | BIT(0), 0, 0, 0, 0, &res);
+	if (res.a0 || !(readl(va) & BIT(0))) {
+		pr_err("Pixel USB: PMU %#lx write failed: %#lx\n", pa, res.a0);
+		return -EACCES;
+	}
+	return 0;
+}
+
+static void __init usbcon_update(void __iomem *con, u32 reg, u32 clear, u32 set)
+{
+	writel((readl(con + reg) & ~clear) | set, con + reg);
+}
+
+static int __init pixel_usb_phy_init(void)
+{
+	void __iomem *pmu, *con;
+	int ret = 0;
+
+	pmu = ioremap(GS201_PMU_USB & PAGE_MASK, PAGE_SIZE);
+	con = ioremap(GS201_USBCON, 0x200);
+	if (!pmu || !con) {
+		ret = -ENOMEM;
+		goto out;
+	}
+	if (readl(pmu + (GS201_PMU_USB & ~PAGE_MASK)) & BIT(0)) {
+		pr_info("Pixel USB: PHY already running (fastboot handoff)\n");
+		goto out;
+	}
+	pr_info("Pixel USB: PHY isolated (normal boot); bringing it up\n");
+
+	/* Link reset, as exynos_usbdrd_utmi_init starts. */
+	usbcon_update(con, USBCON_CLKRST, 0, CLKRST_LINK_SW_RST);
+	udelay(10);
+	usbcon_update(con, USBCON_CLKRST, CLKRST_LINK_SW_RST, 0);
+
+	/* Out of isolation: USB PHY and the USB/DP combo PHY. */
+	ret = pixel_usb_pmu_set(pmu + (GS201_PMU_USB & ~PAGE_MASK), GS201_PMU_USB);
+	if (!ret)
+		ret = pixel_usb_pmu_set(pmu + ((GS201_PMU_USB + 4) & ~PAGE_MASK), GS201_PMU_USB + 4);
+	if (ret)
+		goto out;
+
+	/* Q-channel workaround: no q-active from USB, then force it. */
+	usbcon_update(con, USBCON_LINK_CTRL, LINKCTRL_FORCE_QACT,
+		      LINKCTRL_DIS_QACT_ID0 | LINKCTRL_DIS_QACT_VBUS_VALID |
+		      LINKCTRL_DIS_QACT_BVALID | LINKCTRL_DIS_QACT_LINKGATE);
+	usleep_range(500, 600);
+	usbcon_update(con, USBCON_LINK_CTRL, 0, LINKCTRL_FORCE_QACT);
+
+	/* PHY POR high. */
+	usbcon_update(con, USBCON_CLKRST, 0, CLKRST_PHY20_SW_RST | CLKRST_PHY20_RST_SEL |
+		      CLKRST_PHY30_SW_RST | CLKRST_PHY30_RST_SEL);
+	usbcon_update(con, USBCON_UTMI, UTMI_FORCE_SUSPEND | UTMI_FORCE_SLEEP |
+		      UTMI_DP_PULLDOWN | UTMI_DM_PULLDOWN, 0);
+	/* ABL keeps the common block on (COMMONONN clear). It also selects
+	 * the PIPE3 clock for the link (CLKRST_LINK_PCLK_SEL), but only because
+	 * it brings up the SuperSpeed combo PHY that supplies it; here, as in
+	 * Google's HS-only path, the link keeps its default clock or it has none
+	 * ("failed to enable ep0out").
+	 */
+	usbcon_update(con, USBCON_HSP, HSP_COMMONONN, HSP_EN_UTMISUSPEND);
+	usbcon_update(con, USBCON_CLKRST, CLKRST_LINK_PCLK_SEL, 0);
+	usleep_range(100, 120);
+
+	/* VBUS is not routed to this block (is_not_vbus_pad): force valid. */
+	usbcon_update(con, USBCON_LINK_CTRL, 0, LINKCTRL_BUS_FILTER_BYPASS);
+	usbcon_update(con, USBCON_UTMI, 0, UTMI_FORCE_BVALID | UTMI_FORCE_VBUSVALID);
+	usbcon_update(con, USBCON_HSP, 0, HSP_VBUSVLDEXTSEL | HSP_VBUSVLDEXT);
+	writel(HSP_TUNE_CHEETAH, con + USBCON_HSP_TUNE);
+	/* 19.2 MHz reference clock (phy_ref_clock). */
+	usbcon_update(con, USBCON_SSP_PLL, SSP_PLL_FSEL_MASK, 0);
+
+	/* HS PHY power, then POR low; PHYCLOCK is valid 75 us later. */
+	usbcon_update(con, USBCON_HSP_TEST, HSP_TEST_SIDDQ, 0);
+	udelay(15);
+	usbcon_update(con, USBCON_CLKRST, CLKRST_PHY20_SW_RST | CLKRST_PHY30_SW_RST |
+		      CLKRST_PORT_RST, CLKRST_PHY20_RST_SEL);
+	usleep_range(75, 90);
+
+	/* Over-current from the hub port (use_io_for_ovc = 0). */
+	usbcon_update(con, USBCON_LINK_PORT, 0, LINKPORT_SEL_OCD_U3 | LINKPORT_SEL_OCD_U2);
+	/* No SuperSpeed PHY: force the PIPE3 signals, park the combo PMA. */
+	usbcon_update(con, USBCON_LINK_CTRL, LINKCTRL_PIPE3_FORCE_PHY_STATUS,
+		      LINKCTRL_PIPE3_FORCE_EN | LINKCTRL_PIPE3_FORCE_RX_ELEC_IDLE);
+	usbcon_update(con, USBCON_COMBO_PMA_CTRL, 0, PMA_LOW_PWR);
+
+	pr_info("Pixel USB: PHY up: LINK_CTRL=%08x CLKRST=%08x UTMI=%08x HSP=%08x TUNE=%08x TEST=%08x\n",
+		readl(con + USBCON_LINK_CTRL), readl(con + USBCON_CLKRST), readl(con + USBCON_UTMI),
+		readl(con + USBCON_HSP), readl(con + USBCON_HSP_TUNE), readl(con + USBCON_HSP_TEST));
+out:
+	if (pmu)
+		iounmap(pmu);
+	if (con)
+		iounmap(con);
+	return ret;
+}
+
+static struct property pixel_usb_props[] = {
+	{ .name = "compatible", .value = "snps,dwc3", .length = sizeof("snps,dwc3") },
+	{ .name = "maximum-speed", .value = "high-speed", .length = sizeof("high-speed") },
+	{ .name = "snps,dis_u2_susphy_quirk" },
+	{ .name = "snps,dis_u3_susphy_quirk" },
+	{ .name = "snps,dis_enblslpm_quirk" },
+};
+
+static int __init pixel_usb_register(void)
+{
+	static const char * const remove[] = {
+		"clocks", "clock-names", "phys", "phy-names", "usb-psy-name",
+	};
+	struct device_node *np;
+	struct property *p;
+	struct resource res;
+	int ret = -ENODEV;
+
+	if (!pixel_usb_bind || !IS_ENABLED(CONFIG_USB_DWC3))
+		return 0;
+	ret = pixel_usb_phy_init();
+	if (ret)
+		return ret;
+	np = of_find_node_by_path("/usb@11210000/dwc3");
+	if (!np)
+		return -ENODEV;
+	if (of_address_to_resource(np, 0, &res) ||
+	    res.start != 0x11210000 || resource_size(&res) != 0x10000 ||
+	    of_node_check_flag(np, OF_POPULATED))
+		goto out;
+	/* ABL leaves this PHY running. Do not bind incompatible vendor providers. */
+	for (unsigned int i = 0; i < ARRAY_SIZE(remove); i++) {
+		p = of_find_property(np, remove[i], NULL);
+		if (p && of_remove_property(np, p))
+			goto out;
+	}
+	for (unsigned int i = 0; i < ARRAY_SIZE(pixel_usb_props); i++) {
+		ret = of_update_property(np, &pixel_usb_props[i]);
+		if (ret)
+			goto out;
+	}
+	pr_info("Pixel USB: registering DWC3 with inherited PHY, USB2 peripheral\n");
+	ret = of_platform_device_create(np, NULL, NULL) ? 0 : -ENODEV;
+	pr_info("Pixel USB: platform registration result=%d\n", ret);
+out:
+	of_node_put(np);
+	return ret;
+}
+
+static int __init pixel_usb_inspect(void)
+{
+	void __iomem *regs;
+	u32 id;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return 0;
+	pr_info("Pixel USB: inspecting inherited DWC3 at 11210000\n");
+	regs = ioremap(0x11210000, 0x10000);
+	if (!regs)
+		return -ENOMEM;
+	id = readl(regs + 0xc120);
+	pr_info("Pixel USB: GSNPSID=%08x\n", id);
+	if ((id >> 16) == 0x5533 || (id >> 16) == 0x3331 ||
+	    (id >> 16) == 0x3332) {
+		pr_info("Pixel USB: GCTL=%08x GSTS=%08x GHWPARAMS0=%08x\n",
+			readl(regs + 0xc110), readl(regs + 0xc118),
+			readl(regs + 0xc140));
+		pr_info("Pixel USB: PHYCFG=%08x PIPE=%08x DCTL=%08x DSTS=%08x\n",
+			readl(regs + 0xc200), readl(regs + 0xc2c0),
+			readl(regs + 0xc704), readl(regs + 0xc70c));
+	}
+	iounmap(regs);
+	if ((id >> 16) != 0x3331)
+		return -ENODEV;
+	return pixel_usb_register();
+}
+late_initcall(pixel_usb_inspect);
diff --git c/arch/arm64/kernel/pixel_watchdog.c i/arch/arm64/kernel/pixel_watchdog.c
new file mode 100644
index 000000000..ea74d3165
--- /dev/null
+++ i/arch/arm64/kernel/pixel_watchdog.c
@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Stop inherited ABL AP watchdogs until the GS201 watchdog driver is ported.
+ * Same WTCON read/clear/write/read sequence as this phone's ABL wdt_stop().
+ * This affects only the current RAM boot, not firmware or PMIC settings.
+ */
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/printk.h>
+
+static int __init pixel_watchdog_stop(void)
+{
+	static const char * const compat[] = {
+		"google,gs201-cl0-wdt", "google,gs201-cl1-wdt",
+	};
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return 0;
+	for (unsigned int i = 0; i < ARRAY_SIZE(compat); i++) {
+		struct device_node *np;
+		struct resource res;
+		void __iomem *regs;
+		u32 before, after;
+		int ret;
+
+		np = of_find_compatible_node(NULL, NULL, compat[i]);
+		if (!np)
+			return -ENODEV;
+		ret = of_address_to_resource(np, 0, &res);
+		of_node_put(np);
+		if (ret || res.start != 0x10060000 + i * 0x10000 ||
+		    resource_size(&res) != 0x100)
+			return -EINVAL;
+		regs = ioremap(res.start, resource_size(&res));
+		if (!regs)
+			return -ENOMEM;
+		before = readl(regs);
+		/* WTCON enable bit 5, reset-enable bit 0. Preserve all other bits. */
+		writel(before & ~0x21U, regs);
+		after = readl(regs);
+		pr_info("Pixel WDT%u: inherited WTCON=%08x stopped=%08x count=%08x\n",
+			i, before, after, readl(regs + 8));
+		iounmap(regs);
+		if (after & 0x21)
+			return -EIO;
+	}
+	return 0;
+}
+subsys_initcall(pixel_watchdog_stop);
