+void pixel_link_destroy(struct link_device *ld)
+{
+	struct mem_link_device *mld = to_mem_link_device(ld);
+	struct modem_data *modem = ld->mdm_data;
+
+	/* Only pre-boot probe failure. No PCI device/MSI or running CP exists. */
+	pixel_pktproc_ul_destroy(mld);
+	pixel_pktproc_destroy(mld);
+	if (ld->rx_wq)
+		destroy_workqueue(ld->rx_wq);
 	if (mld->dummy_net) {
 		napi_disable(&mld->mld_napi);
 		netif_napi_del(&mld->mld_napi);
 		free_netdev(mld->dummy_net);
 	}
+	pixel_legacy_destroy(mld);
+	if (mld->base) {
+		if (modem->legacy_raw_rx_buffer_cached)
+			vunmap(mld->base);
+		else
+			cp_shmem_release_region(modem->cp_num, SHMEM_IPC);
+	}
+#if IS_ENABLED(CONFIG_MODEM_IF_LEGACY_QOS)
+	if (mld->hiprio_base)
+		vunmap(mld->hiprio_base);
+#endif
+	modem->mld = NULL;
 	kfree(mld);
-	mif_err("xxx\n");
-	return NULL;
