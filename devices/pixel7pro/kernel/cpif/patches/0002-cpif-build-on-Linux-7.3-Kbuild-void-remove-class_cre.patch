diff --git a/cpif/Kbuild b/cpif/Kbuild
new file mode 100644
index 0000000..a56a8db
--- /dev/null
+++ b/cpif/Kbuild
@@ -0,0 +1,25 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Google's cpif (LineageOS gs201 lineage-21, CPIF-20220408R1) for the Pixel 7
+# Pro's Exynos Modem 5300 on PCIe channel 0, built out of tree on Linux 7.3.
+#
+# Configuration: the S5100/PCIe options of Google's cloudripper_gki.fragment
+# (and what they select), without the parts that need vendor-only
+# subsystems: PCIe IOMMU, TP monitor (PM QoS, BTS), CP thermal zone, SPI boot
+# device. See README.md.
+cpif-config := EXYNOS_MODEM_IF SEC_MODEM_S5100 LINK_DEVICE_PCIE SHM_IPC CPIF_PAGE_RECYCLING \
+	CP_PKTPROC CP_PKTPROC_UL LINK_DEVICE_PCIE_IOCC CH_EXTENSION MODEM_IF_QOS \
+	SUSPEND_DURING_VOICE_CALL
+ccflags-y += $(foreach c,$(cpif-config),-DCONFIG_$(c)=1)
+ccflags-y += -I$(src) -I$(src)/include -I$(src)/../stubs/include
+# As Google's Makefile; PROJECT_REGION is empty on the stock build ("cpif: +++ ()").
+ccflags-y += -DCPIF_WAKEPKT_SET_MARK=0x80000000 -DCONFIG_OPTION_REGION=\"\"
+
+obj-m += cpif_page.o shm_ipc.o cpif.o
+cpif-y := modem_main.o modem_variation.o
+cpif-y += modem_io_device.o net_io_device.o bootdump_io_device.o ipc_io_device.o modem_toe_device.o
+cpif-y += modem_utils.o modem_dump.o
+cpif-y += link_device.o link_device_memory_flow_control.o
+cpif-y += link_device_memory_debug.o modem_notifier.o
+cpif-y += link_device_memory_snapshot.o link_device_memory_legacy.o
+cpif-y += s51xx_pcie.o modem_ctrl_s5100.o modem_ctrl.o
+cpif-y += link_rx_pktproc.o link_tx_pktproc.o
