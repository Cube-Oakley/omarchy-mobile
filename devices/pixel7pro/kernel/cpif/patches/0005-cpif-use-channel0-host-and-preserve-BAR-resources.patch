From: Omarchy Mobile <noreply@example.com>
Subject: [PATCH] cpif: use tested channel-0 host and preserve its BAR resources

--- a/cpif/s51xx_pcie.h
+++ b/cpif/s51xx_pcie.h
@@ -13,11 +13,25 @@
 
 extern void first_save_s51xx_status(struct pci_dev *pdev);
 extern int s51xx_pcie_init(struct modem_ctl *mc);
-/*
- * Pixel 7 Pro port: the root-complex API (exynos_pcie_*, register_separated_msi_vector)
- * comes from a stand-in until a channel-0 host driver exports it.
- */
-#include <linux/exynos-pcie-rc-api.h>
+/* Implemented by the manually loaded pixel-pcie-cp host. */
+int exynos_pcie_poweron(int ch_num, int spd);
+int exynos_pcie_poweroff(int ch_num);
+int exynos_pcie_rc_chk_link_status(int ch_num);
+int exynos_pcie_rc_l1ss_ctrl(int enable, int id, int ch_num);
+void exynos_pcie_set_perst_gpio(int ch_num, bool on);
+int exynos_pcie_register_event(struct exynos_pcie_register_event *reg);
+int exynos_pcie_deregister_event(struct exynos_pcie_register_event *reg);
+int register_separated_msi_vector(int ch_num, irq_handler_t handler, void *context, int *irq_num);
+int exynos_pcie_rc_set_outbound_atu(int ch_num, u32 target_addr, u32 offset, u32 size);
+bool exynos_pcie_rc_get_cpl_timeout_state(int ch_num);
+void exynos_pcie_rc_set_cpl_timeout_state(int ch_num, bool recovery);
+bool exynos_pcie_rc_get_sudden_linkdown_state(int ch_num);
+void exynos_pcie_rc_set_sudden_linkdown_state(int ch_num, bool recovery);
+void exynos_pcie_set_ready_cto_recovery(int ch_num);
+void exynos_pcie_rc_force_linkdown_work(int ch_num);
+void exynos_pcie_rc_register_dump(int ch_num);
+void exynos_pcie_rc_dump_all_status(int ch_num);
+void exynos_pcie_rc_print_msi_register(int ch_num);
 
 struct s51xx_pcie {
 	unsigned int busdev_num;
--- a/stubs/include/linux/exynos-pcie-rc-api.h
+++ /dev/null
@@ -1,115 +0,0 @@
-/* SPDX-License-Identifier: GPL-2.0-only */
-/*
- * Stand-in for the API that Google's PCIe root-complex driver
- * (drivers/pci/controller/dwc/pcie-exynos-rc.c, exported to cpif) provides
- * for the modem on channel 0. Prototypes as cpif's s51xx_pcie.h declares
- * them.
- *
- * This kernel has no channel-0 host yet: the Wi-Fi host (pixel-pcie) drives
- * channel 1 only, and channel 0 needs its own configuration path (secure ATU
- * set up by EL3 through SMC 0x820020D8, no iATU writes from Linux, fixed MSI
- * page, x2 lanes, Gen1 for the ROM stage). Until a host driver exports these,
- * every call fails or reports "no link" without touching hardware, so cpif's
- * boot path stops at "CP EP driver initialization" with an error instead of
- * reaching the PCIe controller.
- *
- * To use a real host: delete this header, declare the functions extern
- * again in s51xx_pcie.h, and have the channel-0 host module export them.
- */
-#ifndef _PIXEL_STUB_EXYNOS_PCIE_RC_API_H
-#define _PIXEL_STUB_EXYNOS_PCIE_RC_API_H
-#include <linux/errno.h>
-#include <linux/interrupt.h>
-#include <linux/printk.h>
-#include <linux/types.h>
-#include <linux/exynos-pci-noti.h>
-
-#define PIXEL_PCIE_RC_STUB() pr_warn_ratelimited("cpif: %s: no PCIe channel-0 host driver\n", __func__)
-
-/* Link control: power the RC up and train the link (spd 1 = Gen1 for the ROM stage), or down. */
-static inline int exynos_pcie_poweron(int ch_num, int spd)
-{
-	PIXEL_PCIE_RC_STUB();
-	return -ENODEV;
-}
-
-static inline int exynos_pcie_poweroff(int ch_num)
-{
-	PIXEL_PCIE_RC_STUB();
-	return -ENODEV;
-}
-
-/* 0: link down. */
-static inline int exynos_pcie_rc_chk_link_status(int ch_num)
-{
-	return 0;
-}
-
-static inline int exynos_pcie_rc_l1ss_ctrl(int enable, int id, int ch_num)
-{
-	PIXEL_PCIE_RC_STUB();
-	return -ENODEV;
-}
-
-static inline void exynos_pcie_set_perst_gpio(int ch_num, bool on)
-{
-	PIXEL_PCIE_RC_STUB();
-}
-
-/* Link-down and completion-timeout notifications to cpif. */
-static inline int exynos_pcie_register_event(struct exynos_pcie_register_event *reg)
-{
-	PIXEL_PCIE_RC_STUB();
-	return -ENODEV;
-}
-
-static inline int exynos_pcie_deregister_event(struct exynos_pcie_register_event *reg)
-{
-	return -ENODEV;
-}
-
-/* Per-queue MSI vectors ("separated MSI"): DWC MSI blocks 1-4 for pktproc DL queues. */
-static inline int register_separated_msi_vector(int ch_num, irq_handler_t handler,
-						void *context, int *irq_num)
-{
-	PIXEL_PCIE_RC_STUB();
-	return -ENODEV;
-}
-
-/*
- * Outbound iATU window for CP BTL dumps. On channel 0 the iATU is EL3-owned;
- * a real host must refuse this too (cpif calls it only with CONFIG_CP_BTL).
- */
-static inline int exynos_pcie_rc_set_outbound_atu(int ch_num, u32 target_addr, u32 offset,
-						  u32 size)
-{
-	return -EOPNOTSUPP;
-}
-
-/* Recovery state kept by the RC driver: never set without a host. */
-static inline bool exynos_pcie_rc_get_cpl_timeout_state(int ch_num)
-{
-	return false;
-}
-
-static inline void exynos_pcie_rc_set_cpl_timeout_state(int ch_num, bool recovery) { }
-
-static inline bool exynos_pcie_rc_get_sudden_linkdown_state(int ch_num)
-{
-	return false;
-}
-
-static inline void exynos_pcie_rc_set_sudden_linkdown_state(int ch_num, bool recovery) { }
-
-static inline void exynos_pcie_set_ready_cto_recovery(int ch_num) { }
-
-static inline void exynos_pcie_rc_force_linkdown_work(int ch_num)
-{
-	PIXEL_PCIE_RC_STUB();
-}
-
-/* Register dumps for crash logs: nothing to dump. */
-static inline void exynos_pcie_rc_register_dump(int ch_num) { }
-static inline void exynos_pcie_rc_dump_all_status(int ch_num) { }
-static inline void exynos_pcie_rc_print_msi_register(int ch_num) { }
-#endif
--- a/cpif/s51xx_pcie.c
+++ b/cpif/s51xx_pcie.c
@@ -390,16 +390,11 @@
 static int s51xx_pcie_probe(struct pci_dev *pdev, const struct pci_device_id *ent)
 {
 	int ret;
-	int __maybe_unused i;
-	struct s51xx_pcie *s51xx_pcie;
+		struct s51xx_pcie *s51xx_pcie;
 	struct device *dev = &pdev->dev;
 	struct pci_driver *driver = pdev->driver;
 	struct modem_ctl *mc = container_of(driver, struct modem_ctl, pci_driver);
 	struct device *mc_dev = mc->dev;
-	struct pci_bus *bus = pdev->bus;
-	struct pci_dev *bus_self = bus->self;
-	struct resource *tmp_rsc;
-	int resno = PCI_BRIDGE_MEM_WINDOW;
 	u32 val, db_addr;
 #if IS_ENABLED(CONFIG_LINK_DEVICE_PCIE_IOMMU)
 	static struct notifier_block sysmmu_fault_notifier;
@@ -420,32 +415,23 @@
 		return -EINVAL;
 	}
 
-	pci_write_config_dword(pdev, PCI_BASE_ADDRESS_0, db_addr);
 	pci_read_config_dword(pdev, PCI_BASE_ADDRESS_0, &val);
 	val &= PCI_BASE_ADDRESS_MEM_MASK;
+	if (val != 0x14e00000 || db_addr != 0x14e60000)
+		return -EINVAL;
 	s51xx_pcie->dbaddr_offset = db_addr - val;
 	s51xx_pcie->dbaddr_changed_base = val;
 	dev_info(dev, "db_addr : 0x%x , val : 0x%x, offset : 0x%x\n",
 			db_addr, val, (unsigned int)s51xx_pcie->dbaddr_offset);
 
-	mif_info("Disable BAR resources.\n");
-	for (i = 0; i < 6; i++) {
-		pdev->resource[i].start = 0x0;
-		pdev->resource[i].end = 0x0;
-		pdev->resource[i].flags = 0x82000000;
-		pci_assign_resource(pdev, i);
-	}
-
-	/* EP BAR setup: BAR0 (4kB) */
-	pdev->resource[0].start = val;
-	pdev->resource[0].end = val + SZ_4K;
-	pdev->resource[0].flags = 0x82000000;
-	pci_assign_resource(pdev, 0);
-
-	/* get Doorbell base address from root bus range */
-	tmp_rsc = bus_self->resource + resno;
-	dev_info(&bus_self->dev, "[%s] BAR %d: tmp rsc : %pR\n", __func__, resno, tmp_rsc);
-	s51xx_pcie->dbaddr_base = tmp_rsc->start;
+	/* pixel-pcie-cp assigned BAR0 in the fixed secure-ATU window.
+	 * Keep Linux's CPU resource and BAR sizing intact. The vendor's
+	 * reassignment used PCI addresses as CPU resources and invalid flags.
+	 */
+	if (pci_resource_start(pdev, 0) != 0x40000000 ||
+	    s51xx_pcie->dbaddr_offset + sizeof(u32) > pci_resource_len(pdev, 0))
+		return -EINVAL;
+	s51xx_pcie->dbaddr_base = pci_resource_start(pdev, 0);
 
 	mif_info("Set Doorbell register address.\n");
 	s51xx_pcie->doorbell_addr = devm_ioremap(&pdev->dev,
