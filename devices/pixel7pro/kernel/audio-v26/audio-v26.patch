+			       gs201_g3d_saved_regs[i].offset);
+		ctrl->saved_valid = false;
+	}
+	dev_dbg(ctrl->dev, "GPU top domain restored\n");
+	return 0;
+}
+
+static int gs201_pd_off(struct generic_pm_domain *genpd)
+{
+	struct gs201_domain *pd = container_of(genpd, struct gs201_domain, genpd);
+	struct gs201_g3d *ctrl = pd->ctrl;
+	unsigned int i;
+	u32 option;
+	int ret;
+
+	if (!pd->offset) {
+		ret = gs201_gpu_protection(ctrl, false);
+		if (ret)
+			return ret;
+		for (i = 0; i < ARRAY_SIZE(gs201_g3d_saved_regs); i++)
+			ctrl->saved[i] = readl(ctrl->regs[gs201_g3d_saved_regs[i].region] +
+					      gs201_g3d_saved_regs[i].offset);
+		ctrl->saved_valid = true;
+		ret = gs201_pd_context(false);
+		if (ret)
+			return ret;
+		option = readl(ctrl->regs[0] + 0x800);
+		writel(option & ~BIT(24), ctrl->regs[0] + 0x800);
+	}
+	ret = gs201_pd_set(pd, false);
+	if (!ret)
+		dev_dbg(ctrl->dev, "%s powered off\n", genpd->name);
+	return ret;
+}
+
+static int gs201_g3d_probe(struct platform_device *pdev)
+{
+	static const char * const names[] = { "gs201-g3d-top", "gs201-g3d-cores" };
+	struct device *dev = &pdev->dev;
+	struct gs201_g3d *ctrl;
+	struct resource *res;
+	unsigned int i;
+	int ret;
+
+	ctrl = devm_kzalloc(dev, sizeof(*ctrl), GFP_KERNEL);
+	if (!ctrl)
+		return -ENOMEM;
+	ctrl->dev = dev;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != GS201_PMU_BASE || resource_size(res) != 0x208)
+		return -EINVAL;
+	ctrl->pmu = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(ctrl->pmu))
+		return PTR_ERR(ctrl->pmu);
+	for (i = 0; i < 2; i++) {
+		ctrl->regs[i] = devm_platform_ioremap_resource(pdev, i + 1);
+		if (IS_ERR(ctrl->regs[i]))
+			return PTR_ERR(ctrl->regs[i]);
+	}
+	for (i = 0; i < 2; i++) {
+		struct gs201_domain *pd = &ctrl->pd[i];
+
+		pd->ctrl = ctrl;
+		pd->offset = i * 0x200;
+		pd->genpd.name = names[i];
+		pd->genpd.power_on = gs201_pd_on;
+		pd->genpd.power_off = gs201_pd_off;
+		ctrl->domains[i] = &pd->genpd;
+		ret = pm_genpd_init(&pd->genpd, NULL,
+				    !(readl(ctrl->pmu + pd->offset + 4) & BIT(0)));
+		if (ret)
+			goto remove_domains;
+	}
+	ret = pm_genpd_add_subdomain(ctrl->domains[0], ctrl->domains[1]);
+	if (ret)
+		goto remove_domains;
+	ctrl->data.domains = ctrl->domains;
+	ctrl->data.num_domains = ARRAY_SIZE(ctrl->domains);
+	ret = of_genpd_add_provider_onecell(dev->of_node, &ctrl->data);
+	if (ret) {
+		pm_genpd_remove_subdomain(ctrl->domains[0], ctrl->domains[1]);
+		goto remove_domains;
+	}
+	dev_info(dev, "GPU domains registered: top=%u cores=%u\n",
+		 readl(ctrl->pmu + 4) & 1, readl(ctrl->pmu + 0x204) & 1);
+	return 0;
+remove_domains:
+	while (i--)
+		pm_genpd_remove(ctrl->domains[i]);
+	return ret;
+}
+
+static const struct of_device_id gs201_g3d_match[] = {
+	{ .compatible = "google,gs201-g3d-pmu" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gs201_g3d_match);
+
+static struct platform_driver gs201_g3d_driver = {
+	.probe = gs201_g3d_probe,
+	.driver = {
+		.name = "gs201-g3d-pd",
+		.of_match_table = gs201_g3d_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(gs201_g3d_driver);
