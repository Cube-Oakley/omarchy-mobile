+	val &= ~(BRCMF_PCIE_SRPWR_DOMAINS << BRCMF_PCIE_SRPWR_REQON_SHIFT);
+	val |= domains << BRCMF_PCIE_SRPWR_REQON_SHIFT;
+	brcmf_pcie_write_reg32(devinfo, BRCMF_PCIE_SRPWR_CTRL, val);
+	for (i = 0; i < 100; i++) {
+		val = brcmf_pcie_read_reg32(devinfo, BRCMF_PCIE_SRPWR_CTRL);
+		if ((val >> BRCMF_PCIE_SRPWR_STATUS_SHIFT & domains) == domains)
+			return;
+		usleep_range(100, 200);
+	}
+	brcmf_err(bus, "power domains did not come on (%#x)\n", val);
