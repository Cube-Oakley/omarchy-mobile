--- c/init/main.c
+++ i/init/main.c
@@ -365,17 +365,24 @@ static int __init warn_bootconfig(char *str)
 
 static void __init setup_boot_config(void)
 {
-	const char *msg, *data;
+	const char *msg, *data, *initrd_data;
 	int pos, ret, offs;
-	size_t size;
+	size_t size, initrd_size = 0;
 	bool from_embedded = false;
 
-	/* Cut out the bootconfig data even if we have no bootconfig option */
-	data = get_boot_config_from_initrd(&size);
-	/* If there is no bootconfig in initrd, try embedded one. */
-	if (!data) {
-		data = xbc_get_embedded_bootconfig(&size);
+	/* Always strip an initrd trailer so it is not unpacked as files. */
+	initrd_data = get_boot_config_from_initrd(&initrd_size);
+	/*
+	 * Pixel vendor_boot carries androidboot.* bootconfig. Using that
+	 * instead of the embed would drop kernel { rdinit = "/ourinit" }.
+	 * Vendor ramdisk also overwrites /init, so PID 1 must be rdinit.
+	 */
+	data = xbc_get_embedded_bootconfig(&size);
+	if (data) {
 		from_embedded = true;
+	} else {
+		data = initrd_data;
+		size = initrd_size;
 	}
 
 	bootconfig_found = bootconfig_cmdline_requested(boot_command_line, &offs);
