+/* The BCM4389 splits its backplane into power domains the host must request
+ * ("ARM, TCM, Main, Aux: host needs to power up" in bcmdhd's MULTIBP_CAP).
+ * A chip warm from an earlier firmware run has them on; from power-on only
+ * PCIe and ARM are. The firmware then fails to reset the MAC cores, and once
+ * the interface comes up its backplane faults and every host access reads
+ * all-ones. All four are requested after each reset. The running firmware
+ * holds what it needs, so with deep sleep the request is dropped once it is
+ * up, letting the domains power down, as bcmdhd does.
+ */
+static void brcmf_pcie_srpwr_request(struct brcmf_pciedev_info *devinfo,
+				     u32 domains)
+{
