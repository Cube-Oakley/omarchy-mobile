diff --git c/drivers/thermal/samsung/gs201_acpm_thermal.c i/drivers/thermal/samsung/gs201_acpm_thermal.c
new file mode 100644
index 000000000..67edeb17c
--- /dev/null
+++ i/drivers/thermal/samsung/gs201_acpm_thermal.c
@@ -0,0 +1,79 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GS201 firmware-owned temperature sensors, polled through ACPM. */
+#include <linux/err.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/thermal.h>
+
+#define GS201_TMU_CHANNEL 9
+#define GS201_TMU_ZONES 7
+
+struct gs201_sensor {
+	struct acpm_handle *handle;
+	u8 id;
+};
+
+static int gs201_get_temp(struct thermal_zone_device *tz, int *temp)
+{
+	struct gs201_sensor *sensor = thermal_zone_device_priv(tz);
+	int celsius, ret;
+
+	ret = sensor->handle->ops->tmu.read_temp(sensor->handle,
+					      GS201_TMU_CHANNEL, sensor->id, &celsius);
+	if (ret)
+		return ret;
+	*temp = celsius * 1000;
+	return 0;
+}
+
+static const struct thermal_zone_device_ops gs201_thermal_ops = {
+	.get_temp = gs201_get_temp,
+};
+
+static int gs201_thermal_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct acpm_handle *handle;
+	struct gs201_sensor *sensors;
+	struct thermal_zone_device *tz;
+	int i, ret;
+
+	handle = devm_acpm_get_by_phandle(dev);
+	if (IS_ERR(handle))
+		return dev_err_probe(dev, PTR_ERR(handle), "ACPM is not ready\n");
+	sensors = devm_kcalloc(dev, GS201_TMU_ZONES, sizeof(*sensors), GFP_KERNEL);
+	if (!sensors)
+		return -ENOMEM;
+	for (i = 0; i < GS201_TMU_ZONES; i++) {
+		sensors[i].handle = handle;
+		sensors[i].id = i;
+		tz = devm_thermal_of_zone_register(dev, i, &sensors[i], &gs201_thermal_ops);
+		if (IS_ERR(tz)) {
+			ret = PTR_ERR(tz);
+			if (ret == -ENODEV)
+				continue;
+			return dev_err_probe(dev, ret, "Cannot register sensor %d\n", i);
+		}
+	}
+	dev_info(dev, "ACPM temperature sensors registered; firmware configuration retained\n");
+	return 0;
+}
+
+static const struct of_device_id gs201_thermal_match[] = {
+	{ .compatible = "google,gs201-acpm-thermal" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gs201_thermal_match);
+
+static struct platform_driver gs201_thermal_driver = {
+	.probe = gs201_thermal_probe,
+	.driver = {
+		.name = "gs201-acpm-thermal",
+		.of_match_table = gs201_thermal_match,
+	},
+};
+module_platform_driver(gs201_thermal_driver);
+MODULE_DESCRIPTION("GS201 ACPM temperature sensor driver");
+MODULE_LICENSE("GPL");
