@@ -0,0 +1,51 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/google,gs201-g3d-pmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google GS201 GPU power domains
+
+maintainers:
+  - Tudor Ambarus <tudor.ambarus@linaro.org>
+
+description: |
+  GS201 GPU power controls use secure PMU writes. The top domain (0) retains
+  CMU and SYSREG context across power collapse. The embedded core domain (1)
+  is a child of the top domain.
+
+properties:
+  compatible:
+    const: google,gs201-g3d-pmu
+
+  reg:
+    items:
+      - description: PMU GPU top and embedded-core control/status window
+      - description: GPU CMU retention registers
+      - description: GPU SYSREG retention registers
+
+  reg-names:
+    items:
+      - const: pmu
+      - const: cmu
+      - const: sysreg
+
+  '#power-domain-cells':
+    const: 1
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - '#power-domain-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    power-controller@18061e00 {
+        compatible = "google,gs201-g3d-pmu";
+        reg = <0x18061e00 0x208>, <0x27f00000 0x8000>, <0x27f20000 0x1000>;
+        reg-names = "pmu", "cmu", "sysreg";
+        #power-domain-cells = <1>;
+    };
