 	skb = __hci_cmd_sync(hdev, 0xfc2e, 0, NULL, HCI_INIT_TIMEOUT);
@@ -251,6 +260,21 @@ int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
 
 		opcode = le16_to_cpu(cmd->opcode);
 
+		if (write_ram_unacked && opcode == 0xfc4c) {
+			err = __hci_cmd_send(hdev, opcode, cmd->plen, cmd_param);
+			if (err) {
+				bt_dev_err(hdev, "BCM: Patch command %04x failed (%d)",
+					   opcode, err);
+				return err;
+			}
+			/* At most 200 bytes/ms, below the UART's rate: Launch
+			 * RAM queues behind these records, and its reply must
+			 * come within the 2 s HCI command timeout.
+			 */
+			usleep_range(cmd->plen * 5, cmd->plen * 5 + 50);
+			continue;
+		}
+
 		skb = __hci_cmd_sync(hdev, opcode, cmd->plen, cmd_param,
 				     HCI_INIT_TIMEOUT);
 		if (IS_ERR(skb)) {
@@ -446,6 +470,15 @@ static int btbcm_read_info(struct hci_dev *hdev)
 		return PTR_ERR(skb);
 
 	bt_dev_info(hdev, "BCM: chip id %u", skb->data[1]);
+
+	/* BCM4389 (Pixel 7 Pro, over UART): its ROM firmware claims commands
+	 * it then rejects, as the BCM4387's does (hci_bcm4377.c).
+	 */
+	if (skb->data[1] == 170) {
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_MWS_TRANSPORT_CONFIG);
+		hci_set_quirk(hdev, HCI_QUIRK_BROKEN_LE_CODED);
+		hci_set_quirk(hdev, HCI_QUIRK_FIXUP_LE_EXT_ADV_REPORT_PHY);
