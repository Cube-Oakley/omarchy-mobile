+#define BRCMF_PCIE_SRPWR_CTRL		(BRCMF_PCIE_BARO_PCIE_ENUM_OFFSET + 0x1e8)
+#define BRCMF_PCIE_SRPWR_REQON_SHIFT	8
+#define BRCMF_PCIE_SRPWR_STATUS_SHIFT	16
+/* PCIe, ARM/backplane, MAC aux and MAC main */
+#define BRCMF_PCIE_SRPWR_ARM		0x2
+#define BRCMF_PCIE_SRPWR_DOMAINS	0xf
