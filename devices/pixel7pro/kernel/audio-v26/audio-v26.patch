diff --git c/arch/arm64/kernel/pixel_earlycon.c i/arch/arm64/kernel/pixel_earlycon.c
new file mode 100644
index 000000000..4033eb9e7
--- /dev/null
+++ i/arch/arm64/kernel/pixel_earlycon.c
@@ -0,0 +1,241 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Cheetah early framebuffer console, based on the verified RAM probe v2.
+ * Development-only: stock GS201 DT, retained ABL DPP0/DECON0, no display driver.
+ * Uses EFI earlycon's temporary-map -> early_initcall permanent-map pattern.
+ * CONFIG_PSTORE_RAM must be disabled: we own its console buffer during this test.
+ */
+#include <linux/console.h>
+#include <linux/font.h>
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/memblock.h>
+#include <linux/pixel_handoff.h>
+#include <linux/serial_core.h>
+#include <linux/sizes.h>
+#include <asm/arch_timer.h>
+#include <asm/early_ioremap.h>
+
+#define PFB_BASE 0xfac00000UL
+#define PFB_W 1440
+#define PFB_H 3120
+#define PFB_BYTES PAGE_ALIGN(PFB_W * PFB_H * 4)
+#define PFB_DMA 0x1c0b0000UL
+#define PFB_DECON 0x1c240000UL
+#define PFB_LOG 0xfd3ff000UL
+#define PFB_LOG_SIZE SZ_128K
+#define PFB_Y 600
+#define PFB_ROWS 60
+#define PFB_COLS 82
+#define PFB_CH 32
+#define PFB_ROW_BYTES (PFB_CH * PFB_W * 4)
+
+static void *pixel_fb, *pixel_log;
+static void __iomem *pixel_decon;
+static bool pixel_active, pixel_draw;
+static unsigned int pixel_x, pixel_y;
+static u64 last_flush;
+void __init pixel_early_stage(void);
+void __init pixel_early_note(const char *s);
+
+static __ref void *pixel_map(phys_addr_t pa, size_t size, void *permanent)
+{
+	if (permanent)
+		return permanent;
+	return early_memremap_prot(pa, size, pgprot_val(pgprot_writecombine(PAGE_KERNEL)));
+}
+
+static __ref void pixel_unmap(void *p, size_t size, void *permanent)
+{
+	if (!permanent && p)
+		early_memunmap(p, size);
+}
+
+static void pixel_save(const char *s, unsigned int n)
+{
+	u32 *log = pixel_map(PFB_LOG, PFB_LOG_SIZE, pixel_log);
+	u32 used;
+
+	if (!log)
+		return;
+	used = READ_ONCE(log[2]);
+	if (used < PFB_LOG_SIZE - 12) {
+		n = min_t(unsigned int, n, PFB_LOG_SIZE - 12 - used);
+		memcpy((u8 *)log + 12 + used, s, n);
+		wmb();
+		WRITE_ONCE(log[1], used + n);
+		WRITE_ONCE(log[2], used + n);
+		wmb();
+	}
+	pixel_unmap(log, PFB_LOG_SIZE, pixel_log);
+}
+
+void __init pixel_early_stage(void)
+{
+	pixel_save("Linux setup_arch: early mappings ready\n",
+		   sizeof("Linux setup_arch: early mappings ready\n") - 1);
+}
+
+void __init pixel_early_note(const char *s)
+{
+	pixel_save(s, strlen(s));
+	pixel_save("\n", 1);
+}
+
+static void __ref pixel_flush(void)
+{
+	void __iomem *regs;
+	u32 trigger;
+	u64 start, freq = read_sysreg(cntfrq_el0);
+
+	if (!pixel_draw)
+		return;
+	/* Cap normal refreshes at ~25 Hz; RAM log still records every message. */
+	start = __arch_counter_get_cntvct();
+	if (start - last_flush < freq / 25)
+		return;
+	regs = pixel_decon ?: early_ioremap(PFB_DECON, PAGE_SIZE);
+	if (!regs)
+		return;
+	trigger = readl(regs + 0x30);
+	wmb();
+	writel(readl(regs + 0x50) | 0x3f, regs + 0x50);
+	writel(readl(regs + 0x20) | 3, regs + 0x20);
+	writel(readl(regs + 0x50) | 0x80100000, regs + 0x50);
+	writel((trigger & ~0x10U) | 1, regs + 0x30);
+	while (readl(regs + 0x50) && __arch_counter_get_cntvct() - start < freq / 10)
+		cpu_relax();
+	writel(trigger, regs + 0x30);
+	last_flush = __arch_counter_get_cntvct();
+	if (!pixel_decon)
+		early_iounmap(regs, PAGE_SIZE);
+}
+
+static void pixel_write(struct console *con, const char *s, unsigned int n)
+{
+	pixel_save(s, n);
+	if (!pixel_draw)
+		return;
+	while (n) {
+		u32 *row;
+		unsigned long offset = (PFB_Y + pixel_y * PFB_CH) * PFB_W * 4;
+		void *permanent = pixel_fb ? pixel_fb + offset : NULL;
+
+		row = pixel_map(PFB_BASE + offset, PFB_ROW_BYTES, permanent);
+		if (!row)
+			return;
+		if (!pixel_x)
+			for (unsigned int i = 0; i < PFB_CH * PFB_W; i++)
+				row[i] = 0xff101010;
+		while (n && pixel_x < PFB_COLS) {
+			unsigned char c = *s++;
+			n--;
+			if (c == '\r')
+				continue;
+			if (c == '\n') {
+				pixel_x = PFB_COLS;
+				break;
+			}
+			if (c == '\t') c = ' ';
+			for (unsigned int gy = 0; gy < 16; gy++) {
+				u8 bits = ((const u8 *)font_vga_8x16.data)[c * 16 + gy];
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					u32 color = bits & (128 >> gx) ? 0xffffffff : 0xff101010;
+					for (unsigned int dy = 0; dy < 2; dy++) {
+						u32 *p = row + (gy * 2 + dy) * PFB_W + 64 + pixel_x * 16 + gx * 2;
+						p[0] = p[1] = color;
+					}
+				}
+			}
+			pixel_x++;
+		}
+		pixel_unmap(row, PFB_ROW_BYTES, permanent);
+		if (pixel_x == PFB_COLS) {
+			pixel_x = 0;
+			pixel_y = (pixel_y + 1) % PFB_ROWS;
+		}
+	}
+	pixel_flush();
+}
+
+static int __init pixel_setup(struct earlycon_device *device, const char *opt)
+{
+	void __iomem *dma, *decon;
+	u32 *log;
+	u32 base, size, ctrl, global, trigger;
+
+	/* Refuse configurations that would have two writers on the same RAM log. */
+	if (IS_ENABLED(CONFIG_PSTORE_RAM))
+		return -EINVAL;
+	memblock_reserve(PFB_BASE, PFB_BYTES);
+	memblock_mark_nomap(PFB_BASE, PFB_BYTES);
+	memblock_reserve(PFB_LOG, SZ_4M);
+	memblock_mark_nomap(PFB_LOG, SZ_4M);
+	log = pixel_map(PFB_LOG, PFB_LOG_SIZE, NULL);
+	if (!log)
+		return -ENOMEM;
+	log[1] = log[2] = 0;
+	log[0] = 0x43474244;
+	wmb();
+	pixel_unmap(log, PFB_LOG_SIZE, NULL);
+	pixel_save("PIXEL LINUX EARLYCON SETUP\n", sizeof("PIXEL LINUX EARLYCON SETUP\n") - 1);
+	dma = early_ioremap(PFB_DMA, PAGE_SIZE);
+	decon = early_ioremap(PFB_DECON, PAGE_SIZE);
+	if (!dma || !decon) {
+		if (dma) early_iounmap(dma, PAGE_SIZE);
+		if (decon) early_iounmap(decon, PAGE_SIZE);
+		return -ENOMEM;
+	}
+	base = readl(dma + 0x40);
+	size = readl(dma + 0x10);
+	ctrl = readl(dma + 8);
+	global = readl(decon + 0x20);
+	trigger = readl(decon + 0x30);
+	pixel_draw = base == PFB_BASE && size == (PFB_H << 16 | PFB_W) &&
+		!(ctrl & 7) && ((ctrl >> 8) & 63) == 0 && !readl(dma + 0x14) &&
+		!(readl(dma + 0x50) & BIT(20)) && (global & BIT(8)) &&
+		(trigger & 0x11) && !(trigger & 0x102);
+	early_iounmap(dma, PAGE_SIZE);
+	early_iounmap(decon, PAGE_SIZE);
+	device->con->write = pixel_write;
+	pixel_active = true;
+	pr_info("Pixel earlycon: fb=%08x size=%08x ctrl=%08x trigger=%08x draw=%d\n",
+		base, size, ctrl, trigger, pixel_draw);
+	return 0;
+}
+EARLYCON_DECLARE(pixelfb, pixel_setup);
+
+static int __init pixel_remap(void)
+{
+	if (!pixel_active)
+		return 0;
+	pixel_fb = ioremap_wc(PFB_BASE, PFB_BYTES);
+	pixel_log = ioremap_wc(PFB_LOG, PFB_LOG_SIZE);
+	pixel_decon = ioremap(PFB_DECON, PAGE_SIZE);
+	if (!pixel_fb || !pixel_log || !pixel_decon)
+		panic("Pixel earlycon permanent mapping failed");
+	pr_info("Pixel earlycon: permanent mappings ready\n");
+	return 0;
+}
+early_initcall(pixel_remap);
+
+/* Serialize the last console drawing operation against the DRM handoff. The
+ * reserved RAM log remains active after DRM takes ownership of the pixels. */
+int pixel_earlycon_takeover(void)
+{
+	int ret = 0;
+
+	console_lock();
+	if (!pixel_draw || !pixel_fb || !pixel_decon)
+		ret = -ENODEV;
+	else
+		pixel_draw = false;
+	console_unlock();
+	return ret;
+}
+
+void pixel_earlycon_release(void)
+{
+	console_lock();
+	pixel_draw = true;
+	console_unlock();
+}
diff --git c/arch/arm64/kernel/pixel_gpu.c i/arch/arm64/kernel/pixel_gpu.c
new file mode 100644
index 000000000..1440280f0
--- /dev/null
+++ i/arch/arm64/kernel/pixel_gpu.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Explicit RAM-only GPU power-domain test controls. */
+#include <linux/clk.h>
+#include <linux/libfdt.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/io.h>
+#include <linux/iopoll.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/pm_qos.h>
+#include <linux/pm_runtime.h>
+#include <linux/thermal.h>
+#include <linux/workqueue.h>
+#include "pixel_gpu_overlay.h"
+
+static struct device *test_dev;
+static bool held;
+static int overlay_id;
+
+/* Stock GS201 gpu_dvfs_table (top G3DL2, shader stacks G3D) pairs matching the
+ * overlay's OPPs. Panthor's devfreq scales the top clock; the stacks follow,
+ * never above the top: lowered before a descent, raised after an ascent.
+ * Stock also asks MIF >= 845 MHz from 885 MHz up (a performance floor).
+ */
+static const struct { unsigned long top, stacks; } gpu_levels[] = {
+	{ 302000000, 202000000 }, { 470000000, 351000000 }, { 603000000, 471000000 },
+	{ 750000000, 572000000 }, { 885000000, 701000000 },
+};
+static struct clk *gpu_top, *gpu_stacks;
+static struct device *gpu_dev;
+static struct thermal_zone_device *gpu_tz;
+static struct dev_pm_qos_request gpu_thermal_qos;
+static s32 gpu_thermal_cap = PM_QOS_MAX_FREQUENCY_DEFAULT_VALUE;
+static struct delayed_work gpu_thermal_work;
+
+static unsigned long gpu_stacks_for(unsigned long top)
+{
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(gpu_levels); i++)
+		if (gpu_levels[i].top == top)
+			return gpu_levels[i].stacks;
+	return 0;
+}
+
+static int gpu_clk_notify(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct clk_notifier_data *d = data;
+	unsigned long stacks = gpu_stacks_for(d->new_rate);
+	int ret = 0;
+
+	switch (event) {
+	case PRE_RATE_CHANGE:
+		if (!stacks) {
+			pr_err("Pixel GPU: refusing unpaired top rate %lu\n", d->new_rate);
+			return NOTIFY_BAD;
+		}
+		/* Firmware must not reclock a power-gated GPU: a devfreq sysfs or QoS
+		 * update can arrive while Panthor is suspended. Refuse it; devfreq
+		 * applies the limits on its next poll after resume. Devfreq's lock,
+		 * which Panthor's suspend also takes, orders this against power-off.
+		 */
+		if (gpu_dev && !pm_runtime_active(gpu_dev))
+			return NOTIFY_BAD;
+		if (d->new_rate < d->old_rate)
+			ret = clk_set_rate(gpu_stacks, stacks);
+		if (ret)
+			pr_err("Pixel GPU: stacks descent to %lu failed %d\n", stacks, ret);
+		return notifier_from_errno(ret);
+	case POST_RATE_CHANGE:
+		if (d->new_rate > d->old_rate)
+			ret = clk_set_rate(gpu_stacks, stacks);
+		break;
+	case ABORT_RATE_CHANGE:
+		/* The top clock kept its old rate: restore that pair's stacks. */
+		if (d->new_rate < d->old_rate)
+			ret = clk_set_rate(gpu_stacks, gpu_stacks_for(d->old_rate));
+		break;
+	}
+	if (ret)
+		pr_err("Pixel GPU: stacks clock change failed %d (top %lu -> %lu)\n",
+		       ret, d->old_rate, d->new_rate);
+	return NOTIFY_OK;
+}
+
+static struct notifier_block gpu_clk_nb = { .notifier_call = gpu_clk_notify };
+
+/* The G3D zone has only a critical reboot trip, so cap the GPU here: 603 MHz
+ * from 60 C, 302 MHz from 65 C, uncapped again below 55 C. The cap changes
+ * the clock only while the GPU is powered; while it is suspended the next poll
+ * retries.
+ */
+static void gpu_thermal_poll(struct work_struct *work)
+{
+	s32 cap = gpu_thermal_cap;
+	int temp = 0;
+
+	if (!thermal_zone_get_temp(gpu_tz, &temp)) {
+		if (temp >= 65000)
+			cap = 302000;
+		else if (temp >= 60000)
+			cap = min_t(s32, cap, 603000);
+		else if (temp < 55000)
+			cap = PM_QOS_MAX_FREQUENCY_DEFAULT_VALUE;
+	}
+	if (cap != gpu_thermal_cap && pm_runtime_get_if_active(gpu_dev) > 0) {
+		if (dev_pm_qos_update_request(&gpu_thermal_qos, cap) >= 0) {
+			pr_info("Pixel GPU: thermal cap %s at %d mC\n",
+				cap == PM_QOS_MAX_FREQUENCY_DEFAULT_VALUE ? "released" :
+				cap == 302000 ? "302 MHz" : "603 MHz", temp);
+			gpu_thermal_cap = cap;
+		}
+		pm_runtime_put(gpu_dev);
+	}
+	schedule_delayed_work(&gpu_thermal_work, msecs_to_jiffies(500));
+}
+
+static int gpu_test_probe(struct platform_device *pdev)
+{
+	pm_runtime_enable(&pdev->dev);
+	test_dev = &pdev->dev;
+	return 0;
+}
+
+static const struct of_device_id gpu_test_match[] = {
+	{ .compatible = "google,pixel-gpu-power-test" },
+	{}
+};
+static struct platform_driver gpu_test_driver = {
+	.probe = gpu_test_probe,
+	.driver = {
+		.name = "pixel-gpu-power-test",
+		.of_match_table = gpu_test_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(gpu_test_driver);
+
+static int gpu_guard(void)
+{
+	struct thermal_zone_device *tz;
+	int temp, ret;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return -ENODEV;
+	tz = thermal_zone_get_zone_by_name("pixel-g3d");
+	if (IS_ERR(tz))
+		return PTR_ERR(tz);
+	ret = thermal_zone_get_temp(tz, &temp);
+	if (ret)
+		return ret;
+	return temp >= 5000 && temp < 60000 ? 0 : -ERANGE;
+}
+
+static int domains_set(const char *val, const struct kernel_param *kp)
+{
+	static bool applied;
+	struct device_node *acpm;
+	fdt32_t clocks[4];
+	void *blob;
+	int off, ret;
+
+	if (!sysfs_streq(val, "1") || applied)
+		return -EINVAL;
+	ret = gpu_guard();
+	if (ret)
+		return ret;
+	acpm = of_find_node_by_path("/power-management");
+	if (!acpm || !acpm->phandle) {
+		of_node_put(acpm);
+		return -ENODEV;
+	}
+	clocks[0] = clocks[2] = cpu_to_fdt32(acpm->phandle);
+	clocks[1] = cpu_to_fdt32(6);
+	clocks[3] = cpu_to_fdt32(5);
+	of_node_put(acpm);
+	blob = kmemdup(pixel_gpu_overlay, sizeof(pixel_gpu_overlay), GFP_KERNEL);
+	if (!blob)
+		return -ENOMEM;
+	off = fdt_path_offset(blob, "/fragment@0/__overlay__/gpu@28000000");
+	ret = fdt_setprop_inplace(blob, off, "clocks", clocks, sizeof(clocks));
+	if (!ret)
+		ret = of_overlay_fdt_apply(blob, sizeof(pixel_gpu_overlay), &overlay_id, NULL);
+	kfree(blob);
+	if (!ret)
+		applied = true;
+	return ret;
+}
+
+static int cycle_set(const char *val, const struct kernel_param *kp)
+{
+	void __iomem *pmu, *gpu;
+	u32 state, id;
+	int ret;
+
+	if (!sysfs_streq(val, "1") || !test_dev || held)
+		return -EINVAL;
+	ret = gpu_guard();
+	if (ret)
+		return ret;
+	pmu = ioremap(0x18061e00, 0x208);
+	if (!pmu)
+		return -ENOMEM;
+	ret = pm_runtime_resume_and_get(test_dev);
+	if (ret < 0)
+		goto unmap_pmu;
+	ret = pm_runtime_put_sync_suspend(test_dev);
+	if (ret < 0)
+		goto unmap_pmu;
+	ret = readl_poll_timeout(pmu + 4, state, !(state & 1), 10, 100000);
+	if (ret)
+		goto unmap_pmu;
+	pr_info("Pixel GPU: powered off top=%u cores=%u\n",
+		readl(pmu + 4) & 1, readl(pmu + 0x204) & 1);
+	ret = pm_runtime_resume_and_get(test_dev);
+	if (ret < 0)
+		goto unmap_pmu;
+	held = true;
+	if (!(readl(pmu + 4) & readl(pmu + 0x204) & 1)) {
+		ret = -EIO;
+		goto unmap_pmu;
+	}
+	gpu = ioremap(0x28000000, 0x1000);
+	if (!gpu) {
+		ret = -ENOMEM;
+		goto unmap_pmu;
+	}
+	id = readl(gpu);
+	pr_info("Pixel GPU: restored top=%u cores=%u GPU_ID=%08x; runtime reference held\n",
+		readl(pmu + 4) & 1, readl(pmu + 0x204) & 1, id);
+	iounmap(gpu);
+	ret = id == 0xa8620004 ? 0 : -ENODEV;
+unmap_pmu:
+	iounmap(pmu);
+	return ret;
+}
+
+static int render_set(const char *val, const struct kernel_param *kp)
+{
+	static bool attempted;
+	struct device_node *np;
+	struct platform_device *pdev;
+	struct property *prop;
+	struct clk *top, *stacks;
+	bool dvfs = false;
+	int ret;
+
+	if (!sysfs_streq(val, "1") || attempted || !held)
+		return -EINVAL;
+	ret = gpu_guard();
+	if (ret)
+		return ret;
+	np = of_find_node_by_path("/gpu@28000000");
+	if (!np)
+		return -ENODEV;
+	top = of_clk_get(np, 0);
+	if (IS_ERR(top)) {
+		ret = PTR_ERR(top);
+		goto put_node;
+	}
+	stacks = of_clk_get(np, 1);
+	if (IS_ERR(stacks)) {
+		ret = PTR_ERR(stacks);
+		goto put_top;
+	}
+	/* Lowest stock tuple: G3DL2=302 MHz >= G3D=202 MHz, top first on ascent. */
+	if (clk_get_rate(top) != 151000000 || clk_get_rate(stacks) != 151000000) {
+		ret = -ERANGE;
+		goto put_clocks;
+	}
+	ret = clk_set_rate(top, 302000000);
+	if (ret || clk_get_rate(top) != 302000000) {
+		ret = ret ?: -EIO;
+		goto put_clocks;
+	}
+	ret = clk_set_rate(stacks, 202000000);
+	if (ret || clk_get_rate(stacks) != 202000000) {
+		ret = ret ?: -EIO;
+		goto put_clocks;
+	}
+	gpu_tz = thermal_zone_get_zone_by_name("pixel-g3d");
+	if (IS_ERR(gpu_tz)) {
+		ret = PTR_ERR(gpu_tz);
+		goto put_clocks;
+	}
+	gpu_top = top;
+	gpu_stacks = stacks;
+	ret = clk_notifier_register(top, &gpu_clk_nb);
+	if (ret)
+		goto put_clocks;
+	dvfs = true;
+	prop = kzalloc(sizeof(*prop), GFP_KERNEL);
+	if (!prop) {
+		ret = -ENOMEM;
+		goto put_clocks;
+	}
+	prop->name = kstrdup("status", GFP_KERNEL);
+	prop->value = kstrdup("okay", GFP_KERNEL);
+	prop->length = 5;
+	if (!prop->name || !prop->value) {
+		ret = -ENOMEM;
+		goto free_prop;
+	}
+	attempted = true;
+	pr_info("Pixel GPU: binding Panthor at top=302 MHz, stacks=202 MHz; DVFS to 885/701 MHz\n");
+	ret = of_update_property(np, prop);
+	if (ret)
+		goto free_prop;
+	/* The live tree now owns the property; keep it until reboot. */
+	pdev = of_find_device_by_node(np);
+	if (!pdev || !device_is_bound(&pdev->dev)) {
+		ret = -ENODEV;
+	} else {
+		ret = pm_runtime_put_sync_suspend(test_dev);
+		held = false;
+		if (ret >= 0)
+			ret = 0;
+		/* Panthor is bound: its devfreq now owns the top clock. */
+		gpu_dev = get_device(&pdev->dev);
+		if (dev_pm_qos_add_request(gpu_dev, &gpu_thermal_qos, DEV_PM_QOS_MAX_FREQUENCY,
+					   PM_QOS_MAX_FREQUENCY_DEFAULT_VALUE) >= 0) {
+			INIT_DELAYED_WORK(&gpu_thermal_work, gpu_thermal_poll);
+			schedule_delayed_work(&gpu_thermal_work, msecs_to_jiffies(500));
+		} else {
+			pr_err("Pixel GPU: no thermal cap; limiting devfreq to 302 MHz\n");
+			dev_pm_qos_add_request(gpu_dev, &gpu_thermal_qos, DEV_PM_QOS_MAX_FREQUENCY,
+					       302000);
+		}
+	}
+	if (pdev)
+		put_device(&pdev->dev);
+	/* Keep both clocks and the pairing notifier for the life of the GPU. */
+	goto put_node;
+free_prop:
+	kfree(prop->name);
+	kfree(prop->value);
+	kfree(prop);
+put_clocks:
+	if (dvfs)
+		clk_notifier_unregister(top, &gpu_clk_nb);
+	clk_put(stacks);
+put_top:
+	clk_put(top);
+put_node:
+	of_node_put(np);
+	return ret;
+}
+
+static const struct kernel_param_ops domains_ops = { .set = domains_set };
+static const struct kernel_param_ops cycle_ops = { .set = cycle_set };
+static const struct kernel_param_ops render_ops = { .set = render_set };
+module_param_cb(render, &render_ops, NULL, 0200);
+module_param_cb(domains, &domains_ops, NULL, 0200);
+module_param_cb(cycle, &cycle_ops, NULL, 0200);
+MODULE_LICENSE("GPL");
