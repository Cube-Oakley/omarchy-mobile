diff --git c/drivers/clk/samsung/clk-gs201.c i/drivers/clk/samsung/clk-gs201.c
new file mode 100644
index 000000000..d69ba2803
--- /dev/null
+++ i/drivers/clk/samsung/clk-gs201.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* GS201 CMU_APM subset: the ACPM mailbox's real parent and gate clocks.
+ * Register/parent data: Google's GS201 cmucal-node.c and cmucal-sfr.c.
+ * Firmware owns the ALIVE PLL. Its nominal outputs are not programmable here.
+ */
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <dt-bindings/clock/google,gs201.h>
+
+#define APM_FUNC_MUX		0x1000
+#define APM_FUNCSRC_MUX		0x1004
+#define APM_FUNC_GATE		0x2084
+#define APM_AP_MAILBOX_GATE	0x20d4
+#define GATE_MANUAL		BIT(20)
+#define GATE_HWACG		BIT(28)
+
+struct gs201_apm {
+	spinlock_t lock;
+	struct clk_hw_onecell_data *clks;
+};
+
+static int gs201_apm_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct clk_parent_data func_parents[4] = {
+		{ .fw_name = "oscclk" }, {},
+		{ .fw_name = "padclk" }, { .fw_name = "oscclk" },
+	};
+	static const struct {
+		const char *name;
+		unsigned long rate;
+	} pll[] = {
+		{ "gs201_pll_alv_div2", 394000000 },
+		{ "gs201_pll_alv_div4", 197000000 },
+		{ "gs201_pll_alv_div16", 50000000 },
+		{ "gs201_pll_alv_div8", 99000000 },
+	};
+	const struct clk_hw *parents[4];
+	struct gs201_apm *apm;
+	struct clk_hw **hws;
+	void __iomem *base;
+	unsigned int i;
+	u32 value;
+
+	apm = devm_kzalloc(dev, sizeof(*apm), GFP_KERNEL);
+	if (!apm)
+		return -ENOMEM;
+	spin_lock_init(&apm->lock);
+	base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	apm->clks = devm_kzalloc(dev, struct_size(apm->clks, hws, GS201_APM_NR_CLKS),
+				GFP_KERNEL);
+	if (!apm->clks)
+		return -ENOMEM;
+	apm->clks->num = GS201_APM_NR_CLKS;
+	hws = apm->clks->hws;
+	for (i = 0; i < ARRAY_SIZE(pll); i++) {
+		hws[i] = devm_clk_hw_register_fixed_rate(dev, pll[i].name, NULL, 0,
+						       pll[i].rate);
+		if (IS_ERR(hws[i]))
+			return PTR_ERR(hws[i]);
+		parents[i] = hws[i];
+	}
+	/* Expose the inherited selection; never retune the firmware's APM bus. */
+	hws[GS201_APM_FUNCSRC] = devm_clk_hw_register_mux_parent_hws(dev,
+		"gs201_apm_funcsrc", parents, ARRAY_SIZE(parents), 0,
+		base + APM_FUNCSRC_MUX, 0, 2, CLK_MUX_READ_ONLY, &apm->lock);
+	if (IS_ERR(hws[GS201_APM_FUNCSRC]))
+		return PTR_ERR(hws[GS201_APM_FUNCSRC]);
+	func_parents[1].hw = hws[GS201_APM_FUNCSRC];
+	hws[GS201_APM_FUNC] = devm_clk_hw_register_mux_parent_data_table(dev,
+		"gs201_apm_func", func_parents, ARRAY_SIZE(func_parents), 0,
+		base + APM_FUNC_MUX, 0, 3, CLK_MUX_READ_ONLY, NULL, &apm->lock);
+	if (IS_ERR(hws[GS201_APM_FUNC]))
+		return PTR_ERR(hws[GS201_APM_FUNC]);
+
+	/* Same manual-gate setup used by the Samsung arm64 CMU core, limited to
+	 * these two verified gates. No PLL, mux, CMU option or SYSREG writes.
+	 */
+	value = readl(base + APM_FUNC_GATE);
+	writel((value | GATE_MANUAL) & ~GATE_HWACG, base + APM_FUNC_GATE);
+	value = readl(base + APM_AP_MAILBOX_GATE);
+	writel((value | GATE_MANUAL) & ~GATE_HWACG, base + APM_AP_MAILBOX_GATE);
+	hws[GS201_APM_GOUT_FUNC] = devm_clk_hw_register_gate_parent_hw(dev,
+		"gs201_apm_gout_func", hws[GS201_APM_FUNC], CLK_IS_CRITICAL,
+		base + APM_FUNC_GATE, 21, 0, &apm->lock);
+	if (IS_ERR(hws[GS201_APM_GOUT_FUNC]))
+		return PTR_ERR(hws[GS201_APM_GOUT_FUNC]);
+	hws[GS201_APM_MAILBOX_AP] = devm_clk_hw_register_gate_parent_hw(dev,
+		"gs201_apm_mailbox_ap", hws[GS201_APM_GOUT_FUNC], 0,
+		base + APM_AP_MAILBOX_GATE, 21, 0, &apm->lock);
+	if (IS_ERR(hws[GS201_APM_MAILBOX_AP]))
+		return PTR_ERR(hws[GS201_APM_MAILBOX_AP]);
+
+	dev_info(dev, "APM selectors func=%#x source=%#x; mailbox gate=%#x\n",
+		 readl(base + APM_FUNC_MUX), readl(base + APM_FUNCSRC_MUX),
+		 readl(base + APM_AP_MAILBOX_GATE));
+	return devm_of_clk_add_hw_provider(dev, of_clk_hw_onecell_get, apm->clks);
+}
+
+static const struct of_device_id gs201_cmu_match[] = {
+	{ .compatible = "google,gs201-cmu-apm" },
+	{}
+};
+MODULE_DEVICE_TABLE(of, gs201_cmu_match);
+
+static struct platform_driver gs201_cmu_driver = {
+	.probe = gs201_apm_probe,
+	.driver = {
+		.name = "gs201-cmu",
+		.of_match_table = gs201_cmu_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(gs201_cmu_driver);
