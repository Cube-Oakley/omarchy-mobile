+	llc[5] = eh.h_proto == htons(ETH_P_AARP) ||
+		 eh.h_proto == htons(ETH_P_IPX) ? 0xf8 : 0;
+	memcpy(llc + 6, &eh.h_proto, sizeof(eh.h_proto));
+	return 0;
