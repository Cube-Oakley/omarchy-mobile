+#define BRCMF_D2H_EPOCH_MODULO		253
+#define BRCMF_D2H_SYNC_TRIES		512
+#define BRCMF_D2H_SYNC_STEPS		5
+#define BRCMF_D2H_SYNC_DELAY_US		100
