+struct gs201_g3d {
+	struct device *dev;
+	void __iomem *pmu;
+	void __iomem *regs[2];
+	struct gs201_domain pd[2];
+	struct generic_pm_domain *domains[2];
+	struct genpd_onecell_data data;
+	u32 saved[ARRAY_SIZE(gs201_g3d_saved_regs)];
+	bool saved_valid;
+	bool protection_enabled;
+};
+
+static int gs201_pd_context(bool restore)
+{
+	struct arm_smccc_res res;
+
+	arm_smccc_smc(GS201_SMC_PD_CONTEXT, restore, GS201_G3D_TZPC,
+		      2, 0, 0, 0, 0, &res);
+	if (res.a0)
+		pr_err("GS201 GPU: secure context %s failed: %#lx\n",
+		       restore ? "restore" : "save", res.a0);
+	return res.a0 ? -EIO : 0;
+}
+
+static int gs201_gpu_protection(struct gs201_g3d *ctrl, bool enable)
+{
+	struct arm_smccc_res res;
+
+	if (ctrl->protection_enabled == enable)
+		return 0;
+	/* Google's GS201 GPU power callback: SMC_PROTECTION_SET, PROT_G3D. */
+	arm_smccc_smc(0x82002010, 0, 12, enable, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		dev_err(ctrl->dev, "GPU security configuration failed: %#lx\n", res.a0);
+		return -EACCES;
+	}
+	ctrl->protection_enabled = enable;
+	return 0;
+}
+
+static int gs201_pd_set(struct gs201_domain *pd, bool on)
+{
+	struct gs201_g3d *ctrl = pd->ctrl;
+	struct arm_smccc_res res;
+	u32 value = readl(ctrl->pmu + pd->offset);
+	int ret;
+
+	value = (value & ~BIT(0)) | on;
+	arm_smccc_smc(GS201_SMC_PRIV_REG, GS201_PMU_BASE + pd->offset,
+		      1, value, 0, 0, 0, 0, &res);
+	if (res.a0)
+		return dev_err_probe(ctrl->dev, -EACCES, "Secure PMU write failed: %#lx\n",
+				     res.a0);
+	ret = readl_poll_timeout(ctrl->pmu + pd->offset + 4, value,
+				!!(value & BIT(0)) == on, 10, 100000);
+	if (ret)
+		dev_err(ctrl->dev, "%s transition to %u timed out\n", pd->genpd.name, on);
+	return ret;
+}
+
+static int gs201_pd_on(struct generic_pm_domain *genpd)
