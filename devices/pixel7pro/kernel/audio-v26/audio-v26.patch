diff --git c/arch/arm64/kernel/pixel_acpm.c i/arch/arm64/kernel/pixel_acpm.c
new file mode 100644
index 000000000..20ccfcfc4
--- /dev/null
+++ i/arch/arm64/kernel/pixel_acpm.c
@@ -0,0 +1,520 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* RAM-only test glue for proper GS201 CCF/mailbox/ACPM drivers.
+ * No automatic activation: inspect first, then explicitly write activate=1.
+ * Queries are available after activation. CPU governors require a separate,
+ * guarded opt-in and are limited by the board test OPP tables.
+ */
+#include <linux/cpu.h>
+#include <linux/cpufreq.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/firmware/samsung/exynos-acpm-protocol.h>
+#include <linux/io.h>
+#include <linux/kthread.h>
+#include <linux/libfdt.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/slab.h>
+#include <linux/platform_device.h>
+#include <linux/sched.h>
+#include <linux/thermal.h>
+#include <linux/workqueue.h>
+#include "pixel_acpm_overlay.h"
+
+#define SRAM_BASE 0x18500000
+#define SRAM_SIZE 0x48000
+static int overlay_id;
+static bool activated;
+static struct device *query_dev;
+static struct acpm_handle *handle;
+
+static bool sram_range(u32 offset, u32 length)
+{
+	return !(offset & 3) && offset <= SRAM_SIZE && length <= SRAM_SIZE - offset;
+}
+
+static int inspect_handoff(void)
+{
+	struct device_node *np;
+	struct resource res;
+	void __iomem *sram, *cmu;
+	u32 table, count, i;
+	int ret;
+
+	if (!of_machine_is_compatible("google,GS201 CHEETAH"))
+		return -ENODEV;
+	np = of_find_node_by_path("/acpm_ipc");
+	if (!np)
+		return -ENODEV;
+	ret = of_address_to_resource(np, 1, &res);
+	of_node_put(np);
+	if (ret || res.start != SRAM_BASE || resource_size(&res) != SRAM_SIZE)
+		return -EINVAL;
+	sram = ioremap(SRAM_BASE, SRAM_SIZE);
+	if (!sram)
+		return -ENOMEM;
+	table = readl(sram + 0xa008);
+	count = readl(sram + 0xa018);
+	pr_info("Pixel ACPM: AP channels=%u table=%#x\n", count, table);
+	ret = -EINVAL;
+	if (!count || count > 16 || !sram_range(table, count * 72))
+		goto out;
+	for (i = 0; i < count; i++) {
+		void __iomem *ch = sram + table + i * 72;
+		u32 id = readl(ch), type = readl(ch + 12), qlen = readl(ch + 52);
+		u32 mlen = readl(ch + 56), poll = readl(ch + 68);
+		u32 ptrs[] = { 16, 20, 40, 44 };
+		u32 queues[] = { 24, 48 };
+		unsigned int j;
+
+		pr_info("Pixel ACPM: channel %u id=%u type=%u qlen=%u mlen=%u poll=%u\n",
+			i, id, type, qlen, mlen, poll);
+		if (id != i || (type != 1 && type != 2))
+			goto out;
+		/*
+		 * Register/buffer channels use a different transport and may contain
+		 * firmware-local addresses. The ACPM driver must skip them entirely.
+		 */
+		if (type == 2)
+			continue;
+		if (qlen < 2 || qlen > 1024 || !mlen ||
+		    mlen > 256 || (mlen & 3) || poll > 1)
+			goto out;
+		for (j = 0; j < ARRAY_SIZE(ptrs); j++) {
+			u32 off = readl(ch + ptrs[j]);
+
+			if (!sram_range(off, 4) ||
+			    (qlen > 1 && readl(sram + off) >= qlen))
+				goto out;
+		}
+		for (j = 0; j < ARRAY_SIZE(queues); j++)
+			if (!sram_range(readl(ch + queues[j]), qlen * mlen))
+				goto out;
+		if (!i && (!poll || mlen != 16 || qlen < 2))
+			goto out;
+	}
+	ret = 0;
+out:
+	iounmap(sram);
+	if (ret)
+		return ret;
+	cmu = ioremap(0x18000000, 0x8000);
+	if (!cmu)
+		return -ENOMEM;
+	pr_info("Pixel ACPM: CMU func=%08x source=%08x gate=%08x mailbox=%08x\n",
+		readl(cmu + 0x1000), readl(cmu + 0x1004),
+		readl(cmu + 0x2084), readl(cmu + 0x20d4));
+	iounmap(cmu);
+	return 0;
+}
+
+static int inspect_set(const char *val, const struct kernel_param *kp)
+{
+	if (!sysfs_streq(val, "1"))
+		return -EINVAL;
+	return inspect_handoff();
+}
+
+static int activate_set(const char *val, const struct kernel_param *kp)
+{
+	struct device_node *osc, *pad, *gic, *np;
+	void *blob;
+	fdt32_t clocks[2];
+	int off, ret;
+
+	if (!sysfs_streq(val, "1") || activated)
+		return -EINVAL;
+	ret = inspect_handoff();
+	if (ret)
+		return ret;
+	osc = of_find_node_by_path("/ext_24_5m");
+	pad = of_find_node_by_path("/ext_100m");
+	gic = of_find_compatible_node(NULL, NULL, "arm,gic-v3");
+	if (!osc || !pad || !gic || !osc->phandle || !pad->phandle || !gic->phandle) {
+		ret = -EINVAL;
+		goto put_nodes;
+	}
+	blob = kmemdup(pixel_acpm_overlay, sizeof(pixel_acpm_overlay), GFP_KERNEL);
+	if (!blob) {
+		ret = -ENOMEM;
+		goto put_nodes;
+	}
+	clocks[0] = cpu_to_fdt32(osc->phandle);
+	clocks[1] = cpu_to_fdt32(pad->phandle);
+	off = fdt_path_offset(blob, "/fragment@1/__overlay__/clock-controller@18000000");
+	ret = fdt_setprop_inplace(blob, off, "clocks", clocks, sizeof(clocks));
+	if (!ret) {
+		off = fdt_path_offset(blob, "/fragment@1/__overlay__/mailbox@18210000");
+		ret = fdt_setprop_inplace_u32(blob, off, "interrupt-parent", gic->phandle);
+	}
+	if (!ret) {
+		static const char * const zones[] = { "big", "mid", "little" };
+		static const unsigned int cpus[] = { 6, 4, 0 };
+		unsigned int i;
+
+		for (i = 0; i < ARRAY_SIZE(zones); i++) {
+			struct device_node *cpu = of_get_cpu_node(cpus[i], NULL);
+			fdt32_t map[3];
+			char path[96];
+
+			if (!cpu || !cpu->phandle) {
+				of_node_put(cpu);
+				ret = -EINVAL;
+				break;
+			}
+			map[0] = cpu_to_fdt32(cpu->phandle);
+			map[1] = cpu_to_fdt32(0);
+			map[2] = cpu_to_fdt32(U32_MAX);
+			of_node_put(cpu);
+			snprintf(path, sizeof(path),
+				 "/fragment@2/__overlay__/pixel-%s/cooling-maps/map", zones[i]);
+			off = fdt_path_offset(blob, path);
+			ret = fdt_setprop_inplace(blob, off, "cooling-device", map, sizeof(map));
+			if (ret)
+				break;
+		}
+	}
+	if (!ret)
+		ret = of_overlay_fdt_apply(blob, sizeof(pixel_acpm_overlay), &overlay_id, NULL);
+	kfree(blob);
+	if (ret)
+		goto put_nodes;
+	activated = true;
+	pr_info("Pixel ACPM: overlay %d applied; cpufreq requires separate opt-in\n", overlay_id);
+	query_dev = root_device_register("pixel-acpm-query");
+	if (IS_ERR(query_dev)) {
+		ret = PTR_ERR(query_dev);
+		query_dev = NULL;
+		goto put_nodes;
+	}
+	np = of_find_node_by_path("/power-management");
+	handle = devm_acpm_get_by_node(query_dev, np);
+	of_node_put(np);
+	if (IS_ERR(handle)) {
+		ret = PTR_ERR(handle);
+		handle = NULL;
+		pr_err("Pixel ACPM: firmware driver not ready: %d\n", ret);
+	}
+put_nodes:
+	of_node_put(osc);
+	of_node_put(pad);
+	of_node_put(gic);
+	return ret;
+}
+
+static int query_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int id;
+	unsigned long rate;
+	int ret = kstrtouint(val, 0, &id);
+
+	if (ret)
+		return ret;
+	if (!handle)
+		return -ENODEV;
+	if (id > 13)
+		return -EINVAL;
+	rate = handle->ops->dvfs.get_rate(handle, 0, id);
+	pr_info("Pixel ACPM: frequency query id=%u rate=%lu Hz\n", id, rate);
+	return rate ? 0 : -EIO;
+}
+
+static int temperature_set(const char *val, const struct kernel_param *kp)
+{
+	static const char * const names[] = {
+		"BIG", "MID", "LITTLE", "G3D", "ISP", "TPU", "AUR",
+	};
+	unsigned int id;
+	int temp, ret = kstrtouint(val, 0, &id);
+
+	if (ret)
+		return ret;
+	if (!handle)
+		return -ENODEV;
+	if (id >= ARRAY_SIZE(names))
+		return -EINVAL;
+	/* Stock GS201 DT selects channel 9 and zone IDs 0..6. */
+	ret = handle->ops->tmu.read_temp(handle, 9, id, &temp);
+	if (ret) {
+		pr_err("Pixel ACPM: temperature query %s failed: %d\n", names[id], ret);
+		return ret;
+	}
+	pr_info("Pixel ACPM: temperature query id=%u %s=%d C\n", id, names[id], temp);
+	return 0;
+}
+
+/* Stock GS201 DVFS-manager dm-tables med_ank_perf and big_ank_perf (kHz): a
+ * MID or BIG frequency needs at least this LITTLE frequency. A LITTLE
+ * minimum-frequency QoS request follows the other two clusters: raised as a
+ * MID/BIG increase begins, lowered after a decrease ends, applied from work
+ * so no cpufreq policy is updated from inside another's notifier.
+ */
+static const unsigned int mid_little[][2] = {
+	{ 2348000, 1328000 }, { 2253000, 1197000 }, { 2130000, 1098000 }, { 1999000, 1098000 },
+	{ 1836000, 1098000 }, { 1663000, 1098000 }, { 1491000, 930000 }, { 1328000, 930000 },
+	{ 1197000, 738000 }, { 1024000, 738000 }, { 910000, 574000 }, { 799000, 574000 },
+	{ 696000, 574000 }, { 553000, 574000 }, { 400000, 300000 },
+};
+static const unsigned int big_little[][2] = {
+	{ 2850000, 1401000 }, { 2802000, 1401000 }, { 2704000, 1401000 }, { 2630000, 1401000 },
+	{ 2507000, 1401000 }, { 2401000, 1401000 }, { 2252000, 1328000 }, { 2188000, 1328000 },
+	{ 2048000, 1197000 }, { 1826000, 1098000 }, { 1745000, 1098000 }, { 1582000, 930000 },
+	{ 1426000, 930000 }, { 1277000, 738000 }, { 1106000, 738000 }, { 984000, 738000 },
+	{ 851000, 574000 }, { 500000, 300000 },
+};
+static struct freq_qos_request little_min;
+static unsigned int mid_khz, big_khz;
+static struct work_struct little_work;
+
+/* The row for the lowest listed frequency at or above khz. */
+static unsigned int little_need(const unsigned int (*table)[2], unsigned int rows, unsigned int khz)
+{
+	unsigned int i, need = table[0][1];
+
+	for (i = 0; i < rows; i++)
+		if (table[i][0] >= khz)
+			need = table[i][1];
+	return need;
+}
+
+static void little_update(struct work_struct *work)
+{
+	unsigned int need = max(little_need(mid_little, ARRAY_SIZE(mid_little), READ_ONCE(mid_khz)),
+				little_need(big_little, ARRAY_SIZE(big_little), READ_ONCE(big_khz)));
+
+	if (freq_qos_update_request(&little_min, need) < 0)
+		pr_err_ratelimited("Pixel ACPM: LITTLE floor %u kHz not applied\n", need);
+}
+
+static int cluster_transition(struct notifier_block *nb, unsigned long event, void *data)
+{
+	struct cpufreq_freqs *freqs = data;
+	unsigned int *khz;
+
+	if (cpumask_test_cpu(4, freqs->policy->related_cpus))
+		khz = &mid_khz;
+	else if (cpumask_test_cpu(6, freqs->policy->related_cpus))
+		khz = &big_khz;
+	else
+		return NOTIFY_OK;
+	if ((event == CPUFREQ_PRECHANGE && freqs->new > freqs->old) ||
+	    (event == CPUFREQ_POSTCHANGE && freqs->new < freqs->old)) {
+		WRITE_ONCE(*khz, freqs->new);
+		schedule_work(&little_work);
+	}
+	return NOTIFY_OK;
+}
+
+static struct notifier_block cluster_nb = { .notifier_call = cluster_transition };
+
+static int little_floor_start(void)
+{
+	struct cpufreq_policy *little = cpufreq_cpu_get(0);
+	struct cpufreq_policy *mid = cpufreq_cpu_get(4);
+	struct cpufreq_policy *big = cpufreq_cpu_get(6);
+	int ret = -ENODEV;
+
+	if (!little || !mid || !big)
+		goto out;
+	mid_khz = mid->cur;
+	big_khz = big->cur;
+	INIT_WORK(&little_work, little_update);
+	ret = freq_qos_add_request(&little->constraints, &little_min, FREQ_QOS_MIN,
+				   max(little_need(mid_little, ARRAY_SIZE(mid_little), mid_khz),
+				       little_need(big_little, ARRAY_SIZE(big_little), big_khz)));
+	if (ret < 0)
+		goto out;
+	ret = cpufreq_register_notifier(&cluster_nb, CPUFREQ_TRANSITION_NOTIFIER);
+	if (ret)
+		freq_qos_remove_request(&little_min);
+out:
+	/* The request keeps pointing at CPU0's policy, which never goes away. */
+	if (ret && little)
+		cpufreq_cpu_put(little);
+	if (mid)
+		cpufreq_cpu_put(mid);
+	if (big)
+		cpufreq_cpu_put(big);
+	return ret;
+}
+
+/* Fast CPU thermal cap. The polled thermal zones react every 100-250 ms, but
+ * a BIG core at 2850 MHz heats its sensor about 37 C per second. This thread
+ * reads the BIG and MID sensors every 20 ms and caps both clusters in one
+ * step. The full stock rates are allowed below 75 C. From 75 C the caps are
+ * the sustained 2048/1999 MHz, from 85 C 1582/1663 MHz, and from 92 C
+ * 1106/1197 MHz. A level clears 5 C below its threshold, but no sooner than
+ * a second after it was raised: the sensor swings about 10 C within one poll,
+ * and every change is a firmware voltage and clock transition. A failed read
+ * means the sustained caps. The zones' own trips (75 C passive, 95 C
+ * critical) stay behind it. Below 60 C it polls every 100 ms instead: a BIG
+ * core gains under 4 C in that time, and idle CPUs are not woken 50 times
+ * a second.
+ */
+static const struct {
+	int temp;
+	unsigned int big, mid;
+} boost_levels[] = {
+	{ 0, 2850000, 2348000 }, { 75, 2048000, 1999000 },
+	{ 85, 1582000, 1663000 }, { 92, 1106000, 1197000 },
+};
+static struct freq_qos_request big_cap, mid_cap;
+static unsigned int boost_level = 1;
+static unsigned long boost_raised;
+
+static void boost_apply(unsigned int level, int temp)
+{
+	if (level == boost_level)
+		return;
+	if (level > boost_level)
+		boost_raised = jiffies;
+	freq_qos_update_request(&big_cap, boost_levels[level].big);
+	freq_qos_update_request(&mid_cap, boost_levels[level].mid);
+	pr_info_ratelimited("Pixel ACPM: CPU cap level %u (BIG %u, MID %u MHz) at %d C\n", level,
+			    boost_levels[level].big / 1000, boost_levels[level].mid / 1000, temp);
+	boost_level = level;
+}
+
+static int boost_guard(void *unused)
+{
+	int big, mid, hot;
+	unsigned int want;
+	bool cool;
+
+	sched_set_fifo_low(current);
+	while (!kthread_should_stop()) {
+		if (handle->ops->tmu.read_temp(handle, 9, 0, &big) ||
+		    handle->ops->tmu.read_temp(handle, 9, 1, &mid)) {
+			boost_apply(max(boost_level, 1U), -1);
+			cool = false;
+		} else {
+			hot = max(big, mid);
+			want = boost_level;
+			while (want + 1 < ARRAY_SIZE(boost_levels) && hot >= boost_levels[want + 1].temp)
+				want++;
+			while (want > 0 && hot < boost_levels[want].temp - 5 &&
+			       time_after(jiffies, boost_raised + HZ))
+				want--;
+			boost_apply(want, hot);
+			cool = hot < 60;
+		}
+		if (cool)
+			usleep_range_state(100000, 110000, TASK_INTERRUPTIBLE);
+		else
+			usleep_range_state(20000, 22000, TASK_INTERRUPTIBLE);
+	}
+	return 0;
+}
+
+static int boost_guard_start(void)
+{
+	struct cpufreq_policy *mid = cpufreq_cpu_get(4);
+	struct cpufreq_policy *big = cpufreq_cpu_get(6);
+	struct task_struct *task;
+	int ret = -ENODEV;
+
+	if (!mid || !big)
+		goto out;
+	/* Start at the sustained caps until the first reading. */
+	boost_raised = jiffies;
+	ret = freq_qos_add_request(&mid->constraints, &mid_cap, FREQ_QOS_MAX, boost_levels[1].mid);
+	if (ret < 0)
+		goto out;
+	ret = freq_qos_add_request(&big->constraints, &big_cap, FREQ_QOS_MAX, boost_levels[1].big);
+	if (ret < 0) {
+		freq_qos_remove_request(&mid_cap);
+		goto out;
+	}
+	task = kthread_run(boost_guard, NULL, "pixel-cpu-thermal");
+	ret = PTR_ERR_OR_ZERO(task);
+	/* Without the thread the requests keep the sustained caps. */
+out:
+	if (ret && mid)
+		cpufreq_cpu_put(mid);
+	if (ret && big)
+		cpufreq_cpu_put(big);
+	return ret < 0 ? ret : 0;
+}
+
+static int cpufreq_set(const char *val, const struct kernel_param *kp)
+{
+	static const char * const zones[] = {
+		"pixel-big", "pixel-mid", "pixel-little", "pixel-g3d",
+		"pixel-isp", "pixel-tpu", "pixel-aur",
+	};
+	static const unsigned long boot_rates[] = { 1197000000, 1197000000, 1106000000 };
+	static struct platform_device *pdev;
+	struct thermal_zone_device *tz;
+	unsigned int i;
+	int temp, ret;
+
+	if (!sysfs_streq(val, "1") || pdev)
+		return -EINVAL;
+	if (!handle || num_online_cpus() != 8)
+		return -ENODEV;
+	/* Require live thermal zones and fresh, plausible firmware temperatures. */
+	for (i = 0; i < ARRAY_SIZE(zones); i++) {
+		tz = thermal_zone_get_zone_by_name(zones[i]);
+		if (IS_ERR(tz))
+			return PTR_ERR(tz);
+		ret = handle->ops->tmu.read_temp(handle, 9, i, &temp);
+		if (ret)
+			return ret;
+		if (temp < 5 || temp >= 60)
+			return -ERANGE;
+	}
+	/* Never bootstrap a governor from an unexpected firmware clock state.
+	 * A normal (not fastboot) boot leaves the little cluster at 1598 MHz,
+	 * above its bounded table; cpufreq moves an unlisted initial rate to a
+	 * table rate as it starts, so that state is accepted too.
+	 */
+	for (i = 0; i < ARRAY_SIZE(boot_rates); i++) {
+		unsigned long rate = handle->ops->dvfs.get_rate(handle, 0, i + 2);
+
+		if (rate != boot_rates[i] && !(i == 0 && rate == 1598000000))
+			return -ERANGE;
+	}
+	pdev = platform_device_register_simple("cpufreq-dt", -1, NULL, 0);
+	if (IS_ERR(pdev)) {
+		ret = PTR_ERR(pdev);
+		pdev = NULL;
+		return ret;
+	}
+	ret = little_floor_start();
+	if (ret) {
+		/* Without the dependency floor, hold MID/BIG at the old bounded maxima. */
+		struct cpufreq_policy *policy;
+		static struct freq_qos_request little_old_min, mid_old_cap, big_old_cap;
+
+		pr_err("Pixel ACPM: LITTLE floor unavailable (%d); capping MID/BIG\n", ret);
+		policy = cpufreq_cpu_get(0);
+		if (policy)
+			freq_qos_add_request(&policy->constraints, &little_old_min, FREQ_QOS_MIN, 738000);
+		policy = cpufreq_cpu_get(4);
+		if (policy)
+			freq_qos_add_request(&policy->constraints, &mid_old_cap, FREQ_QOS_MAX, 1197000);
+		policy = cpufreq_cpu_get(6);
+		if (policy)
+			freq_qos_add_request(&policy->constraints, &big_old_cap, FREQ_QOS_MAX, 1106000);
+		return 0;
+	}
+	ret = boost_guard_start();
+	if (ret)
+		pr_err("Pixel ACPM: fast CPU thermal cap unavailable (%d)\n", ret);
+	pr_info("Pixel ACPM: cpufreq-dt with stock OPPs, LITTLE floor following MID/BIG, thermal cooling\n");
+	return 0;
+}
+
+static const struct kernel_param_ops inspect_ops = { .set = inspect_set };
+static const struct kernel_param_ops activate_ops = { .set = activate_set };
+static const struct kernel_param_ops query_ops = { .set = query_set };
+static const struct kernel_param_ops temperature_ops = { .set = temperature_set };
+static const struct kernel_param_ops cpufreq_ops = { .set = cpufreq_set };
+module_param_cb(cpufreq, &cpufreq_ops, NULL, 0200);
+module_param_cb(inspect, &inspect_ops, NULL, 0200);
+module_param_cb(activate, &activate_ops, NULL, 0200);
+module_param_cb(query, &query_ops, NULL, 0200);
+module_param_cb(temperature, &temperature_ops, NULL, 0200);
+MODULE_DESCRIPTION("Explicit RAM-only GS201 ACPM bring-up controls");
+MODULE_LICENSE("GPL");
