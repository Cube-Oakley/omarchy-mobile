+	seqnum = commonring->d2h_seqnum++ % BRCMF_D2H_EPOCH_MODULO;
+	for (step = 1; step <= BRCMF_D2H_SYNC_STEPS; step++) {
+		for (tries = 0; tries < BRCMF_D2H_SYNC_TRIES; tries++) {
+			if (brcmf_commonring_d2h_valid(commonring, item, seqnum))
+				return true;
+			udelay(BRCMF_D2H_SYNC_DELAY_US * step);
+		}
+	}
+	return false;
+}
