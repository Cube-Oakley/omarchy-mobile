diff --git a/aoc/aoc_sysmmu.c b/aoc/aoc_sysmmu.c
new file mode 100644
index 0000000..cc580cd
--- /dev/null
+++ b/aoc/aoc_sysmmu.c
@@ -0,0 +1,216 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Static SysMMU v8 setup for the AOC on the Pixel 7 Pro (GS201).
+ *
+ * The AOC's SysMMU (the "iommus" phandle of the AOC node) translates a few
+ * fixed windows of AOC-view addresses: the carveout, the xHCI pool and some
+ * device windows, the same list as the firmware header's IOMMU table. Google's
+ * driver maps them through the samsung-iommu IOMMU driver, which does not
+ * build against this kernel's IOMMU core. Every window is 1 MB aligned, so a
+ * single first-level table of 1 MB section entries is enough, programmed
+ * directly here.
+ *
+ * Register offsets, the table format and the enable sequence follow
+ * samsung-iommu (samsung-iommu.[ch] in Google's GS201 kernel): VM register
+ * set (capability VCR), VID 0, fault stall mode, the node's QoS and TLB
+ * properties. Faults on the non-secure interrupt are logged and cleared,
+ * which lets the stalled access continue as a fault.
+ */
+#include <linux/bitops.h>
+#include <linux/dma-mapping.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+
+#include "aoc_sysmmu.h"
+
+#define REG_MMU_CTRL		0x000
+#define REG_MMU_CFG		0x004
+#define REG_MMU_VERSION		0x034
+#define REG_MMU_INT_STATUS	0x060
+#define REG_MMU_INT_CLEAR	0x064
+#define REG_MMU_CAPA1_V7	0x874
+#define REG_MMU_TLB_CFG(n)	(0x2000 + (n) * 0x20 + 0x4)
+#define REG_MMU_TLB_MATCH_CFG(n) (0x2000 + (n) * 0x20 + 0x8)
+#define REG_MMU_TLB_MATCH_ID(n)	(0x2000 + (n) * 0x20 + 0x14)
+/* VM register set, VID 0 */
+#define REG_VM_CTRL		0x8000
+#define REG_VM_FLPT_BASE	0x800c
+#define REG_VM_ALL_INV		0x8010
+#define REG_VM_FAULT_VA		0x1000
+#define REG_VM_FAULT_TRANS_INFO	0x1004
+
+#define CTRL_MMU_ENABLE		BIT(0)
+#define CTRL_MMU_BLOCK		BIT(1)
+#define CTRL_VID_ENABLE		BIT(0)
+#define CTRL_FAULT_STALL_MODE	BIT(3)
+#define CFG_QOS_OVRRIDE		BIT(11)
+#define CFG_QOS(n)		(((n) & 0xfU) << 7)
+#define CAPA1_VCR_ENABLED(r)	(((r) >> 14) & 1)
+#define CAPA1_NO_BLOCK_MODE(r)	(((r) >> 15) & 1)
+#define CAPA1_NUM_TLB(r)	(((r) >> 4) & 0xff)
+#define MMU_RAW_VER(r)		(((r) >> 17) & 0x7fff)
+#define TLB_CFG_MASK(r)		((r) & (GENMASK(7, 5) | GENMASK(3, 2) | GENMASK(1, 1)))
+#define TLB_MATCH_CFG_MASK(r)	((r) & (GENMASK(31, 16) | GENMASK(9, 8)))
+
+#define SECT_ORDER		20
+#define SECT_SIZE		(1UL << SECT_ORDER)
+#define SECT_FLAG		2
+#define PG_ENT_SHIFT		4
+#define NUM_LV1ENTRIES		65536
+#define LV1TABLE_SIZE		(NUM_LV1ENTRIES * sizeof(u32))
+#define MAX_TLB_PROPS		8
+
+struct tlb_config {
+	u32 index, cfg, match_cfg, match_id;
+};
+
+struct aoc_sysmmu {
+	struct device *dev;
+	void __iomem *base;
+	u32 *table;
+	dma_addr_t table_dma;
+	bool no_block;
+	int qos;
+	u32 default_tlb;
+	struct tlb_config tlb[MAX_TLB_PROPS];
+	int ntlb;
+};
+
+static irqreturn_t aoc_sysmmu_irq(int irq, void *data)
+{
+	struct aoc_sysmmu *s = data;
+	u32 status = readl_relaxed(s->base + REG_MMU_INT_STATUS);
+
+	if (!status)
+		return IRQ_NONE;
+	dev_err_ratelimited(s->dev,
+			    "AOC SysMMU fault: status %#x va %#x info %#x\n", status,
+			    readl_relaxed(s->base + REG_VM_FAULT_VA),
+			    readl_relaxed(s->base + REG_VM_FAULT_TRANS_INFO));
+	writel(status, s->base + REG_MMU_INT_CLEAR);
+	return IRQ_HANDLED;
+}
+
+struct aoc_sysmmu *aoc_sysmmu_create(struct device *dev, struct device_node *np)
+{
+	struct aoc_sysmmu *s;
+	struct resource res;
+	u32 capa1, qos;
+	int irq, n, ret;
+
+	s = devm_kzalloc(dev, sizeof(*s), GFP_KERNEL);
+	if (!s)
+		return ERR_PTR(-ENOMEM);
+	s->dev = dev;
+	ret = of_address_to_resource(np, 0, &res);
+	if (ret)
+		return ERR_PTR(ret);
+	s->base = devm_ioremap(dev, res.start, resource_size(&res));
+	if (!s->base)
+		return ERR_PTR(-ENOMEM);
+
+	capa1 = readl_relaxed(s->base + REG_MMU_CAPA1_V7);
+	if (!CAPA1_VCR_ENABLED(capa1)) {
+		dev_err(dev, "AOC SysMMU without VM registers (capa1 %#x)\n", capa1);
+		return ERR_PTR(-ENODEV);
+	}
+	s->no_block = CAPA1_NO_BLOCK_MODE(capa1);
+	s->qos = of_property_read_u32(np, "qos", &qos) ? -1 : (int)qos;
+	if (of_property_read_u32(np, "sysmmu,default_tlb", &s->default_tlb))
+		s->default_tlb = ~0U;
+	n = of_property_count_u32_elems(np, "sysmmu,tlb_property");
+	if (n > 0) {
+		s->ntlb = min_t(int, n / 4, MAX_TLB_PROPS);
+		of_property_read_u32_array(np, "sysmmu,tlb_property", (u32 *)s->tlb, s->ntlb * 4);
+		for (n = 0; n < s->ntlb; n++)
+			if (s->tlb[n].index >= CAPA1_NUM_TLB(capa1))
+				s->tlb[n].index = ~0U;
+	}
+
+	/* A first-level table, naturally aligned by the coherent allocator. */
+	s->table = dmam_alloc_coherent(dev, LV1TABLE_SIZE, &s->table_dma, GFP_KERNEL);
+	if (!s->table)
+		return ERR_PTR(-ENOMEM);
+
+	irq = of_irq_get(np, 0);
+	if (irq > 0) {
+		ret = devm_request_irq(dev, irq, aoc_sysmmu_irq, 0, "aoc-sysmmu", s);
+		if (ret)
+			dev_warn(dev, "AOC SysMMU fault irq %d: %d\n", irq, ret);
+	}
+	dev_info(dev, "AOC SysMMU %pa version %#x, table at %pad\n", &res.start,
+		 MMU_RAW_VER(readl_relaxed(s->base + REG_MMU_VERSION)), &s->table_dma);
+	return s;
+}
+
+int aoc_sysmmu_map(struct aoc_sysmmu *s, u32 iova, phys_addr_t pa, size_t size)
+{
+	size_t off;
+
+	if (!IS_ALIGNED(iova | pa | size, SECT_SIZE))
+		return -EINVAL;
+	for (off = 0; off < size; off += SECT_SIZE)
+		s->table[(iova + off) >> SECT_ORDER] =
+			(u32)((pa + off) >> PG_ENT_SHIFT) | SECT_FLAG;
+	wmb();
+	return 0;
+}
+
+void aoc_sysmmu_clear(struct aoc_sysmmu *s)
+{
+	memset(s->table, 0, LV1TABLE_SIZE);
+	wmb();
+}
+
+/* __sysmmu_enable() and __sysmmu_enable_vid() for VID 0. */
+void aoc_sysmmu_enable(struct aoc_sysmmu *s)
+{
+	u32 ctrl = readl_relaxed(s->base + REG_MMU_CTRL);
+	u32 cfg;
+	int i;
+
+	if (!s->no_block)
+		writel_relaxed(ctrl | CTRL_MMU_BLOCK, s->base + REG_MMU_CTRL);
+
+	cfg = readl_relaxed(s->base + REG_MMU_CFG);
+	if (s->qos >= 0) {
+		cfg &= ~CFG_QOS(0xf);
+		cfg |= CFG_QOS_OVRRIDE | CFG_QOS((u32)s->qos);
+	}
+	if (s->default_tlb != ~0U)
+		writel_relaxed(TLB_CFG_MASK(s->default_tlb), s->base + REG_MMU_TLB_CFG(0));
+	for (i = 0; i < s->ntlb; i++) {
+		if (s->tlb[i].index == ~0U)
+			continue;
+		writel_relaxed(TLB_CFG_MASK(s->tlb[i].cfg), s->base + REG_MMU_TLB_CFG(s->tlb[i].index));
+		writel_relaxed(TLB_MATCH_CFG_MASK(s->tlb[i].match_cfg),
+			       s->base + REG_MMU_TLB_MATCH_CFG(s->tlb[i].index));
+		writel_relaxed(s->tlb[i].match_id, s->base + REG_MMU_TLB_MATCH_ID(s->tlb[i].index));
+	}
+	writel_relaxed(cfg, s->base + REG_MMU_CFG);
+
+	writel_relaxed((u32)(s->table_dma / SZ_4K), s->base + REG_VM_FLPT_BASE);
+	writel(1, s->base + REG_VM_ALL_INV);
+	writel(readl_relaxed(s->base + REG_VM_CTRL) | CTRL_FAULT_STALL_MODE | CTRL_VID_ENABLE,
+	       s->base + REG_VM_CTRL);
+
+	writel(ctrl | CTRL_MMU_ENABLE, s->base + REG_MMU_CTRL);
+}
+
+/* __sysmmu_disable() */
+void aoc_sysmmu_disable(struct aoc_sysmmu *s)
+{
+	u32 ctrl;
+
+	if (s->no_block) {
+		writel(1, s->base + REG_VM_ALL_INV);
+		return;
+	}
+	ctrl = readl_relaxed(s->base + REG_MMU_CTRL) & ~CTRL_MMU_ENABLE;
+	writel(ctrl | CTRL_MMU_BLOCK, s->base + REG_MMU_CTRL);
+}
