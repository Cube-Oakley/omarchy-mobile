+/*
+ * Pixel 7 Pro port: the GS201 windows (the same as the firmware header's
+ * IOMMU table), written into a static SysMMU table (aoc_sysmmu.c) instead of
+ * an IOMMU domain.
+ */
+static const struct {
+	u32 iova;
+	phys_addr_t pa;
+	size_t size;
+	const char *what;
+} aoc_gs201_windows[] = {
+	{ 0x9E000000, 0x18200000, SZ_2M, "mailboxes" },
+	{ 0x9E200000, 0x17C00000, SZ_1M, "gsa mailbox" },
+	{ 0x9E300000, 0x40000000, SZ_1M, "modem" },
+	{ 0x9B000000, 0x97000000, SZ_4M, "xhci_dma carveout" },
+	{ 0x9E500000, 0x11200000, SZ_1M, "usb" },
+};
+
