From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: cube oakley <cube-oakley@users.noreply.github.com>
Date: Mon, 28 Sep 2026 23:06:44 -0700
Subject: [PATCH 1/7] trusty: build on Linux 7.3 (void remove, virtqueue_info,
 map_phys, class_create, DMA_BUF ns, unlocked dma-buf maps, ITER_SOURCE send,
 vmalloc/panic_notifier includes)

---
 trusty/Kbuild               |  5 +++++
 trusty/trusty-ipc.c         | 30 ++++++++++++++++++++----------
 trusty/trusty-irq.c         |  6 ++----
 trusty/trusty-log.c         |  5 +++--
 trusty/trusty-sched-share.c |  1 +
 trusty/trusty-virtio.c      | 23 ++++++++---------------
 trusty/trusty.c             |  3 +--
 7 files changed, 40 insertions(+), 33 deletions(-)
 create mode 100644 trusty/Kbuild

diff --git a/trusty/Kbuild b/trusty/Kbuild
new file mode 100644
index 0000000..29ac33e
--- /dev/null
+++ b/trusty/Kbuild
@@ -0,0 +1,5 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Google's Trusty driver (GS201 kernel), built out of tree for the Pixel 7 Pro.
+ccflags-y += -I$(src) -I$(src)/include -DCONFIG_TRUSTY=1 -DCONFIG_TRUSTY_IRQ=1
+obj-m += trusty-core.o trusty-log.o trusty-virtio.o trusty-ipc.o
+trusty-core-y := trusty.o trusty-mem.o trusty-sched-share.o trusty-smc-arm64.o trusty-irq.o
diff --git a/trusty/trusty-ipc.c b/trusty/trusty-ipc.c
index 83df24e..517c74f 100644
--- a/trusty/trusty-ipc.c
+++ b/trusty/trusty-ipc.c
@@ -16,6 +16,8 @@
 #include <linux/sched.h>
 #include <linux/sched/signal.h>
 #include <linux/compat.h>
+#include <linux/string.h>
+#include <linux/string.h>
 #include <linux/uio.h>
 #include <linux/file.h>
 
@@ -688,7 +690,7 @@ static int tipc_shared_handle_drop(struct tipc_shared_handle *shared_handle)
 	}
 
 	if (shared_handle->sgt)
-		dma_buf_unmap_attachment(shared_handle->attach,
+		dma_buf_unmap_attachment_unlocked(shared_handle->attach,
 					 shared_handle->sgt, DMA_BIDIRECTIONAL);
 	if (shared_handle->attach)
 		dma_buf_detach(shared_handle->dma_buf, shared_handle->attach);
@@ -813,7 +815,7 @@ int tipc_chan_connect(struct tipc_chan *chan, const char *name)
 	msg->type = TIPC_CTRL_MSGTYPE_CONN_REQ;
 	msg->body_len  = sizeof(*body);
 
-	strncpy(body->name, name, sizeof(body->name));
+	strscpy_pad(body->name, name, sizeof(body->name));
 	body->name[sizeof(body->name)-1] = '\0';
 
 	mutex_lock(&chan->lock);
@@ -1240,7 +1242,7 @@ static int dn_share_fd(struct tipc_dn_chan *dn, int fd,
 		goto cleanup_handle;
 	}
 
-	shared_handle->sgt = dma_buf_map_attachment(shared_handle->attach,
+	shared_handle->sgt = dma_buf_map_attachment_unlocked(shared_handle->attach,
 						    DMA_BIDIRECTIONAL);
 	if (IS_ERR(shared_handle->sgt)) {
 		ret = PTR_ERR(shared_handle->sgt);
@@ -1362,7 +1364,8 @@ static long filp_send_ioctl(struct file *filp,
 		goto load_shm_args_failed;
 	}
 
-	ret = import_iovec(READ, u64_to_user_ptr(req.iov), req.iov_cnt,
+	/* The send path copies from these buffers: a source iterator. */
+	ret = import_iovec(ITER_SOURCE, u64_to_user_ptr(req.iov), req.iov_cnt,
 			   ARRAY_SIZE(fast_iovs), &iov, &iter);
 	if (ret < 0) {
 		dev_dbg(dev, "Failed to import iovec\n");
@@ -2123,8 +2126,10 @@ static int tipc_virtio_probe(struct virtio_device *vdev)
 	struct tipc_virtio_dev *vds;
 	struct tipc_dev_config config;
 	struct virtqueue *vqs[2];
-	vq_callback_t *vq_cbs[] = {_rxvq_cb, _txvq_cb};
-	static const char * const vq_names[] = { "rx", "tx" };
+	struct virtqueue_info vqs_info[] = {
+		{ "rx", _rxvq_cb },
+		{ "tx", _txvq_cb },
+	};
 
 	vds = kzalloc(sizeof(*vds), GFP_KERNEL);
 	if (!vds)
@@ -2151,12 +2156,11 @@ static int tipc_virtio_probe(struct virtio_device *vdev)
 	vdev->config->get(vdev, 0, &config, sizeof(config));
 
 	/* copy dev name */
-	strncpy(vds->cdev_name, config.dev_name, sizeof(vds->cdev_name));
+	strscpy_pad(vds->cdev_name, config.dev_name, sizeof(vds->cdev_name));
 	vds->cdev_name[sizeof(vds->cdev_name)-1] = '\0';
 
 	/* find tx virtqueues (rx and tx and in this order) */
-	err = vdev->config->find_vqs(vdev, 2, vqs, vq_cbs, vq_names, NULL,
-				     NULL);
+	err = vdev->config->find_vqs(vdev, 2, vqs, vqs_info, NULL);
 	if (err)
 		goto err_find_vqs;
 
@@ -2221,6 +2225,11 @@ static void tipc_virtio_remove(struct virtio_device *vdev)
 	kref_put(&vds->refcount, _free_vds);
 }
 
+/* Android's virtio ID for Trusty IPC; not in mainline's virtio_ids.h. */
+#ifndef VIRTIO_ID_TRUSTY_IPC
+#define VIRTIO_ID_TRUSTY_IPC 13
+#endif
+
 static const struct virtio_device_id tipc_virtio_id_table[] = {
 	{ VIRTIO_ID_TRUSTY_IPC, VIRTIO_DEV_ANY_ID },
 	{ 0 },
@@ -2252,7 +2261,7 @@ static int __init tipc_init(void)
 	}
 
 	tipc_major = MAJOR(dev);
-	tipc_class = class_create(THIS_MODULE, KBUILD_MODNAME);
+	tipc_class = class_create(KBUILD_MODNAME);
 	if (IS_ERR(tipc_class)) {
 		ret = PTR_ERR(tipc_class);
 		pr_err("%s: class_create failed: %d\n", __func__, ret);
@@ -2292,3 +2301,4 @@ module_exit(tipc_exit);
 MODULE_DEVICE_TABLE(tipc, tipc_virtio_id_table);
 MODULE_DESCRIPTION("Trusty IPC driver");
 MODULE_LICENSE("GPL v2");
+MODULE_IMPORT_NS("DMA_BUF");
diff --git a/trusty/trusty-irq.c b/trusty/trusty-irq.c
index caa24ef..331440a 100644
--- a/trusty/trusty-irq.c
+++ b/trusty/trusty-irq.c
@@ -566,7 +566,7 @@ err_alloc_is:
 	return ret;
 }
 
-static int trusty_irq_remove(struct platform_device *pdev)
+static void trusty_irq_remove(struct platform_device *pdev)
 {
 	int ret;
 	unsigned long irq_flags;
@@ -575,7 +575,7 @@ static int trusty_irq_remove(struct platform_device *pdev)
 	ret = cpuhp_state_remove_instance(trusty_irq_cpuhp_slot,
 					  &is->cpuhp_node);
 	if (WARN_ON(ret))
-		return ret;
+		return;
 
 	spin_lock_irqsave(&is->normal_irqs_lock, irq_flags);
 	trusty_irq_disable_irqset(is, &is->normal_irqs);
@@ -587,8 +587,6 @@ static int trusty_irq_remove(struct platform_device *pdev)
 					&is->trusty_call_notifier);
 	free_percpu(is->percpu_irqs);
 	kfree(is);
-
-	return 0;
 }
 
 static const struct of_device_id trusty_test_of_match[] = {
diff --git a/trusty/trusty-log.c b/trusty/trusty-log.c
index 79948ee..a543db7 100644
--- a/trusty/trusty-log.c
+++ b/trusty/trusty-log.c
@@ -2,7 +2,9 @@
 /*
  * Copyright (C) 2015 Google, Inc.
  */
+#include <linux/panic_notifier.h>
 #include <linux/platform_device.h>
+#include <linux/vmalloc.h>
 #include <linux/trusty/smcall.h>
 #include <linux/trusty/trusty.h>
 #include <linux/notifier.h>
@@ -916,13 +918,12 @@ static int trusty_log_probe(struct platform_device *pdev)
 	return rc;
 }
 
-static int trusty_log_remove(struct platform_device *pdev)
+static void trusty_log_remove(struct platform_device *pdev)
 {
 	struct trusty_log_state *s = platform_get_drvdata(pdev);
 
 	trusty_log_sfile_unregister(s);
 	kref_put(&s->refcount, trusty_log_cleanup);
-	return 0;
 }
 
 static void trusty_log_cleanup(struct kref *ref)
diff --git a/trusty/trusty-sched-share.c b/trusty/trusty-sched-share.c
index 07e6231..05f43ad 100644
--- a/trusty/trusty-sched-share.c
+++ b/trusty/trusty-sched-share.c
@@ -9,6 +9,7 @@
 
 #include <linux/device.h>
 #include <linux/slab.h>
+#include <linux/vmalloc.h>
 #include <linux/scatterlist.h>
 #include <linux/trusty/trusty.h>
 #include "trusty-sched-share.h"
diff --git a/trusty/trusty-virtio.c b/trusty/trusty-virtio.c
index 2df10d1..2f22d02 100644
--- a/trusty/trusty-virtio.c
+++ b/trusty/trusty-virtio.c
@@ -409,20 +409,15 @@ err_share_memory:
 
 static int trusty_virtio_find_vqs(struct virtio_device *vdev, unsigned int nvqs,
 				  struct virtqueue *vqs[],
-				  vq_callback_t *callbacks[],
-				  const char * const names[],
-				  const bool *ctxs,
+				  struct virtqueue_info vqs_info[],
 				  struct irq_affinity *desc)
 {
 	unsigned int i;
 	int ret;
-	bool ctx = false;
 
 	for (i = 0; i < nvqs; i++) {
-		ctx = false;
-		if (ctxs)
-			ctx = ctxs[i];
-		vqs[i] = _find_vq(vdev, i, callbacks[i], names[i], ctx);
+		vqs[i] = _find_vq(vdev, i, vqs_info[i].callback, vqs_info[i].name,
+				  vqs_info[i].ctx);
 		if (IS_ERR(vqs[i])) {
 			ret = PTR_ERR(vqs[i]);
 			_del_vqs(vdev);
@@ -704,19 +699,18 @@ err_share_memory:
 	return ret;
 }
 
-static dma_addr_t trusty_virtio_dma_map_page(struct device *dev,
-					     struct page *page,
-					     unsigned long offset, size_t size,
+static dma_addr_t trusty_virtio_dma_map_phys(struct device *dev,
+					     phys_addr_t phys, size_t size,
 					     enum dma_data_direction dir,
 					     unsigned long attrs)
 {
-	struct tipc_msg_buf *buf = page_to_virt(page) + offset;
+	struct tipc_msg_buf *buf = phys_to_virt(phys);
 
 	return buf->buf_id;
 }
 
 static const struct dma_map_ops trusty_virtio_dma_map_ops = {
-	.map_page = trusty_virtio_dma_map_page,
+	.map_phys = trusty_virtio_dma_map_phys,
 };
 
 static int trusty_virtio_probe(struct platform_device *pdev)
@@ -772,7 +766,7 @@ err_create_check_wq:
 	return ret;
 }
 
-static int trusty_virtio_remove(struct platform_device *pdev)
+static void trusty_virtio_remove(struct platform_device *pdev)
 {
 	struct trusty_ctx *tctx = platform_get_drvdata(pdev);
 	int ret;
@@ -809,7 +803,6 @@ static int trusty_virtio_remove(struct platform_device *pdev)
 
 	/* free context */
 	kfree(tctx);
-	return 0;
 }
 
 static const struct of_device_id trusty_of_match[] = {
