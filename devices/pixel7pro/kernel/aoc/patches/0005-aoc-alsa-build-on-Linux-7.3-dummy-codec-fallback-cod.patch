 		if (ret == -EPROBE_DEFER) {
 			pr_info("%s: wait cpu_dai for %s", __func__, dai->name);
@@ -1137,6 +1164,19 @@ static int of_parse_dai_codec(struct device *dev,
 
 	ret = snd_soc_of_get_dai_link_codecs(dev, of_codec_root, dai);
 	of_node_put(of_codec_root);
+	/*
+	 * Pixel 7 Pro port: the amplifier and haptics codecs may not have a
+	 * driver yet. Rather than hold the whole card back, give their links
+	 * the dummy codec; the AoC-side endpoints (microphones included) work
+	 * without them. Reload the card once a codec binds.
+	 */
+	if (ret == -EPROBE_DEFER && aoc_missing_codecs_dummy) {
+		pr_warn("%s: codec for %s not registered; using the dummy codec\n",
+			__func__, dai->name);
+		dai->codecs = &null_component;
+		dai->num_codecs = 1;
+		ret = 0;
+	}
 	return ret;
 }
 
