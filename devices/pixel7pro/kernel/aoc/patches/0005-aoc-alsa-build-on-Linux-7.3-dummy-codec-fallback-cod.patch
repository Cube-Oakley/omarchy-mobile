 			break;
 		default:
 			dai->trigger[0] = SND_SOC_DPCM_TRIGGER_PRE;
@@ -1225,15 +1266,17 @@ static int of_parse_one_dai(struct device_node *node, struct device *dev,
 
 	daifmt = of_get_child_by_name(node, "daifmt");
