+# SPDX-License-Identifier: GPL-2.0-only
+# Google's AOC ALSA/ASoC driver (android-gs-pantah-5.10-android14) for the Pixel 7 Pro (GS201).
+ccflags-y += -I$(src) -I$(src)/.. -I$(src)/../../aoc-ipc -I$(src)/../../stubs/include \
