+/*
+ * GS201: the RISC reaches memory only above its firmware, the bottom of the
+ * codec's CMA area. When that area is full the DMA API takes any other pages
+ * instead (dma-direct's fallback); the firmware fails on a buffer below its
+ * base (October 8: ERR 0x37 mid-stream, the instance lost). Such a buffer is
+ * refused, so allocation fails where the client sees it.
+ */
+static int s5p_mfc_check_reach(struct s5p_mfc_ctx *ctx, struct vb2_buffer *vb)
+{
+	struct s5p_mfc_dev *dev = ctx->dev;
+	unsigned int i;
+
+	if (!IS_GS201(dev))
+		return 0;
+	for (i = 0; i < vb->num_planes; i++) {
+		dma_addr_t addr = vb2_dma_contig_plane_dma_addr(vb, i);
+
+		if (addr < dev->mem_base) {
+			mfc_err_limited("Buffer %pad below the firmware (%pad): the codec's CMA area is full\n",
+					&addr, &dev->mem_base);
+			return -ENOMEM;
+		}
+	}
+	return 0;
+}
