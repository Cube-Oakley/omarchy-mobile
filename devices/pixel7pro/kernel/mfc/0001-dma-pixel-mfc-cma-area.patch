 }
 early_param("cma", early_cma);
 
+/*
+ * pixel_mfc_cma=SIZE: a CMA area of its own, below 4 GiB, for the Pixel 7
+ * Pro's video codec (GS201's MFC v15.6, driven by s5p-mfc without its
+ * SysMMU). The codec's RISC addresses memory upward from its firmware's
+ * base: a context buffer below the firmware failed SYS_INIT. So the driver
+ * gives its device this area (dev->cma_area) and allocates the firmware
+ * first, at the area's bottom; every later buffer lands above it.
+ */
+static phys_addr_t pixel_mfc_cma_size __initdata;
+struct cma *pixel_mfc_cma_area;
+EXPORT_SYMBOL_GPL(pixel_mfc_cma_area);
+
+static int __init early_pixel_mfc_cma(char *p)
+{
+	if (p)
+		pixel_mfc_cma_size = memparse(p, &p);
+	return 0;
+}
+early_param("pixel_mfc_cma", early_pixel_mfc_cma);
+
 struct cma *dev_get_cma_area(struct device *dev)
 {
 	if (dev && dev->cma_area)
@@ -254,6 +274,11 @@ void __init dma_contiguous_reserve(phys_addr_t limit)
 	phys_addr_t selected_limit = limit;
 	bool fixed = false;
 
+	if (pixel_mfc_cma_size &&
+	    cma_declare_contiguous(0, pixel_mfc_cma_size, SZ_4G, 0, 0, false,
+				   "pixel-mfc", &pixel_mfc_cma_area))
+		pr_err("pixel_mfc_cma: could not reserve %pa\n", &pixel_mfc_cma_size);
+
