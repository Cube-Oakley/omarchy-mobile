+/*
+ * GS201: the MFC power domain has no genpd here. pixel-pd-off (the Pixel
+ * tree's kernel/pd) powers it with its stock save list, context SMC and
+ * S2MPU restore: on for the first instance, off after the last, so the
+ * codec draws nothing between videos. Found at probe, not linked: without
+ * the module (or with one built before its MFC list) the domain stays as
+ * the boot left it, and the codec is refused if that is off, since MMIO to
+ * a powered-off block hangs the SoC.
+ */
+#define GS201_PMU_MFC_STATUS	0x18062384
+static int (*gs201_pd_power)(const char *name, bool on);
+
+static bool s5p_mfc_gs201_domain_is_on(void)
+{
+	void __iomem *status = ioremap(GS201_PMU_MFC_STATUS, 4);
+	bool on;
+
+	if (!status)
+		return false;
+	on = readl(status) & BIT(0);
+	iounmap(status);
+	return on;
+}
+
+int s5p_mfc_gs201_power(struct s5p_mfc_dev *dev, bool on)
+{
+	int ret;
+
+	if (!IS_GS201(dev))
+		return 0;
+	if (!gs201_pd_power) {
+		if (on && !s5p_mfc_gs201_domain_is_on()) {
+			mfc_err("the MFC domain is off and nothing can power it on\n");
+			return -ENODEV;
+		}
+		return 0;
+	}
+	ret = gs201_pd_power("mfc", on);
+	if (ret)
+		mfc_err("MFC domain did not power %s (%d)\n", on ? "on" : "off", ret);
+	return ret;
+}
+
+int s5p_mfc_gs201_init_power(struct s5p_mfc_dev *dev)
+{
+	if (!IS_GS201(dev))
+		return 0;
+	gs201_pd_power = __symbol_get("pixel_pd_power");
+	if (gs201_pd_power && gs201_pd_power("mfc", false)) {
+		symbol_put_addr(gs201_pd_power);
+		gs201_pd_power = NULL;
+	}
+	if (gs201_pd_power)
+		return 0;	/* off until the first instance */
+	if (!s5p_mfc_gs201_domain_is_on()) {
+		mfc_err("the MFC domain is off and pixel-pd-off cannot power it on\n");
+		return -ENODEV;
+	}
+	mfc_err("no MFC power control (pixel-pd-off): the domain stays on\n");
+	return 0;
+}
+
+void s5p_mfc_gs201_final_power(struct s5p_mfc_dev *dev)
+{
+	if (!gs201_pd_power)
+		return;
+	symbol_put_addr(gs201_pd_power);
+	gs201_pd_power = NULL;
+}
