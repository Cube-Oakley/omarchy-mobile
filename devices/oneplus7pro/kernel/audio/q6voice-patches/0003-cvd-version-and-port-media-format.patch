diff -ruN a/q6voice-common.c b/q6voice-common.c
--- a/q6voice-common.c	2026-09-27 11:13:05.179929320 -0700
+++ b/q6voice-common.c	2026-09-27 11:13:05.196867793 -0700
@@ -8,6 +8,8 @@
 #include "q6voice-common.h"
 
 #define APRV2_IBASIC_CMD_DESTROY_SESSION	0x0001003C
+#define VSS_IVERSION_CMD_GET			0x00011378
+#define VSS_IVERSION_RSP_GET			0x00011379
 
 #define TIMEOUT_MS	300
 
@@ -167,6 +169,19 @@
 	struct aprv2_ibasic_rsp_result_t *result = data->payload;
 	unsigned long flags;
 
+	if (data->hdr.opcode == VSS_IVERSION_RSP_GET) {
+		spin_lock_irqsave(&s->lock, flags);
+		if (s->expected_opcode == VSS_IVERSION_CMD_GET) {
+			memcpy(s->version, data->payload,
+			       min_t(size_t, max(data->payload_size, 0), sizeof(s->version) - 1));
+			s->result = 0;
+			s->expected_opcode = 0;
+		}
+		spin_unlock_irqrestore(&s->lock, flags);
+		wake_up(&s->wait);
+		return;
+	}
+
 	if (data->hdr.opcode != APR_BASIC_RSP_RESULT)
 		return; /* Not handled here */
 
@@ -230,7 +245,7 @@
 }
 EXPORT_SYMBOL_GPL(q6voice_common_callback);
 
-int q6voice_common_send(struct q6voice_session *s, struct apr_hdr *hdr)
+static int q6voice_send(struct q6voice_session *s, struct apr_hdr *hdr, u16 dest)
 {
 	unsigned long flags;
 	int ret;
@@ -238,7 +253,7 @@
 	hdr->hdr_field = APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
 				       APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
 	hdr->src_port = s->port;
-	hdr->dest_port = s->handle;
+	hdr->dest_port = dest;
 	hdr->token = 0;
 
 	spin_lock_irqsave(&s->lock, flags);
@@ -265,8 +280,30 @@
 
 	return 0;
 }
+
+int q6voice_common_send(struct q6voice_session *s, struct apr_hdr *hdr)
+{
+	return q6voice_send(s, hdr, s->handle);
+}
 EXPORT_SYMBOL_GPL(q6voice_common_send);
 
+/* The service's CVD version ("2.3"), as downstream asks it: not a session command. */
+int q6voice_common_get_version(struct q6voice_session *s, char *buf, size_t len)
+{
+	struct apr_pkt cmd = {};
+	int ret;
+
+	cmd.hdr.pkt_size = APR_HDR_SIZE;
+	cmd.hdr.opcode = VSS_IVERSION_CMD_GET;
+	memset(s->version, 0, sizeof(s->version));
+
+	ret = q6voice_send(s, &cmd.hdr, 0);
+	if (!ret)
+		strscpy(buf, s->version, len);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(q6voice_common_get_version);
+
