-	cmd.param_data.media_format_info.channel_mapping[7] = 0;
+	cmd.param_data.media_format_info.num_channels = clamp(port_channels, 1, VSS_NUM_CHANNELS_MAX);
+	cmd.param_data.media_format_info.bits_per_sample = port_bits;
+	cmd.param_data.media_format_info.sample_rate = port_rate;
+	memset(cmd.param_data.media_format_info.channel_mapping, 0,
