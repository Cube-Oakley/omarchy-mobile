diff --git i/router/watch.c w/router/watch.c
index 21ea4c4..e9935c0 100644
--- i/router/watch.c
+++ w/router/watch.c
@@ -202,6 +202,21 @@ static int watch_free_write_aio(struct mbuf *mbuf, void *data)
 	return 0;
 }
 
+/* Drop every buffer still queued for a writer that went away, returning
+ * each one's flow credit so the peripheral it came from is not stalled. */
+void watch_purge_queue(struct list_head *queue)
+{
+	struct list_head *item;
+	struct list_head *next;
+	struct mbuf *mbuf;
+
+	list_for_each_safe(item, next, queue) {
+		mbuf = container_of(item, struct mbuf, node);
+		list_del(&mbuf->node);
+		watch_free_write_aio(mbuf, NULL);
+	}
+}
