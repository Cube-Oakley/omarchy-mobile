diff --git i/router/dm.c w/router/dm.c
index 94e174c..3a7c78e 100644
--- i/router/dm.c
+++ w/router/dm.c
@@ -111,6 +111,22 @@ static int dm_recv_hdlc(struct diag_client *dm, struct circ_buf *buf)
 	return 0;
 }
 
+/* A client that went away must leave the broadcast list: its queue would
+ * otherwise keep growing and hold the peripherals' flow control shut. */
+static void dm_remove(struct diag_client *dm)
+{
+	watch_remove_fd(dm->in_fd);
+	if (dm->out_fd != dm->in_fd)
+		watch_remove_writeq(dm->out_fd);
+	list_del(&dm->node);
+	watch_purge_queue(&dm->outq);
+	close(dm->in_fd);
+	if (dm->out_fd != dm->in_fd)
+		close(dm->out_fd);
+	free((void *)dm->name);
+	free(dm);
+}
