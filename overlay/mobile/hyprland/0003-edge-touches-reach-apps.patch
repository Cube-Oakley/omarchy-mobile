+// The shell's edge strips (Omarchy Mobile), as Android's gestures: a touch
+// that lands in one goes to what is under it, so taps and scrolls at the edges
+// reach the app. Once it moves inward like a swipe from that edge, the app
+// gets wl_touch.cancel and the strip gets the touch, from where it landed.
+// A strip's input region is where its swipe may start.
+extern Desktop::View::CLayerSurface* g_omarchyHitTestSkip; // ViewHitTester.cpp
+
+namespace {
+    // The strips' layer names and the way into the screen from each.
+    struct SEdgeStrip {
+        const char* name;
+        Vector2D    inward;
+    };
+    const SEdgeStrip EDGE_STRIPS[] = {
+        {"omarchy-mobile-back", {1, 0}},        // back, from the left
+        {"omarchy-mobile-back-right", {-1, 0}}, // back, from the right
+        {"omarchy-mobile-navigation", {0, -1}}, // home and the switcher, from the bottom
+    };
+    // Inward travel that makes it the strip's swipe, if it is also this much
+    // more than the travel across; travel across that leaves it to the app
+    // (logical px).
+    constexpr double EDGE_CLAIM = 12;
+    constexpr double EDGE_SLANT = 1.2;
+    constexpr double EDGE_DROP  = 16;
+
+    struct {
+        bool     active = false;
+        int32_t  id     = -1;
+        Vector2D start;
+        Vector2D inward;
+        PHLLSREF layer;
+    } s_edge;
+
+    // A touch a strip has taken over is the gesture's to its end: its events
+    // skip the event bus. Through it, every motion after the takeover came
+    // back cancelled (the bus's only touch listener is drag and drop, which
+    // never ran), and the strip saw the touch stand still.
+    struct {
+        bool    active = false;
+        int32_t id     = -1;
+    } s_claimed;
+
+    // The strip that is the topmost overlay surface at coords, if any.
+    PHLLS edgeStripAt(PHLMONITOR monitor, const Vector2D& coords, Vector2D* inward) {
+        PHLLS    found;
+        Vector2D local;
+        if (!Desktop::viewState()->hitTest().layerSurfaceAt(coords, &monitor->m_layerSurfaceLayers[ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY], &local, &found) || !found)
+            return nullptr;
+        for (auto const& strip : EDGE_STRIPS) {
+            if (found->m_namespace == strip.name) {
+                *inward = strip.inward;
+                return found;
+            }
+        }
+        return nullptr;
+    }
+}
 
