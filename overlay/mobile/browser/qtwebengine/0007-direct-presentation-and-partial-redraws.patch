+// Direct presentation (Omarchy Mobile patch) is for a window asking for it
+// (the dynamic property `_q_webengine_direct`) with an alpha channel, and a
+// page item that is not a popup, faded, scaled or rotated.
+bool RenderWidgetHostViewQtDelegateItem::directRect(QQuickWindow *win, QRectF *rect) const
+{
+    if (m_isPopup || !win || !isVisible() || win->format().alphaBufferSize() <= 0
+        || !win->property("_q_webengine_direct").toBool())
+        return false;
+    qreal opacity = 1;
+    for (const QQuickItem *item = this; item; item = item->parentItem())
+        opacity *= item->opacity();
+    if (opacity < 1 || itemTransform(nullptr, nullptr).type() > QTransform::TxTranslate)
+        return false;
+    const QRectF scene = mapRectToScene(QRectF(0, 0, width(), height()));
+    if (scene.width() < 1 || scene.height() < 1)
+        return false;
+    *rect = QRectF(QPointF(qRound(scene.x()), qRound(scene.y())),
+                   QSizeF(qRound(scene.width()), qRound(scene.height())));
+    return true;
+}
+
+// The sub-surface goes at once (the item is hidden or leaves its window).
+void RenderWidgetHostViewQtDelegateItem::stopDirect()
+{
+    if (auto comp = compositor()) {
+        if (comp->type() == Compositor::Type::Native)
+            comp->setDirect(nullptr, true);
+    }
 }
 
