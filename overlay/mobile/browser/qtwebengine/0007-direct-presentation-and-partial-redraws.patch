+// Direct presentation (Omarchy Mobile patch) --------------------------------
+//
+// Qt Quick redraws its whole window for every frame Chromium hands it, and
+// the Wayland compositor then recomposes the whole window: when a page
+// changed a few pixels, Chromium, Qt and the compositor each redrew the full
+// screen (a 57-pixel animation cost as much GPU and memory power as a
+// full-screen one on a Pixel 7 Pro, October 7). Here the frames go to the
+// compositor as a sub-surface below Qt's window, which shows them through a
+// transparent hole, each with the area that changed; Chromium redraws only
+// that area of its buffer, and Qt draws nothing at all for a page's frames.
+//
+// libwayland-client is the one Qt's Wayland plugin loaded (this library does
+// not link it), looked up at run time. The protocol objects live on an event
+// queue of their own, read by a thread here that also waits for each frame's
+// GPU work; their events are handed to Chromium's GPU thread.
+namespace {
+
+enum DirectEventKind { kFrameDone, kBufferReleased, kFenceSignaled };
+
+// Request opcodes, from the protocols' XML.
+constexpr uint32_t kDisplayGetRegistry = 1;
+constexpr uint32_t kRegistryBind = 0;
+constexpr uint32_t kCompositorCreateSurface = 0;
+constexpr uint32_t kCompositorCreateRegion = 1;
+constexpr uint32_t kSubcompositorGetSubsurface = 1;
+constexpr uint32_t kSurfaceDestroy = 0;
+constexpr uint32_t kSurfaceAttach = 1;
+constexpr uint32_t kSurfaceFrame = 3;
+constexpr uint32_t kSurfaceSetOpaqueRegion = 4;
+constexpr uint32_t kSurfaceSetInputRegion = 5;
+constexpr uint32_t kSurfaceCommit = 6;
+constexpr uint32_t kSurfaceDamageBuffer = 9;
+constexpr uint32_t kSubsurfaceDestroy = 0;
+constexpr uint32_t kSubsurfaceSetPosition = 1;
+constexpr uint32_t kSubsurfacePlaceBelow = 3;
+constexpr uint32_t kSubsurfaceSetDesync = 5;
+constexpr uint32_t kRegionDestroy = 0;
+constexpr uint32_t kRegionAdd = 1;
+constexpr uint32_t kBufferDestroy = 0;
+constexpr uint32_t kDmabufCreateParams = 1;
+constexpr uint32_t kParamsDestroy = 0;
+constexpr uint32_t kParamsAdd = 1;
+constexpr uint32_t kParamsCreateImmed = 3;
+constexpr uint32_t kViewporterGetViewport = 1;
+constexpr uint32_t kViewportDestroy = 0;
+constexpr uint32_t kViewportSetSource = 1;
+constexpr uint32_t kViewportSetDestination = 2;
+constexpr uint32_t kMarshalFlagDestroy = 1;
+
+// zwp_linux_dmabuf_v1 (version 3) and wp_viewporter, as wayland-scanner
+// would write them; the core interfaces they name are filled in at load.
+const wl_interface *g_noTypes[6] = {};
+const wl_interface *g_createParamsTypes[1];
+const wl_interface *g_createImmedTypes[5];
+const wl_interface *g_createdTypes[1];
+const wl_interface *g_getViewportTypes[2];
+const wl_message g_dmabufRequests[] = {
+    { "destroy", "", g_noTypes },
+    { "create_params", "n", g_createParamsTypes },
+};
+const wl_message g_dmabufEvents[] = {
+    { "format", "u", g_noTypes },
+    { "modifier", "3uuu", g_noTypes },
+};
+const wl_interface g_dmabufInterface = { "zwp_linux_dmabuf_v1", 3, 2, g_dmabufRequests, 2, g_dmabufEvents };
+const wl_message g_paramsRequests[] = {
+    { "destroy", "", g_noTypes },
+    { "add", "huuuuu", g_noTypes },
+    { "create", "iiuu", g_noTypes },
+    { "create_immed", "2niiuu", g_createImmedTypes },
+};
+const wl_message g_paramsEvents[] = {
+    { "created", "n", g_createdTypes },
+    { "failed", "", g_noTypes },
+};
+const wl_interface g_paramsInterface = { "zwp_linux_buffer_params_v1", 3, 4, g_paramsRequests, 2, g_paramsEvents };
+const wl_message g_viewporterRequests[] = {
+    { "destroy", "", g_noTypes },
+    { "get_viewport", "no", g_getViewportTypes },
+};
+const wl_interface g_viewporterInterface = { "wp_viewporter", 1, 2, g_viewporterRequests, 0, nullptr };
+const wl_message g_viewportRequests[] = {
+    { "destroy", "", g_noTypes },
+    { "set_source", "ffff", g_noTypes },
+    { "set_destination", "ii", g_noTypes },
+};
+const wl_interface g_viewportInterface = { "wp_viewport", 1, 3, g_viewportRequests, 0, nullptr };
+
+// Which device and buffer an event is for (a listener's data).
+struct DirectTag
+{
+    uint64_t device;
+    uint64_t serial;
+};
+
+class WaylandDirect
+{
+public:
+    using Handler = void (*)(uint64_t device, int kind, uint64_t serial);
+
+    // The process's one, made on first use; null when the compositor lacks
+    // something it needs.
+    static WaylandDirect *instance(wl_display *display,
+                                   scoped_refptr<base::SingleThreadTaskRunner> runner,
+                                   Handler handler)
+    {
+        static QMutex mutex;
+        static WaylandDirect *direct = nullptr;
+        static bool tried = false;
+        QMutexLocker locker(&mutex);
+        if (!tried) {
+            tried = true;
+            auto *candidate = new WaylandDirect;
+            if (candidate->initialize(display, std::move(runner), handler)) {
+                direct = candidate;
+                s_instance.store(direct);
+                qInfo("webengine: frames go to the compositor directly (sub-surface)");
+            } else {
+                qWarning("webengine: direct presentation unavailable, Qt draws the frames");
+            }
+        }
+        return direct;
+    }
+    static WaylandDirect *existing() { return s_instance.load(); }
+
+    // A request with no new object, or one making `iface`.
+    template<typename... Args>
+    wl_proxy *call(wl_proxy *proxy, uint32_t opcode, const wl_interface *iface, Args... args)
+    {
+        return m_wl.marshalFlags(proxy, opcode, iface, m_wl.getVersion(proxy), 0, args...);
+    }
+    void listen(wl_proxy *proxy, const void *listener, void *data)
+    {
+        m_wl.addListener(proxy, reinterpret_cast<void (**)(void)>(const_cast<void *>(listener)), data);
+    }
+    void flush() { m_wl.flush(m_display); }
+    // An object with no events, destroyed at once.
+    void destroyNow(wl_proxy *proxy, uint32_t destructor)
+    {
+        m_wl.marshalFlags(proxy, destructor, nullptr, m_wl.getVersion(proxy), kMarshalFlagDestroy);
+    }
+    bool supports(uint32_t format, uint64_t modifier) const
+    {
+        return m_formats.count({ format, modifier }) > 0;
+    }
+    const wl_interface *bufferInterface() const { return m_wl.buffer; }
+    const wl_interface *callbackInterface() const { return m_wl.callback; }
+    const wl_interface *surfaceInterface() const { return m_wl.surface; }
+    const wl_interface *subsurfaceInterface() const { return m_wl.subsurface; }
+    const wl_interface *regionInterface() const { return m_wl.region; }
+    wl_proxy *compositor() const { return m_compositor; }
+    wl_proxy *subcompositor() const { return m_subcompositor; }
+    wl_proxy *dmabuf() const { return m_dmabuf; }
+    wl_proxy *viewporter() const { return m_viewporter; }
+
+    // A frame callback whose done event is handed to the GPU thread.
+    void requestFrame(wl_proxy *surface, uint64_t device)
+    {
+        static const struct
+        {
+            void (*done)(void *, wl_proxy *, uint32_t);
+        } listener = { [](void *data, wl_proxy *callback, uint32_t) {
+            auto *tag = static_cast<DirectTag *>(data);
+            WaylandDirect *self = existing();
+            self->post(tag->device, kFrameDone, 0);
+            self->m_wl.proxyDestroy(callback);
+            delete tag;
+        } };
+        wl_proxy *callback = call(surface, kSurfaceFrame, m_wl.callback, nullptr);
+        listen(callback, &listener, new DirectTag{ device, 0 });
+    }
+    void listenForRelease(wl_proxy *buffer, DirectTag *tag)
+    {
+        static const struct
+        {
+            void (*release)(void *, wl_proxy *);
+        } listener = { [](void *data, wl_proxy *) {
+            auto *tag = static_cast<DirectTag *>(data);
+            existing()->post(tag->device, kBufferReleased, tag->serial);
+        } };
+        listen(buffer, &listener, tag);
+    }
+
+    // Destroys an object on the thread reading its events, so that no event
+    // is handled for it afterwards (`destructor` is its destroy request's
+    // opcode, or -1); `tag`, its listener's data, goes with it.
+    void destroyLater(wl_proxy *proxy, int destructor, DirectTag *tag = nullptr)
+    {
+        {
+            std::lock_guard<std::mutex> locker(m_commandMutex);
+            m_destroy.push_back({ proxy, destructor, tag });
+        }
+        wake();
+    }
+    // `fd` (a sync file, owned) signals that a buffer's GPU work is done.
+    void watchFence(int fd, uint64_t device, uint64_t serial)
+    {
+        {
+            std::lock_guard<std::mutex> locker(m_commandMutex);
+            m_fences.push_back({ fd, device, serial });
+        }
+        wake();
+    }
+
+private:
+    struct Destroy
+    {
+        wl_proxy *proxy;
+        int destructor;
+        DirectTag *tag;
+    };
+    struct Fence
+    {
+        int fd;
+        uint64_t device;
+        uint64_t serial;
+    };
+    struct Api
+    {
+        wl_proxy *(*marshalFlags)(wl_proxy *, uint32_t, const wl_interface *, uint32_t, uint32_t, ...);
+        int (*addListener)(wl_proxy *, void (**)(void), void *);
+        void (*proxyDestroy)(wl_proxy *);
+        uint32_t (*getVersion)(wl_proxy *);
+        void *(*createWrapper)(void *);
+        void (*wrapperDestroy)(void *);
+        void (*setQueue)(wl_proxy *, wl_event_queue *);
+        wl_event_queue *(*createQueue)(wl_display *);
+        int (*prepareReadQueue)(wl_display *, wl_event_queue *);
+        int (*dispatchQueuePending)(wl_display *, wl_event_queue *);
+        int (*readEvents)(wl_display *);
+        void (*cancelRead)(wl_display *);
+        int (*flush)(wl_display *);
+        int (*getFd)(wl_display *);
+        int (*roundtripQueue)(wl_display *, wl_event_queue *);
+        const wl_interface *registry, *compositor, *subcompositor, *surface, *subsurface, *region,
+                *buffer, *callback;
+    };
+
+    bool load()
+    {
+        void *lib = dlopen("libwayland-client.so.0", RTLD_NOW | RTLD_NOLOAD);
+        if (!lib)
+            return false;
+        bool ok = true;
+        auto get = [&](auto &field, const char *name) {
+            field = reinterpret_cast<std::remove_reference_t<decltype(field)>>(dlsym(lib, name));
+            ok = ok && field;
+        };
+        get(m_wl.marshalFlags, "wl_proxy_marshal_flags");
+        get(m_wl.addListener, "wl_proxy_add_listener");
+        get(m_wl.proxyDestroy, "wl_proxy_destroy");
+        get(m_wl.getVersion, "wl_proxy_get_version");
+        get(m_wl.createWrapper, "wl_proxy_create_wrapper");
+        get(m_wl.wrapperDestroy, "wl_proxy_wrapper_destroy");
+        get(m_wl.setQueue, "wl_proxy_set_queue");
+        get(m_wl.createQueue, "wl_display_create_queue");
+        get(m_wl.prepareReadQueue, "wl_display_prepare_read_queue");
+        get(m_wl.dispatchQueuePending, "wl_display_dispatch_queue_pending");
+        get(m_wl.readEvents, "wl_display_read_events");
+        get(m_wl.cancelRead, "wl_display_cancel_read");
+        get(m_wl.flush, "wl_display_flush");
+        get(m_wl.getFd, "wl_display_get_fd");
+        get(m_wl.roundtripQueue, "wl_display_roundtrip_queue");
+        get(m_wl.registry, "wl_registry_interface");
+        get(m_wl.compositor, "wl_compositor_interface");
+        get(m_wl.subcompositor, "wl_subcompositor_interface");
+        get(m_wl.surface, "wl_surface_interface");
+        get(m_wl.subsurface, "wl_subsurface_interface");
+        get(m_wl.region, "wl_region_interface");
+        get(m_wl.buffer, "wl_buffer_interface");
+        get(m_wl.callback, "wl_callback_interface");
+        if (!ok)
+            return false;
+        g_createParamsTypes[0] = &g_paramsInterface;
+        g_createImmedTypes[0] = m_wl.buffer;
+        g_createdTypes[0] = m_wl.buffer;
+        g_getViewportTypes[0] = &g_viewportInterface;
+        g_getViewportTypes[1] = m_wl.surface;
+        return true;
+    }
+
+    bool initialize(wl_display *display, scoped_refptr<base::SingleThreadTaskRunner> runner,
+                    Handler handler)
+    {
+        if (!display || !runner || !load())
+            return false;
+        m_display = display;
+        m_runner = std::move(runner);
+        m_handler = handler;
+        m_queue = m_wl.createQueue(display);
+        auto *wrapper = static_cast<wl_proxy *>(m_wl.createWrapper(display));
+        if (!m_queue || !wrapper)
+            return false;
+        m_wl.setQueue(wrapper, m_queue);
+        wl_proxy *registry = call(wrapper, kDisplayGetRegistry, m_wl.registry, nullptr);
+        m_wl.wrapperDestroy(wrapper);
+        static const struct
+        {
+            void (*global)(void *, wl_proxy *, uint32_t, const char *, uint32_t);
+            void (*globalRemove)(void *, wl_proxy *, uint32_t);
+        } registryListener = {
+            [](void *data, wl_proxy *registry, uint32_t name, const char *interface, uint32_t version) {
+                auto *self = static_cast<WaylandDirect *>(data);
+                auto bind = [&](const wl_interface *iface, uint32_t want) {
+                    const uint32_t v = std::min(version, want);
+                    return self->m_wl.marshalFlags(registry, kRegistryBind, iface, v, 0, name,
+                                                   iface->name, v, nullptr);
+                };
+                if (!strcmp(interface, "wl_compositor") && version >= 4) {
+                    self->m_compositor = bind(self->m_wl.compositor, 4);
+                } else if (!strcmp(interface, "wl_subcompositor")) {
+                    self->m_subcompositor = bind(self->m_wl.subcompositor, 1);
+                } else if (!strcmp(interface, "wp_viewporter")) {
+                    self->m_viewporter = bind(&g_viewporterInterface, 1);
+                } else if (!strcmp(interface, "zwp_linux_dmabuf_v1") && version >= 3) {
+                    // Version 3 lists the formats and modifiers as events.
+                    self->m_dmabuf = bind(&g_dmabufInterface, 3);
+                    static const struct
+                    {
+                        void (*format)(void *, wl_proxy *, uint32_t);
+                        void (*modifier)(void *, wl_proxy *, uint32_t, uint32_t, uint32_t);
+                    } dmabufListener = {
+                        [](void *, wl_proxy *, uint32_t) {},
+                        [](void *data, wl_proxy *, uint32_t format, uint32_t high, uint32_t low) {
+                            static_cast<WaylandDirect *>(data)->m_formats.insert(
+                                    { format, (uint64_t(high) << 32) | low });
+                        },
+                    };
+                    self->listen(self->m_dmabuf, &dmabufListener, self);
+                }
+            },
+            [](void *, wl_proxy *, uint32_t) {},
+        };
+        listen(registry, &registryListener, this);
+        // Globals, then the formats of the dma-buf global.
+        if (m_wl.roundtripQueue(display, m_queue) < 0 || m_wl.roundtripQueue(display, m_queue) < 0)
+            return false;
+        m_wl.proxyDestroy(registry);
+        if (!m_compositor || !m_subcompositor || !m_viewporter || !m_dmabuf || m_formats.empty())
+            return false;
+        m_wakeFd = eventfd(0, EFD_CLOEXEC | EFD_NONBLOCK);
+        if (m_wakeFd < 0)
+            return false;
+        std::thread(&WaylandDirect::run, this).detach();
+        return true;
+    }
+
+    void wake()
+    {
+        const uint64_t one = 1;
+        [[maybe_unused]] ssize_t written = write(m_wakeFd, &one, sizeof(one));
+    }
+
+    void post(uint64_t device, int kind, uint64_t serial)
+    {
+        m_runner->PostTask(FROM_HERE, base::BindOnce(m_handler, device, kind, serial));
+    }
+
+    // Destroy requests and fence waits from other threads.
+    void runCommands(std::vector<Fence> &fences)
+    {
+        std::vector<Destroy> destroy;
+        {
+            std::lock_guard<std::mutex> locker(m_commandMutex);
+            destroy.swap(m_destroy);
+            fences.insert(fences.end(), m_fences.begin(), m_fences.end());
+            m_fences.clear();
+        }
+        for (const Destroy &d : destroy) {
+            if (d.destructor >= 0)
+                m_wl.marshalFlags(d.proxy, d.destructor, nullptr, m_wl.getVersion(d.proxy),
+                                  kMarshalFlagDestroy);
+            else
+                m_wl.proxyDestroy(d.proxy);
+            delete d.tag;
+        }
+        if (!destroy.empty())
+            m_wl.flush(m_display);
+    }
+
+    void run()
+    {
+        std::vector<Fence> fences;
+        std::vector<pollfd> fds;
+        for (;;) {
+            while (m_wl.prepareReadQueue(m_display, m_queue) != 0)
+                m_wl.dispatchQueuePending(m_display, m_queue);
+            runCommands(fences);
+            m_wl.flush(m_display);
+            fds.assign({ { m_wl.getFd(m_display), POLLIN, 0 }, { m_wakeFd, POLLIN, 0 } });
+            for (const Fence &f : fences)
+                fds.push_back({ f.fd, POLLIN, 0 });
+            if (poll(fds.data(), fds.size(), -1) < 0) {
+                m_wl.cancelRead(m_display);
+                if (errno == EINTR)
+                    continue;
+                qWarning("webengine: direct presentation thread stops: %s", strerror(errno));
+                return;
+            }
+            if (fds[0].revents & (POLLIN | POLLERR | POLLHUP)) {
+                if (m_wl.readEvents(m_display) < 0) {
+                    qWarning("webengine: direct presentation thread stops: the display is gone");
+                    return;
+                }
+            } else {
+                m_wl.cancelRead(m_display);
+            }
+            if (fds[1].revents & POLLIN) {
+                uint64_t count;
+                [[maybe_unused]] ssize_t read_ = read(m_wakeFd, &count, sizeof(count));
+            }
+            // Frames whose GPU work is done.
+            for (size_t i = fences.size(); i-- > 0;) {
+                if (fds[i + 2].revents) {
+                    close(fences[i].fd);
+                    post(fences[i].device, kFenceSignaled, fences[i].serial);
+                    fences.erase(fences.begin() + i);
+                }
+            }
+            m_wl.dispatchQueuePending(m_display, m_queue);
+        }
+    }
+
+    static inline std::atomic<WaylandDirect *> s_instance{ nullptr };
+    Api m_wl{};
+    wl_display *m_display = nullptr;
+    wl_event_queue *m_queue = nullptr;
+    wl_proxy *m_compositor = nullptr, *m_subcompositor = nullptr, *m_dmabuf = nullptr,
+             *m_viewporter = nullptr;
+    std::set<std::pair<uint32_t, uint64_t>> m_formats;
+    scoped_refptr<base::SingleThreadTaskRunner> m_runner;
+    Handler m_handler = nullptr;
+    int m_wakeFd = -1;
+    std::mutex m_commandMutex;
+    std::vector<Destroy> m_destroy;
+    std::vector<Fence> m_fences;
+};
