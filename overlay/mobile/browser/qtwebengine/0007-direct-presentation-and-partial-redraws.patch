+
+void NativeSkiaOutputDevice::directFrameDone()
+{
+    Direct &d = *m_direct;
+    if (!d.framePending)
+        return;
+    d.framePending = false;
+    noteQtFrame();
+    directPresentNext();
+}
+
+void NativeSkiaOutputDevice::directReleased(uint64_t serial)
+{
+    Direct &d = *m_direct;
+    for (auto it = d.held.begin(); it != d.held.end(); ++it) {
+        if ((*it)->serial == serial) {
+            (*it)->onWayland = false;
+            (*it)->endPresent();
+            m_spareBuffers.push_back(std::move(*it));
+            d.held.erase(it);
+            return;
+        }
+    }
+    // Released while still on screen, or after Qt took it back.
+    forEachBuffer([serial](Buffer *buffer) {
+        if (buffer->serial == serial && buffer->onWayland) {
+            buffer->onWayland = false;
+            buffer->endPresent();
+        }
+    });
+}
+
+void NativeSkiaOutputDevice::directFenceSignaled(uint64_t serial)
+{
+    Direct &d = *m_direct;
+    if (!d.fenced || d.fenced->serial != serial)
+        return;
+    directAttach(std::move(d.fenced));
+    directPresentNext();
+}
