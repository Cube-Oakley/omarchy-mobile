+void NativeSkiaOutputDevice::directEvent(uint64_t device, int kind, uint64_t serial)
+{
+    NativeSkiaOutputDevice *self;
+    {
+        QMutexLocker locker(&g_directDevicesMutex);
+        self = g_directDevices.value(device);
+    }
+    // Devices are destroyed on this (the GPU) thread too.
+    if (!self)
+        return;
+    QMutexLocker locker(&self->m_mutex);
+    if (!self->m_direct)
+        return;
+    switch (kind) {
+    case kFrameDone:
+        self->directFrameDone();
+        break;
+    case kBufferReleased:
+        self->directReleased(serial);
+        break;
+    case kFenceSignaled:
+        self->directFenceSignaled(serial);
+        break;
+    }
+}
+
+bool NativeSkiaOutputDevice::setDirect(const DirectTarget *target, bool immediate)
+{
+    QMutexLocker locker(&m_mutex);
+    if (!target) {
+        if (!m_direct)
+            return false;
+        Direct &d = *m_direct;
+        if (d.wanted) {
+            DIRECT_LOG("leave%s\n", immediate ? " (hidden)" : "");
+            d.wanted = false;
+            // A frame still waiting for its GPU work goes back to Qt's queue.
+            if (d.fenced) {
+                d.fenced->endPresent();
+                m_ready.push_front(std::move(d.fenced));
+            }
+            // Qt draws the frame on screen from this frame on (a hold of its
+            // own), and the sub-surface goes once that frame is out.
+            if (m_frontBuffer && !m_readyWithTexture) {
+                m_frontBuffer->beginPresent();
+                m_readyWithTexture = true;
+            }
+            d.hideAfterQtFrame = true;
+        }
+        if (immediate) {
+            directHide();
+            d.hideAfterQtFrame = false;
+        }
+        return false;
+    }
+
+    if (!m_gpuTaskRunner || (m_direct && m_direct->broken))
+        return false;
+    QPlatformNativeInterface *native = QGuiApplication::platformNativeInterface();
+    if (!native || !QGuiApplication::platformName().startsWith(QLatin1String("wayland")))
+        return false;
+    auto *display = static_cast<wl_display *>(native->nativeResourceForIntegration("wl_display"));
+    auto *parent = static_cast<wl_proxy *>(native->nativeResourceForWindow("surface", target->window));
+    if (!display || !parent)
+        return false;
+    if (!m_direct)
+        m_direct = std::make_unique<Direct>();
+    Direct &d = *m_direct;
+    if (!d.wl) {
+        d.wl = WaylandDirect::instance(display, m_gpuTaskRunner, &NativeSkiaOutputDevice::directEvent);
+        if (!d.wl) {
+            d.broken = true;
+            return false;
+        }
+    }
+    WaylandDirect &w = *d.wl;
+
+    // A new window surface (Qt makes one again after a hide): a new
+    // sub-surface below it, placed when Qt next commits its window.
+    if (d.parent != parent) {
+        directTeardown();
+        d.parent = parent;
+        d.surface = w.call(w.compositor(), kCompositorCreateSurface, w.surfaceInterface(), nullptr);
+        d.subsurface = w.call(w.subcompositor(), kSubcompositorGetSubsurface,
+                              w.subsurfaceInterface(), nullptr, d.surface, parent);
+        w.call(d.subsurface, kSubsurfacePlaceBelow, nullptr, parent);
+        DIRECT_LOG("sub-surface for window surface %p\n", static_cast<void *>(parent));
+        w.call(d.subsurface, kSubsurfaceSetDesync, nullptr);
+        d.viewport = w.call(w.viewporter(), kViewporterGetViewport, &g_viewportInterface, nullptr,
+                            d.surface);
+        // Touches go to Qt's window above.
+        wl_proxy *region = w.call(w.compositor(), kCompositorCreateRegion, w.regionInterface(), nullptr);
+        w.call(d.surface, kSurfaceSetInputRegion, nullptr, region);
+        if (!m_requiresAlpha) {
+            wl_proxy *opaque = w.call(w.compositor(), kCompositorCreateRegion, w.regionInterface(), nullptr);
+            w.call(opaque, kRegionAdd, nullptr, 0, 0, 1 << 20, 1 << 20);
+            w.call(d.surface, kSurfaceSetOpaqueRegion, nullptr, opaque);
+            w.destroyNow(opaque, kRegionDestroy);
+        }
+        w.destroyNow(region, kRegionDestroy);
+        d.position = QPoint(INT_MIN, INT_MIN);
+        d.destination = QSize();
+        d.source = QRect();
+    }
+
+    // The position is the window's state: it moves with Qt's next commit,
+    // which comes right after this sync.
+    const QPoint position = target->rect.topLeft().toPoint();
+    if (position != d.position) {
+        w.call(d.subsurface, kSubsurfaceSetPosition, nullptr, position.x(), position.y());
+        d.position = position;
+    }
+    const bool resized = d.rect.size() != target->rect.size();
+    d.rect = target->rect;
+    d.hideAfterQtFrame = false;
+
+    if (!d.wanted) {
+        DIRECT_LOG("enter at %.0f,%.0f %.0fx%.0f, front %s, %zu waiting\n", target->rect.x(),
+                   target->rect.y(), target->rect.width(), target->rect.height(),
+                   m_frontBuffer ? "yes" : "no", m_ready.size());
+        // Qt shows the first frames; from there the frame on screen is
+        // handed over.
+        if (!m_frontBuffer)
+            return false;
+        d.wanted = true;
+        // Qt's texture of the frame on screen goes with Qt's node.
+        if (m_readyWithTexture) {
+            m_frontBuffer->endPresent();
+            m_readyWithTexture = false;
+        }
+        m_frontBuffer->freeTexture();
+        // The sub-surface shows it at once, so the hole Qt now leaves and
+        // the page appear together.
+        if (!d.mapped) {
+            std::unique_ptr<Buffer> front = std::move(m_frontBuffer);
+            front->beginPresent();
+            directAttach(std::move(front));
+        }
+        directPresentNext();
+    } else if (resized && d.mapped && m_frontBuffer) {
+        // The new size at once; Chromium's frame of that size follows.
+        directAttach(nullptr);
+    }
+    if (d.broken) {
+        // Qt draws the frames again, from this frame on.
+        d.wanted = false;
+        directHide();
+        if (m_frontBuffer && !m_readyWithTexture) {
+            m_frontBuffer->beginPresent();
+            m_readyWithTexture = true;
+        }
+        return false;
+    }
+    return d.mapped;
+}
+
+void NativeSkiaOutputDevice::directFrameEnd()
+{
+    QMutexLocker locker(&m_mutex);
+    if (m_direct && m_direct->hideAfterQtFrame && !m_direct->wanted) {
+        directHide();
+        m_direct->hideAfterQtFrame = false;
+    }
+}
+
+// The next frame in the queue to the compositor, if it can take one.
+void NativeSkiaOutputDevice::directPresentNext()
+{
+    Direct &d = *m_direct;
+    if (!d.wanted || !d.surface || d.framePending || d.fenced || m_ready.empty())
+        return;
+    std::unique_ptr<Buffer> buffer = std::move(m_ready.front());
+    m_ready.pop_front();
+    buffer->beginPresent();
+    d.damage.Union(buffer->damage);
+    const int fence = buffer->takeAcquireFenceFd();
+    pollfd done = { fence, POLLIN, 0 };
+    if (fence >= 0 && poll(&done, 1, 0) != 1) {
+        d.fenced = std::move(buffer);
+        d.wl->watchFence(fence, m_deviceId, d.fenced->serial);
+    } else {
+        if (fence >= 0)
+            close(fence);
+        directAttach(std::move(buffer));
+    }
+    directFinishDeferredSwap();
+}
+
+void NativeSkiaOutputDevice::directFinishDeferredSwap()
+{
+    if (m_swapDeferred && m_ready.size() < kQueueDepth) {
+        m_swapDeferred = false;
+        m_gpuTaskRunner->PostTask(FROM_HERE,
+                                  base::BindOnce(&NativeSkiaOutputDevice::finishDeferredSwap,
+                                                 base::Unretained(this)));
+    }
+}
+
+// Shows `buffer` (or, if null, the frame on screen at a new size).
+void NativeSkiaOutputDevice::directAttach(std::unique_ptr<Buffer> buffer)
+{
+    Direct &d = *m_direct;
+    WaylandDirect &w = *d.wl;
+    Buffer *shown = buffer ? buffer.get() : m_frontBuffer.get();
+    if (!shown || !d.surface)
+        return;
+    if (buffer && !buffer->wlBuffer) {
+        scoped_refptr<gfx::NativePixmap> pixmap = buffer->nativePixmap();
+        // The format with its alpha channel even for an opaque page:
+        // Hyprland 0.56 draws an alpha-less (XBGR) sub-surface below its
+        // parent as white. The opaque region says it is opaque.
+        const uint32_t format = pixmap ? ui::GetFourCCFormatFromBufferFormat(pixmap->GetBufferFormat()) : 0;
+        const uint64_t modifier = pixmap ? pixmap->GetBufferFormatModifier() : 0;
+        if (!pixmap || pixmap->GetNumberOfPlanes() != 1 || !w.supports(format, modifier)) {
+            fprintf(stderr, "webengine: the compositor cannot show these buffers (format %08x, modifier %llx)\n",
+                     format, (unsigned long long)modifier);
+            d.broken = true;
+            buffer->endPresent();
+            if (!m_frontBuffer)
+                m_frontBuffer = std::move(buffer);
+            else
+                m_ready.push_front(std::move(buffer));
+            return;
+        }
+        wl_proxy *params = w.call(w.dmabuf(), kDmabufCreateParams, &g_paramsInterface, nullptr);
+        w.call(params, kParamsAdd, nullptr, pixmap->GetDmaBufFd(0), 0u,
+               uint32_t(pixmap->GetDmaBufOffset(0)), uint32_t(pixmap->GetDmaBufPitch(0)),
+               uint32_t(modifier >> 32), uint32_t(modifier & 0xffffffff));
+        const gfx::Size size = pixmap->GetBufferSize();
+        buffer->wlBuffer = w.call(params, kParamsCreateImmed, w.bufferInterface(), nullptr,
+                                  size.width(), size.height(), format, 0u);
+        w.destroyNow(params, kParamsDestroy);
+        auto *tag = new DirectTag{ m_deviceId, buffer->serial };
+        buffer->wlTag = tag;
+        w.listenForRelease(buffer->wlBuffer, tag);
+    }
+
+    // The part of the buffer Qt would show, at the item's size.
+    const Shape &shape = shown->shape();
+    const QSize pixels(shape.imageInfo.width(), shape.imageInfo.height());
+    const QSize logical(qMax(1, qRound(d.rect.width())), qMax(1, qRound(d.rect.height())));
+    const QSize used = (QSizeF(logical) * shape.devicePixelRatio).toSize().boundedTo(pixels);
+    const QRect source(QPoint(0, 0), used.expandedTo(QSize(1, 1)));
+    if (source != d.source) {
+        w.call(d.viewport, kViewportSetSource, nullptr, wl_fixed_from_int(0), wl_fixed_from_int(0),
+               wl_fixed_from_int(source.width()), wl_fixed_from_int(source.height()));
+        d.source = source;
+    }
+    if (logical != d.destination) {
+        w.call(d.viewport, kViewportSetDestination, nullptr, logical.width(), logical.height());
+        d.destination = logical;
+    }
+
+    if (buffer) {
+        w.call(d.surface, kSurfaceAttach, nullptr, buffer->wlBuffer, 0, 0);
+        gfx::Rect damage = d.mapped ? d.damage : gfx::Rect(pixels.width(), pixels.height());
+        damage.Intersect(gfx::Rect(pixels.width(), pixels.height()));
+        DIRECT_LOG("attach %llu damage %s source %dx%d dest %dx%d\n",
+                   (unsigned long long)buffer->serial, damage.ToString().c_str(), source.width(),
+                   source.height(), logical.width(), logical.height());
+        if (!damage.IsEmpty())
+            w.call(d.surface, kSurfaceDamageBuffer, nullptr, damage.x(), damage.y(),
+                   damage.width(), damage.height());
+        d.damage = gfx::Rect();
+        w.requestFrame(d.surface, m_deviceId);
+        d.framePending = true;
+        buffer->onWayland = true;
+        // The frame shown before stays the compositor's until it lets go.
+        if (m_frontBuffer) {
+            if (m_frontBuffer->onWayland)
+                d.held.push_back(std::move(m_frontBuffer));
+            else
+                m_spareBuffers.push_back(std::move(m_frontBuffer));
+        }
+        m_frontBuffer = std::move(buffer);
+        m_readyWithTexture = false;
+    } else {
+        w.call(d.surface, kSurfaceDamageBuffer, nullptr, 0, 0, pixels.width(), pixels.height());
+    }
+    w.call(d.surface, kSurfaceCommit, nullptr);
+    w.flush();
+    d.mapped = true;
+}
+
+void NativeSkiaOutputDevice::directHide()
+{
+    Direct &d = *m_direct;
+    if (!d.mapped || !d.surface)
+        return;
+    WaylandDirect &w = *d.wl;
+    w.call(d.surface, kSurfaceAttach, nullptr, nullptr, 0, 0);
+    w.call(d.surface, kSurfaceCommit, nullptr);
+    w.flush();
+    DIRECT_LOG("hide\n");
+    d.mapped = false;
+    // An unmapped surface gets no frame callbacks.
+    d.framePending = false;
+}
+
+void NativeSkiaOutputDevice::directTeardown()
+{
+    Direct &d = *m_direct;
+    if (d.fenced) {
+        d.fenced->endPresent();
+        m_ready.push_front(std::move(d.fenced));
+    }
+    directHide();
+    if (d.surface) {
+        WaylandDirect &w = *d.wl;
+        w.destroyLater(d.viewport, kViewportDestroy);
+        w.destroyLater(d.subsurface, kSubsurfaceDestroy);
+        w.destroyLater(d.surface, kSurfaceDestroy);
+    }
