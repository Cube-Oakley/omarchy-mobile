+// Damage (Omarchy Mobile patch) ----------------------------------------------
+
+template<typename F>
+void NativeSkiaOutputDevice::forEachBuffer(F f)
+{
+    for (auto &buffer : m_ready)
+        f(buffer.get());
+    for (auto &buffer : m_spareBuffers)
+        f(buffer.get());
+    if (m_frontBuffer)
+        f(m_frontBuffer.get());
+    if (m_backBuffer)
+        f(m_backBuffer.get());
+#if BUILDFLAG(IS_OZONE)
+    if (m_direct) {
+        for (auto &buffer : m_direct->held)
+            f(buffer.get());
+        if (m_direct->fenced)
+            f(m_direct->fenced.get());
+    }
+#endif
+}
+
+// Chromium redraws only what changed since the buffer it draws into next
+// was drawn (it reports this with each swap).
+gfx::Rect NativeSkiaOutputDevice::nextBufferDamage()
+{
+    const gfx::Rect full(m_shape.imageInfo.width(), m_shape.imageInfo.height());
+    if (!m_backBuffer)
+        m_backBuffer = takeSpare();
+    if (!m_backBuffer || m_backBuffer->shape() != m_shape)
+        return full;
+    gfx::Rect stale = m_backBuffer->stale;
+    stale.Intersect(full);
+    return stale;
+}
