+// A buffer for Chromium's next frame, from those Qt let go of; others are
+// destroyed here, on the GPU thread (called with m_mutex held).
+std::unique_ptr<NativeSkiaOutputDevice::Buffer> NativeSkiaOutputDevice::takeSpare()
+{
+    std::unique_ptr<Buffer> spare;
+    while (!m_spareBuffers.empty()) {
+        std::unique_ptr<Buffer> buffer = std::move(m_spareBuffers.back());
+        m_spareBuffers.pop_back();
+        if (!spare && buffer->shape() == m_shape)
+            spare = std::move(buffer);
+    }
+    return spare;
+}
+
+void NativeSkiaOutputDevice::finishDeferredSwap()
+{
+    FinishSwapBuffers(gfx::SwapCompletionResult(gfx::SwapResult::SWAP_ACK),
+                      gfx::Size(m_shape.imageInfo.width(), m_shape.imageInfo.height()),
+                      std::move(m_frame));
+}
+
+// Qt's render thread takes a frame just after the compositor's frame
+// callback, or later when its GUI thread is busy, never earlier: earlier
+// samples are followed at once (half way), later ones slowly (the panel's
+// own drift).
+void NativeSkiaOutputDevice::noteQtFrame()
+{
+    const int64_t step = displayInterval().InMicroseconds();
+    if (step <= 0)
+        return;
+    const int64_t now = nowUs();
+    const int64_t phase = m_qtPhaseUs.load(std::memory_order_relaxed);
+    if (!phase) {
+        m_qtPhaseUs.store(now, std::memory_order_relaxed);
+        return;
+    }
+    int64_t error = ((now - phase) % step + step) % step;
+    if (error > step / 2)
+        error -= step;
+    const int64_t correction = error < 0 ? error / 2 : error / 32;
+    m_qtPhaseUs.store(now - error + correction, std::memory_order_relaxed);
+}
+
+// Qt's next frame, moved by QTWEBENGINE_FRAME_PHASE_US; null until Qt has
+// taken one.
+base::TimeTicks NativeSkiaOutputDevice::nextQtFrame() const
+{
+    const int64_t step = displayInterval().InMicroseconds();
+    const int64_t phase = m_qtPhaseUs.load(std::memory_order_relaxed);
+    if (step <= 0 || !phase)
+        return base::TimeTicks();
+    const int64_t now = nowUs();
+    const int64_t ahead = ((phase - now) % step + step) % step;
+    return base::TimeTicks() + base::Microseconds(now + ahead + framePhaseOffsetUs());
+}
